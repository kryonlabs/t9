#import "terminal_pane_profile_colors"
#import "terminal_pane_profile_types"
Sheet :: #import "kryon/style_sheet";
Controls :: #import "kryon/control_props";

TestTheme :: () -> bool {
    rules: Sheet.StyleRules
    rules.count = 3
    for at: cast(s32)0..cast(s32)2 {
        rules.items[at].selector = Sheet.StyleDefaultSelector()
    }
    rules.items[0].selector.kind = Sheet.StyleKindApp()
    rules.items[0].style.fields = cast(u32)Controls.StyleField.StyleBackground
    rules.items[0].style.background = cast(u32)0x010203ff
    rules.items[1].selector.kind = Sheet.StyleKindText()
    rules.items[1].style.fields = cast(u32)Controls.StyleField.StyleForeground
    rules.items[1].style.foreground = cast(u32)0x040506ff
    rules.items[2].selector.kind = Sheet.StyleKindLink()
    rules.items[2].style.fields = cast(u32)Controls.StyleField.StyleForeground
    rules.items[2].style.foreground = cast(u32)0x070809ff
    if !Sheet.InstallStyleRules(rules) { return false }
    colors := GetTerminalPaneThemeColors()
    if !SameColor(colors.background, 1, 2, 3) || !SameColor(colors.text, 4, 5, 6) ||
        !SameColor(colors.link, 7, 8, 9) || colors.selection.a != 71 { return false }
    configured: TerminalPaneColors
    configured.cursor = Color.{90, 91, 92, 255}
    configured = ResolveTerminalPaneThemeColors(configured)
    if !SameColor(configured.cursor, 90, 91, 92) ||
        !SameColor(configured.background, 1, 2, 3) { return false }
    empty: Sheet.StyleRules
    return Sheet.InstallStyleRules(empty)
}

SameColor :: (value: Color, red: u8, green: u8, blue: u8) -> bool {
    return value.r == red && value.g == green && value.b == blue &&
        value.a == 255
}

#program_export
main :: () -> s32 {
    if !TestTheme() { return 21 }
    palette: TerminalPanePalette
    palette.ansi[1] = Color.{205, 49, 49, 255}
    fallback: Color = Color.{1, 2, 3, 255}
    theme: TerminalPaneColors

    theme.text = Color.{4, 5, 6, 255}
    theme.background = Color.{7, 8, 9, 255}
    theme.cursor = Color.{10, 11, 12, 255}
    theme.selection = Color.{13, 14, 15, 255}
    theme.selection_text = Color.{16, 17, 18, 255}

    if TerminalPaneColorToRGB(Color.{17, 34, 51, 255}) !=
       (TERMINAL_PANE_COLOR_TRUE_RGB | 0x112233) { return 1 }
    if TerminalPaneColorToRGB(Color.{0, 0, 0, 0}) !=
       TERMINAL_PANE_COLOR_DEFAULT { return 2 }

    true_color: Color = ResolveTerminalPaneColor(
        *palette, TERMINAL_PANE_COLOR_TRUE_RGB | 0x0a141e, fallback)
    if !SameColor(true_color, 10, 20, 30) { return 3 }
    palette_color: Color = ResolveTerminalPaneColor(*palette, 1, fallback)
    if !SameColor(palette_color, 205, 49, 49) { return 4 }
    default_color: Color = ResolveTerminalPaneColor(
        null, 1, fallback)
    if !SameColor(default_color, 205, 49, 49) { return 5 }
    default_cube: Color = ResolveTerminalPaneColor(null, 16, fallback)
    if !SameColor(default_cube, 0, 0, 0) { return 6 }
    default_gray: Color = ResolveTerminalPaneColor(null, 232, fallback)
    if !SameColor(default_gray, 8, 8, 8) { return 7 }
    fallback_color: Color = ResolveTerminalPaneColor(
        *palette, TERMINAL_PANE_COLOR_DEFAULT, fallback)
    if !SameColor(fallback_color, 1, 2, 3) { return 8 }

    overrides: [256]s32
    index: s32 = 0
    while index < 256 {
        overrides[index] = TERMINAL_PANE_COLOR_DEFAULT
        index += 1
    }
    overrides[1] = TERMINAL_PANE_COLOR_TRUE_RGB | 0x223344
    overrides[2] = TERMINAL_PANE_COLOR_TRUE_RGB | 0x778899
    overridden: Color = ResolveTerminalPaneColorWithOverrides(
        *palette, *overrides[0], 1, fallback)
    if !SameColor(overridden, 34, 51, 68) { return 9 }

    view_configured: TerminalPaneProfileColors
    view_configured.foreground = 1
    view_configured.background = TERMINAL_PANE_COLOR_TRUE_RGB | 0x445566
    view_configured.cursor = TERMINAL_PANE_COLOR_DEFAULT
    view_configured.selection_foreground = TERMINAL_PANE_COLOR_DEFAULT
    view_configured.selection_background = 2
    view: TerminalPaneViewColors = ResolveTerminalPaneViewColors(
        *palette, *overrides[0], view_configured, theme)
    if !SameColor(view.foreground, 34, 51, 68) { return 10 }
    if !SameColor(view.background, 68, 85, 102) { return 11 }
    if !SameColor(view.cursor, 34, 51, 68) { return 12 }
    if !SameColor(view.selection_foreground, 68, 85, 102) { return 13 }
    if !SameColor(view.selection_background, 119, 136, 153) { return 14 }

    configured: TerminalPaneProfileColors
    configured.foreground = TERMINAL_PANE_COLOR_DEFAULT
    configured.background = TERMINAL_PANE_COLOR_TRUE_RGB | 0x445566
    configured.cursor = TERMINAL_PANE_COLOR_DEFAULT
    configured.selection_foreground =
        TERMINAL_PANE_COLOR_TRUE_RGB | 0xaabbcc
    configured.selection_background = TERMINAL_PANE_COLOR_DEFAULT

    resolved: TerminalPaneProfileColors =
        ResolveTerminalPaneProfileColors(configured, theme)
    if resolved.foreground != (TERMINAL_PANE_COLOR_TRUE_RGB | 0x040506) {
        return 15
    }
    if resolved.background != (TERMINAL_PANE_COLOR_TRUE_RGB | 0x445566) {
        return 16
    }
    if resolved.cursor != (TERMINAL_PANE_COLOR_TRUE_RGB | 0x0a0b0c) {
        return 17
    }
    if resolved.selection_foreground !=
       (TERMINAL_PANE_COLOR_TRUE_RGB | 0xaabbcc) { return 18 }
    if resolved.selection_background !=
       (TERMINAL_PANE_COLOR_TRUE_RGB | 0x0d0e0f) { return 19 }

    from_theme: TerminalPaneProfileColors =
        TerminalPaneProfileColorsFromTheme(theme)
    if from_theme.foreground != (TERMINAL_PANE_COLOR_TRUE_RGB | 0x040506) ||
       from_theme.background != (TERMINAL_PANE_COLOR_TRUE_RGB | 0x070809) {
        return 20
    }
    return 0
}
