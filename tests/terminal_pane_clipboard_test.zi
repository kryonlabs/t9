#import "terminal_clipboard"
Host :: #import "terminal_clipboard_host";
#import "terminal_pane_selection"
#import "terminal_pane_clipboard"

ClipboardFixture :: struct {
    lines: [3][64]u8
    wrapped: [3]s32
}

callback_paste_value: [256]u8;
callback_used: s32;

ResetPaste :: () { callback_used = 0; callback_paste_value[0] = 0 }

Fill :: (output: *u8, value: string) {
    index: s32 = 0
    while index < cast(s32)value.count {
        output[index] = value[index]
        index += 1
    }
    output[index] = 0
}

Same :: (value: *u8, expected: string) -> bool {
    index: s32 = 0
    while index < cast(s32)expected.count {
        if value[index] != expected[index] { return false }
        index += 1
    }
    return value[index] == 0
}

FixtureLineText :: (userdata: *void, row: s32, out: *u8,
    out_size: s32) -> s32 {
    fixture: *ClipboardFixture
    index: s32 = 0
    if userdata == null || out == null || out_size <= 0 ||
       row < 0 || row >= 3 { return 0 }
    fixture = cast(*ClipboardFixture)userdata
    while fixture.lines[row][index] != 0 && index < out_size - 1 {
        out[index] = fixture.lines[row][index]
        index += 1
    }
    out[index] = 0
    return 1
}

FixtureWrapped :: (userdata: *void, row: s32) -> s32 {
    fixture: *ClipboardFixture
    if userdata == null || row < 0 || row >= 3 { return 0 }
    fixture = cast(*ClipboardFixture)userdata
    return fixture.wrapped[row]
}

WriteInput :: (userdata: *void, text: *u8, size: s32) -> s32 {
    if userdata == null || text == null || size <= 0 || callback_used + size >= 256 { return 0 }
    for index: 0..size - 1 { callback_paste_value[callback_used] = text[index]; callback_used += 1 }
    callback_paste_value[callback_used] = 0
    return size
}

#program_export
main :: () -> s32 {
    fixture: ClipboardFixture
    storage: ClipboardBuffer
    selection: TerminalPaneSelection
    text: [64]u8
    clipboard: TerminalPaneClipboard
    selection_controller: TerminalPaneClipboardController
    session_controller: TerminalPaneClipboardController
    actions: TerminalPaneClipboardActions
    command_result: TerminalPaneClipboardCommandResult
    selection_scroll: s32 = 7
    session_scroll: s32 = 9

    Fill(*fixture.lines[0][0], "alpha beta")
    Fill(*fixture.lines[1][0], "gamma delta")
    Fill(*fixture.lines[2][0], "epsilon")
    fixture.wrapped[0] = 1

    InitClipboardBuffer(*storage, null)
    Host.HostClipboardReset("clipboard text")
    primary: [32]u8
    Fill(*primary[0], "primary text")
    SetPrimarySelectionFromText(*primary[0])
    clipboard = MakeTerminalPaneClipboard(
        *storage, 2, WriteInput, cast(*void)(*storage))
    if clipboard.bracketed_paste != 1 { return 1 }

    selection_controller = MakeTerminalPaneClipboardController(clipboard,
        *selection, FixtureLineText, FixtureWrapped, cast(*void)*fixture,
        3, 11, *selection_scroll)
    session_controller = TerminalPaneClipboardController.{}
    session_controller.clipboard = clipboard
    session_controller.scroll_offset = *session_scroll
    actions = MakeTerminalPaneClipboardActions(selection_controller,
        session_controller)

    ResetPaste()
    Fill(*text[0], "typed paste")
    if TerminalPaneClipboardPasteText(clipboard, *text[0]) != 1 ||
       !Same(*callback_paste_value[0], "\x1b[200~typed paste\x1b[201~") { return 2 }

    ResetPaste()
    if TerminalPaneClipboardPastePrimary(clipboard) != 1 ||
       !Same(*callback_paste_value[0], "\x1b[200~primary text\x1b[201~") { return 3 }
    ResetPaste()
    if TerminalPaneClipboardPasteClipboard(clipboard) != 1 ||
       !Same(*callback_paste_value[0], "\x1b[200~clipboard text\x1b[201~") { return 4 }
    ResetPaste()
    if TerminalPaneClipboardPastePreferred(clipboard) != 1 ||
       !Same(*callback_paste_value[0], "\x1b[200~primary text\x1b[201~") { return 5 }
    if TerminalPaneClipboardSourceHasText(CLIPBOARD_SOURCE_PRIMARY) != 1 ||
       TerminalPaneClipboardSourceHasText(CLIPBOARD_SOURCE_CLIPBOARD) != 1 ||
       TerminalPaneClipboardPrimarySelectionAvailable() != 1 { return 6 }

    if TerminalPaneClipboardSyncFromHost(clipboard) != 1 || !Same(GetClipboardBufferText(*storage), "clipboard text") { return 7 }
    RequestClipboardBufferWrite(*storage, *text[0])
    if TerminalPaneClipboardFlushToHost(clipboard) != 1 || Host.HostClipboardText() != "typed paste" { return 8 }

    TerminalPaneSelectionSetRange(*selection,
        TERMINAL_PANE_SELECTION_CHAR, 1, 0, 6, 1, 11)
    if TerminalPaneClipboardCollectSelectionText(actions, *text[0], 64) != 1 { return 90 }
    if !Same(*text[0], "betagamma delta") { return 91 }
    if TerminalPaneClipboardUpdatePrimary(actions) != 1 ||
       !Same(GetPrimarySelectionTextValue(), "betagamma delta") { return 10 }
    if TerminalPaneClipboardCopy(actions) != 1 ||
       !Same(GetClipboardBufferText(*storage), "betagamma delta") { return 11 }

    TerminalPaneSelectionClear(*selection)
    if TerminalPaneClipboardSelectAll(actions) != 1 ||
       selection.active != 1 || selection.start_row != 0 ||
       selection.start_col != 0 || selection.end_row != 2 ||
       selection.end_col != 11 { return 12 }

    ResetPaste()
    Fill(*text[0], "action paste")
    command_result = TerminalPaneClipboardRunActionsCommand(actions,
        TERMINAL_PANE_CLIPBOARD_COMMAND_PASTE_TEXT, *text[0])
    if command_result.performed != 1 || command_result.wrote_input != 1 ||
       session_scroll != 0 || selection_scroll != 7 ||
       !Same(*callback_paste_value[0], "\x1b[200~action paste\x1b[201~") { return 13 }

    command_result = TerminalPaneClipboardRunActionsCommand(actions,
        TERMINAL_PANE_CLIPBOARD_COMMAND_SYNC_FROM_HOST, null)
    if command_result.performed != 1 || command_result.wrote_input != 0 ||
       Host.HostClipboardText() != "betagamma delta" { return 14 }
    RequestClipboardBufferWrite(*storage, *text[0])
    command_result = TerminalPaneClipboardRunActionsCommand(actions,
        TERMINAL_PANE_CLIPBOARD_COMMAND_FLUSH_TO_HOST, null)
    if command_result.performed != 1 || command_result.wrote_input != 0 ||
       Host.HostClipboardText() != "action paste" { return 15 }

    ResetPaste()
    command_result = TerminalPaneClipboardRunSimpleCommand(clipboard,
        *session_scroll, TERMINAL_PANE_CLIPBOARD_COMMAND_PASTE_PRIMARY, null)
    if command_result.performed != 1 || command_result.wrote_input != 1 ||
       session_scroll != 0 ||
       !Same(*callback_paste_value[0], "\x1b[200~betagamma delta\x1b[201~") { return 16 }

    return 0
}
