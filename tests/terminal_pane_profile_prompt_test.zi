TERMINAL_PANE_COLOR_TRUE_RGB :: 0x01000000;

#import "terminal_pane_profile_prompt"

Fill :: (output: *u8, value: string) {
    index: s32 = 0
    while index < cast(s32)value.count {
        output[index] = value[index]
        index += 1
    }
    output[index] = 0
}

Same :: (value: *u8, expected: string) -> bool {
    index: s32 = 0
    while index < cast(s32)expected.count {
        if value[index] != expected[index] { return false }
        index += 1
    }
    return value[index] == 0
}

CheckFormat :: (settings: *TerminalPaneProfileSettings, prompt: s32,
    expected: string) -> bool {
    output: [128]u8
    value_bytes: [4]u8

    length: s32 = FormatTerminalPaneProfilePromptValue(*output[0], 128,
        settings, prompt)
    if length != cast(s32)expected.count { return false }
    return Same(*output[0], expected)
}

#program_export
FormatTerminalPaneProfileColor :: (output: *u8, output_size: s32,
    color: s32) -> s32 {
    if output == null || output_size < 8 { return 0 }
    output[0] = 35
    output[1] = 49
    output[2] = 49
    output[3] = 49
    output[4] = 49
    output[5] = 49
    output[6] = 49
    output[7] = 0
    return 7
}

#program_export
ApplyTerminalPaneProfileSetting :: (settings: *TerminalPaneProfileSettings,
    limits: TerminalPaneProfileLimits, name: *u8, value: *u8) -> s32 {
    if settings == null || name == null || value == null || limits.min_font_size > 24 || limits.max_font_size < 24 { return 0 }
    if Same(name, "font-size") && Same(value, "24") {
        settings.font_size = 24
        return 1
    }
    return 0
}

#program_export
main :: () -> s32 {
    settings: TerminalPaneProfileSettings
    limits: TerminalPaneProfileLimits
    limits.min_font_size = 10
    limits.max_font_size = 48
    output: [128]u8
    value_bytes: [4]u8

    Fill(*settings.shell[0], "/bin/sh")
    settings.font_size = -42
    settings.scrollback_limit = 5000
    settings.terminal_cursor = TERMINAL_PANE_COLOR_DEFAULT
    settings.terminal_foreground = TERMINAL_PANE_COLOR_TRUE_RGB | 0x010101
    settings.dynamic_title_mode = TERMINAL_PANE_TITLE_APPEND
    settings.backspace_binding = TERMINAL_PANE_KEY_BINDING_CONTROL_H
    settings.delete_binding = TERMINAL_PANE_KEY_BINDING_ESCAPE_SEQUENCE
    settings.ambiguous_width_wide = 1
    settings.allow_bold = 1
    settings.disable_help_shortcut = 0
    settings.background_opacity = 87
    Fill(*settings.background_image[0], "/tmp/background.png")

    if !Same(TerminalPaneProfilePromptTitle(
            TERMINAL_PANE_PROFILE_PROMPT_SHELL), "Shell") ||
       !Same(TerminalPaneProfilePromptSettingName(
            TERMINAL_PANE_PROFILE_PROMPT_FOREGROUND),
            "terminal-foreground") ||
       TerminalPaneProfilePromptTitle(
            TERMINAL_PANE_PROFILE_PROMPT_NONE) == null ||
       !Same(TerminalPaneProfilePromptTitle(
            TERMINAL_PANE_PROFILE_PROMPT_NONE), "Profile") ||
       TerminalPaneProfilePromptSettingName(
            TERMINAL_PANE_PROFILE_PROMPT_NONE) != null { return 1 }

    if TerminalPaneProfilePromptAffectsColors(
            TERMINAL_PANE_PROFILE_PROMPT_CURSOR_COLOR) != 1 ||
       TerminalPaneProfilePromptAffectsColors(
            TERMINAL_PANE_PROFILE_PROMPT_SHELL) != 0 ||
       TerminalPaneProfilePromptAffectsFont(
            TERMINAL_PANE_PROFILE_PROMPT_TERMINAL_FONT) != 1 ||
       TerminalPaneProfilePromptAffectsScrollback(
            TERMINAL_PANE_PROFILE_PROMPT_UNLIMITED_SCROLLBACK) != 1 {
        return 2
    }

    if !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_SHELL, "/bin/sh") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_FONT_SIZE, "-42") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_SCROLLBACK, "5000") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_CURSOR_COLOR, "default") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_FOREGROUND, "#111111") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_DYNAMIC_TITLE_MODE, "append") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_BACKSPACE_BINDING, "control-h") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_DELETE_BINDING, "escape-sequence") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_AMBIGUOUS_WIDTH, "wide") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_ALLOW_BOLD, "true") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_DISABLE_HELP_SHORTCUT, "false") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_OPACITY, "87") ||
       !CheckFormat(*settings, TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_IMAGE, "/tmp/background.png") {
        return 3
    }

    if FormatTerminalPaneProfilePromptValue(null, 128, *settings,
            TERMINAL_PANE_PROFILE_PROMPT_SHELL) != 0 ||
       FormatTerminalPaneProfilePromptValue(*output[0], 0, *settings,
            TERMINAL_PANE_PROFILE_PROMPT_SHELL) != 0 ||
       FormatTerminalPaneProfilePromptValue(*output[0], 128, null,
            TERMINAL_PANE_PROFILE_PROMPT_SHELL) != 0 {
        return 4
    }

    Fill(*output[0], "sentinel")
    if FormatTerminalPaneProfilePromptValue(*output[0], 3, *settings,
            TERMINAL_PANE_PROFILE_PROMPT_FONT_SIZE) != 0 ||
       !Same(*output[0], "") { return 5 }

    Fill(*value_bytes[0], "24")
    if ApplyTerminalPaneProfilePromptValue(*settings, limits,
            TERMINAL_PANE_PROFILE_PROMPT_FONT_SIZE,
            *value_bytes[0]) != 1 || settings.font_size != 24 { return 6 }
    Fill(*value_bytes[0], "24")
    if ApplyTerminalPaneProfilePromptValue(*settings, limits,
            TERMINAL_PANE_PROFILE_PROMPT_NONE,
            *value_bytes[0]) != 0 { return 7 }
    return 0
}
