State :: #import "app_state";
Sessions :: #import "app_sessions";
Session :: #import "app_session";
Chrome :: #import "app_chrome";
Palette :: #import "app_palette";
Profile :: #import "app_profile";
Selection :: #import "app_selection";
Clipboard :: #import "app_clipboard";
Engine :: #import "terminal";
Config :: #import "app_config";
Types :: #import "terminal_pane_profile_types";
PaneColors :: #import "terminal_pane_profile_colors";
Sheet :: #import "kryon/style_sheet";
Controls :: #import "kryon/control_props";
using Drawing :: #import "kryon/drawing_props";
Text :: #import "std/byte_text_linux";
Host :: #import "terminal_clipboard_host";
PaintHost :: #import "terminal_pane_widget_host";
Commands :: #import "app_commands";
Search :: #import "app_search";
Dialog :: #import "app_dialog";
Keys :: #import "terminal_pane_keys";
UISessions :: #import "kryon/session";
Frame :: #import "kryon/Frame";
Input :: #import "kryon/tree_input";
using Geometry :: #import "kryon/geometry";
Fields :: #import "kryon/text_input_props";
Context :: #import "app_context_menu";
Menu :: #import "app_menu";
Widgets :: #import "kryon/Widgets";
Tree :: #import "kryon/tree";
#if #defined(PLAN9) {
    File :: #import "std/file_plan9";
} else {
    File :: #import "std/file_linux";
}

#scope_file
libc :: #system_library "c";
#if #defined(PLAN9) {
    Pause :: (milliseconds: s32) -> s32 #foreign libc "sleep";
} else {
    Environment :: (name: *s8) -> *s8 #foreign libc "getenv";
    PauseHost :: (microseconds: u32) -> s32 #foreign libc "usleep";
    Pause :: (milliseconds: s32) { PauseHost(cast(u32)(milliseconds * 1000)) }
}
Bytes :: (value: string) -> *u8 {
    descriptor := cast(*Text.TextDescriptor)(*value)
    return descriptor.data
}
Value :: (bytes: []u8) -> string { return Text.TextFromCString(*bytes[0]) }
Shell :: () -> string {
    #if #defined(PLAN9) {
        return "/bin/rc"
    } else {
        return Text.TextFromCString(cast(*u8)Environment(cast(*s8)Bytes("T9_TEST_SHELL")))
    }
}
Application :: () -> *State.State {
    app := State.Allocate()
    if app != null {
        Session.CopyText(app.config.shell[:], Shell())
        Session.CopyText(app.config.working_directory[:], "/")
        app.launch.geometry_cols = 80; app.launch.geometry_rows = 4
    }
    return app
}
SameColor :: (first: Color, second: Color) -> bool {
    return first.r == second.r && first.g == second.g && first.b == second.b && first.a == second.a
}
Failure :: (message: string) -> bool { print("%\n", message); return false }
Rule :: (rules: *Sheet.StyleRules, kind: s32, background: u32, foreground: u32) {
    rule := *rules.items[rules.count]
    rule.selector = Sheet.StyleDefaultSelector(); rule.selector.kind = kind
    rule.style.fields = cast(u32)Controls.StyleField.StyleBackground | cast(u32)Controls.StyleField.StyleForeground
    rule.style.background = background; rule.style.foreground = foreground
    rules.count += 1
}
ClearRules :: () {
    rules: Sheet.StyleRules
    Sheet.InstallStyleRules(rules)
}
CheckPalette :: () -> bool {
    rules: Sheet.StyleRules
    Rule(*rules, Sheet.StyleKindApp(), 0x0a141eff, 0xd2dce6ff)
    Rule(*rules, Sheet.StyleKindSurface(), 0x28323cff, 0xd2dce6ff)
    Rule(*rules, Sheet.StyleKindText(), 0x28323cff, 0xd2dce6ff)
    Rule(*rules, Sheet.StyleKindLink(), 0x28323cff, 0x1978dcff)
    if !Sheet.InstallStyleRules(rules) { return false }
    defer ClearRules()
    palette: Palette.Palette
    Palette.Defaults(*palette)
    colors := PaneColors.GetTerminalPaneThemeColors()
    if !SameColor(palette.background, Color.{10, 20, 30, 255}) ||
        !SameColor(palette.chrome, Color.{40, 50, 60, 255}) ||
        !SameColor(palette.menu_text, Color.{210, 220, 230, 255}) ||
        !SameColor(palette.link, colors.link) ||
        !SameColor(palette.terminal_background, colors.background) ||
        !SameColor(palette.selection, colors.selection) ||
        !SameColor(palette.selection_text, colors.selection_text) ||
        !SameColor(palette.bell_overlay, colors.bell_overlay) ||
        !SameColor(palette.terminal_palette.ansi[1], Color.{205, 49, 49, 255}) ||
        !SameColor(palette.terminal_palette.ansi[232], Color.{8, 8, 8, 255}) { return false }
    if !SameColor(Palette.Mix(Color.{0, 0, 0, 255}, Color.{100, 100, 100, 255}, 2.0), Color.{100, 100, 100, 255}) {
        return false
    }
    return true
}
CheckStateAndProfile :: () -> bool {
    app := Application()
    if app == null { return false }
    defer State.Dispose(app)
    if app.active != -1 || app.rename_index != -1 || app.session_count != 0 ||
        app.menu.open_index != -1 || app.menu.focused || app.mouse_report_col != -1 || app.mouse_report_row != -1 ||
        app.mouse_report_x != -1 || app.mouse_report_y != -1 || app.mouse_report_button != 3 ||
        app.selection_click_row != -1 || app.selection_click_col != -1 ||
        !app.window_focused || app.scale != 1.0 || Sessions.Active(app) != null { return Failure("Initial application state") }
    for tab: cast(s32)0..cast(s32)7 {
        if app.sessions[tab].terminal.fd != -1 || !app.sessions[tab].initialized || app.sessions[tab].used { return Failure("Initial tab ownership") }
    }
    if Chrome.MenuBarHeight(app) != 34 || Chrome.TabBarVisible(app) { return Failure("Initial chrome") }
    app.session_count = 2
    if !Chrome.TabBarVisible(app) || Chrome.TabBarHeight(app) <= 0 { return Failure("Multiple-tab chrome") }
    app.scale = 2.0
    if Chrome.MenuBarHeight(app) != 68 { return Failure("Scaled chrome") }
    app.launch.show_menubar = false; app.launch.show_toolbar = false
    if Chrome.Height(app) != 0 || Chrome.Height(null) != 0 { return Failure("Hidden chrome") }
    app.active = 0
    if Config.Apply(*app.config, Bytes("terminal-foreground"), Bytes("#101010")) == 0 ||
        Config.Apply(*app.config, Bytes("terminal-background"), Bytes("#202020")) == 0 ||
        Config.Apply(*app.config, Bytes("terminal-cursor"), Bytes("#303030")) == 0 { return Failure("Configured profile colors") }
    for tab: cast(s32)0..cast(s32)1 { Profile.ApplyNew(*app.config, *app.palette, *app.sessions[tab].terminal) }
    terminal := *app.sessions[0].terminal
    terminal.default_fg = Engine.COLOR_TRUE_RGB | 0x010203
    terminal.cursor_color = Engine.COLOR_TRUE_RGB | 0x040506
    terminal.selection_bg = Engine.COLOR_TRUE_RGB | 0x070809
    old := Profile.ColorsFor(*app.config, *app.palette)
    Config.Apply(*app.config, Bytes("terminal-foreground"), Bytes("#aaaaaa"))
    Config.Apply(*app.config, Bytes("terminal-background"), Bytes("#bbbbbb"))
    Config.Apply(*app.config, Bytes("terminal-cursor"), Bytes("#cccccc"))
    Profile.SyncThemeDefaults(app, old)
    if terminal.base_fg != (Engine.COLOR_TRUE_RGB | 0xaaaaaa) ||
        terminal.default_bg != (Engine.COLOR_TRUE_RGB | 0xbbbbbb) ||
        terminal.default_fg != (Engine.COLOR_TRUE_RGB | 0x010203) ||
        terminal.cursor_color != (Engine.COLOR_TRUE_RGB | 0x040506) ||
        terminal.selection_bg != (Engine.COLOR_TRUE_RGB | 0x070809) ||
        app.sessions[1].terminal.default_fg != (Engine.COLOR_TRUE_RGB | 0xaaaaaa) { return Failure("Preserved profile overrides") }
    Profile.OpenPrompt(app, Types.TERMINAL_PANE_PROFILE_PROMPT_SCROLLBACK)
    Session.CopyText(app.profile_text[:], "3210")
    change := Profile.ApplyPrompt(app, false)
    if !change.applied || change.font || change.colors ||
        app.sessions[0].terminal.scrollback_limit != 3210 ||
        app.sessions[1].terminal.scrollback_limit != 3210 { return Failure("Applied scrollback prompt") }
    Session.CopyText(app.profile_text[:], "invalid")
    if Profile.ApplyPrompt(app, false).applied || app.config.scrollback_limit != 3210 { return Failure("Rejected invalid scrollback prompt") }
    Profile.OpenPrompt(app, Types.TERMINAL_PANE_PROFILE_PROMPT_FONT_SIZE)
    Session.CopyText(app.profile_text[:], "22")
    change = Profile.ApplyPrompt(app, false)
    if !change.applied || change.font || change.colors || app.config.font_size != 22 { return Failure("Applied font size prompt") }
    Profile.OpenPrompt(app, Types.TERMINAL_PANE_PROFILE_PROMPT_TERMINAL_FONT)
    Session.CopyText(app.profile_text[:], "/tmp/font.ttf")
    change = Profile.ApplyPrompt(app, false)
    if !change.applied || !change.font || change.colors || Value(app.config.terminal_font[:]) != "/tmp/font.ttf" {
        return Failure("Applied font file prompt")
    }
    Profile.OpenPrompt(app, Types.TERMINAL_PANE_PROFILE_PROMPT_AMBIGUOUS_WIDTH)
    Session.CopyText(app.profile_text[:], "wide")
    change = Profile.ApplyPrompt(app, false)
    if !change.applied || app.sessions[0].terminal.ambiguous_width_wide != 1 ||
        app.sessions[1].terminal.ambiguous_width_wide != 1 { return Failure("Applied width prompt") }
    Profile.OpenPrompt(app, Types.TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND)
    Session.CopyText(app.profile_text[:], "#123456")
    change = Profile.ApplyPrompt(app, false)
    if !change.applied || !change.colors || app.sessions[0].terminal.default_bg != (Engine.COLOR_TRUE_RGB | 0x123456) ||
        app.sessions[1].terminal.default_bg != (Engine.COLOR_TRUE_RGB | 0x123456) { return Failure("Applied color prompt") }
    app.config.shell[0] = 0
    Session.CopyText(app.sessions[0].shell[:], "/bin/custom")
    Profile.OpenPrompt(app, Types.TERMINAL_PANE_PROFILE_PROMPT_SHELL)
    if Value(app.profile_text[:]) != "/bin/custom" || app.profile_cursor != 11 { return Failure("Shell prompt fallback") }
    return true
}
CheckSelectionAndClipboard :: () -> bool {
    app := Application()
    if app == null { return false }
    defer State.Dispose(app)
    app.session_count = 1; app.active = 0
    session := *app.sessions[0]
    terminal := *session.terminal
    Engine.terminal_resize(terminal, 20, 4)
    sample := "first word\r\nsecond row"
    Engine.terminal_feed(terminal, cast(*void)Bytes(sample), cast(s32)sample.count)
    Selection.SelectWord(*app.selection, terminal, 0, 7)
    output: [256]u8
    collected := Selection.Collect(*app.selection, terminal, output[:])
    if collected == 0 || Value(output[:]) != "word" {
        print("Selected word: bytes %, text %, cursor %/%\n", collected, Value(output[:]), terminal.cursor_col, terminal.cursor_row)
        return false
    }
    Host.HostClipboardReset("old")
    Clipboard.UpdatePrimary(app)
    Clipboard.CopySelection(app)
    Clipboard.FlushToHost(session)
    if Host.HostClipboardText() != "word" || Clipboard.CollectSelection(app, output[:]) == 0 || Value(output[:]) != "word" {
        return Failure("Copied application selection")
    }
    Selection.SelectLine(*app.selection, terminal, 1)
    if Selection.Collect(*app.selection, terminal, output[:]) == 0 || Value(output[:]).count < 10 ||
        Value(output[:])[0:10] != "second row" { return Failure("Selected line") }
    Selection.UpdateEnd(*app.selection, terminal, 0, 0)
    Clipboard.SelectAll(app)
    if app.selection.active == 0 || Clipboard.CollectSelection(app, output[:]) == 0 || Value(output[:]).count <= 10 {
        return Failure("Selected whole terminal")
    }
    Clipboard.CopySelection(null)
    if Clipboard.CollectSelection(null, output[:]) != 0 || output[0] != 0 { return Failure("Missing active selection") }
    session.scroll_offset = 7
    Clipboard.PasteText(session, "transport unavailable")
    if session.scroll_offset != 7 { return Failure("Failed paste changed the scroll position") }
    return true
}
CheckSessions :: () -> bool {
    app := Application()
    if app == null { return false }
    defer State.Dispose(app)
    Session.CopyText(app.launch.initial_title[:], "Initial title")
    if !Sessions.Open(app, "exec cat") || app.session_count != 1 || app.active != 0 ||
        Session.Title(*app.sessions[0]) != "Initial title" { return false }
    if !Sessions.Open(app, "exec cat") || !Sessions.Open(app, "exec cat") { return false }
    Session.SetTitle(*app.sessions[1], "Retained title")
    retained_fd := app.sessions[1].terminal.fd
    app.active = 1; app.rename_index = 1; app.selection.active = 1
    Sessions.Move(app, 1, 2)
    if app.active != 2 || app.rename_index != 2 || app.selection.active != 0 ||
        app.sessions[2].terminal.fd != retained_fd || Session.Title(*app.sessions[2]) != "Retained title" { return false }
    Sessions.Move(app, 2, 0)
    if app.active != 0 || app.rename_index != 0 || app.sessions[0].terminal.fd != retained_fd { return false }
    Sessions.SetActive(app, -1); Sessions.SetActive(app, 3)
    if app.active != 0 { return false }
    Sessions.Close(app, 1)
    if app.session_count != 2 || app.active != 0 || app.sessions[2].used || app.sessions[2].terminal.fd != -1 {
        return false
    }
    active := Sessions.Active(app)
    active.terminal.newline_mode = 1
    active.scroll_offset = 12
    Clipboard.PasteText(active, "tab survives move\n")
    if active.scroll_offset != 0 { return false }
    line: [128]u8
    heard: bool
    for attempt: 0..199 {
        Engine.terminal_poll(*active.terminal)
        for row: cast(s32)0..cast(s32)3 {
            Engine.terminal_line(*active.terminal, row, *line[0], 128)
            if Value(line[:]) == "tab survives move" { heard = true }
        }
        if heard { break }
        Pause(10)
    }
    if !heard || !Sessions.Save(app, "application-fixture/session") { return false }
    defer File.RemoveFile("application-fixture/session")
    restored := Application()
    if restored == null { return false }
    defer State.Dispose(restored)
    if !Sessions.Restore(restored, "application-fixture/session") || restored.session_count != 2 ||
        restored.active != 0 || Session.Title(*restored.sessions[0]) != "Retained title" ||
        !restored.sessions[0].title_override || !restored.sessions[0].used { return false }
    Sessions.CloseExited(app, 1); Sessions.CloseExited(app, 0)
    if app.session_count != 0 || app.active != -1 || !app.quit_requested || Sessions.Active(app) != null { return false }
    app.quit_requested = false
    if !Sessions.Open(app, "exec cat") { return false }
    Sessions.Close(app, 0)
    if app.session_count != 1 || app.active != 0 || app.quit_requested { return false }
    app.session_count = 8
    if Sessions.Open(app, "exec cat") || app.session_count != 8 { return false }
    app.session_count = 1
    return true
}
CheckCommandsAndSearch :: () -> bool {
    app := Application()
    if app == null { return false }
    defer State.Dispose(app)
    if Commands.Execute(null, Commands.Command.Quit, false) ||
        Commands.Execute(app, cast(Commands.Command)9999, false) ||
        Commands.HandleShortcut(app, #char "T", Keys.TERMINAL_PANE_MOD_CTRL | Keys.TERMINAL_PANE_MOD_SHIFT, false) {
        return Failure("Commands without an active tab")
    }
    app.session_count = 2; app.active = 0
    terminal := *app.sessions[0].terminal
    Engine.terminal_resize(terminal, 20, 4)
    sample := "first needle\r\nsecond needle"
    Engine.terminal_feed(terminal, cast(*void)Bytes(sample), cast(s32)sample.count)
    app.visible_rows = 4
    limits := Config.Limits()
    Commands.SetFontSize(app, 100000, false)
    if app.config.font_size != limits.max_font_size { return Failure("Command font maximum") }
    Commands.Execute(app, Commands.Command.FontIncrease, false)
    if app.config.font_size != limits.max_font_size { return Failure("Command font increase limit") }
    Commands.SetFontSize(app, -100, false)
    Commands.Execute(app, Commands.Command.FontDecrease, false)
    if app.config.font_size != limits.min_font_size { return Failure("Command font minimum") }
    Commands.Execute(app, Commands.Command.FontReset, false)
    if app.config.font_size != limits.default_font_size { return Failure("Command font reset") }
    if !Commands.HandleShortcut(app, 258, Keys.TERMINAL_PANE_MOD_CTRL, false) || app.active != 1 ||
        !Commands.HandleShortcut(app, 258, Keys.TERMINAL_PANE_MOD_CTRL | Keys.TERMINAL_PANE_MOD_SHIFT, false) || app.active != 0 ||
        !Commands.HandleShortcut(app, #char "2", Keys.TERMINAL_PANE_MOD_ALT, false) || app.active != 1 ||
        !Commands.HandleShortcut(app, 321, Keys.TERMINAL_PANE_MOD_ALT, false) || app.active != 0 ||
        Commands.HandleShortcut(app, #char "C", 0, false) { return Failure("Tab and ordinary-key shortcuts") }
    for kind: cast(s32)1..cast(s32)24 {
        if !Commands.Execute(app, cast(Commands.Command)(1014 + kind), false) ||
            app.profile_prompt != kind || app.profile_anchor != app.profile_cursor {
            return Failure("Profile command routing")
        }
    }
    app.profile_prompt = 0
    Commands.Execute(app, Commands.Command.CursorUnderline, false)
    if app.config.cursor_style != Engine.TERMINAL_CURSOR_UNDERLINE { return Failure("Cursor command") }
    Commands.Execute(app, Commands.Command.About, false)
    if !app.about_visible { return Failure("About command") }
    Session.CopyText(app.search_text[:], "needle")
    if !Search.Find(app) || app.selection.start_row != 1 || app.selection.start_col != 7 ||
        !Search.FindDirection(app, 1) || app.selection.start_row != 0 || app.selection.start_col != 6 ||
        !Search.FindDirection(app, -1) || app.selection.start_row != 1 { return Failure("Search direction and wrap") }
    if !Commands.HandleShortcut(app, #char "F", Keys.TERMINAL_PANE_MOD_CTRL | Keys.TERMINAL_PANE_MOD_SHIFT, false) ||
        !app.search_visible || !app.search_focused || app.search_cursor != 6 || app.search_anchor != 6 {
        return Failure("Search shortcut focus")
    }
    Session.CopyText(app.search_text[:], "absent")
    if Search.Find(app) || Search.FindDirection(app, 1) || Search.Find(null) { return Failure("Missing search match") }
    if !Commands.Execute(app, Commands.Command.NewTab, false) || app.session_count != 3 || app.active != 2 ||
        !app.sessions[2].used { return Failure("New-tab command") }
    Commands.Execute(app, Commands.Command.CloseTab, false)
    if app.session_count != 2 || app.active != 1 || app.sessions[2].terminal.fd != -1 { return Failure("Close-tab command") }
    Commands.Execute(app, Commands.Command.Quit, false)
    return app.quit_requested
}
DrawSearch :: (session: UISessions.Session, app: *State.State) -> bool {
    PaintHost.Reset()
    if cast(s32)Frame.BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 800.0, 600.0}) != 0 { return false }
    Search.Draw(session, app)
    return cast(s32)Frame.EndFrame(session) == 0 && !PaintHost.failed && (!app.search_visible || PaintHost.texts > 0)
}
CheckSearchDialog :: () -> bool {
    app := Application()
    if app == null { return false }
    defer State.Dispose(app)
    app.session_count = 1; app.active = 0
    session := UISessions.SessionOpen()
    if !UISessions.SessionValid(session) { return false }
    defer Frame.CloseSession(session)
    Search.Focus(app)
    Input.TypedCodepointSend(session, 0x4e00)
    if !DrawSearch(session, app) || Value(app.search_text[:]) != "一" || app.search_cursor != 3 {
        return Failure("Search dialog Unicode input")
    }
    Input.KeyboardSend(session, Input.KeyLeft)
    if !DrawSearch(session, app) || app.search_cursor != 0 || app.search_anchor != 0 { return Failure("Search dialog cursor") }
    Input.TypedCodepointSend(session, #char "x")
    if !DrawSearch(session, app) || Value(app.search_text[:]) != "x一" { return Failure("Search dialog insertion") }
    Host.HostClipboardReset("replacement")
    Input.KeyboardModifiersSend(session, Input.KeyModifierControl)
    Input.KeyboardSend(session, #char "A")
    if !DrawSearch(session, app) { return false }
    Input.KeyboardSend(session, #char "V")
    if !DrawSearch(session, app) || Value(app.search_text[:]) != "replacement" { return Failure("Search dialog clipboard paste") }
    Input.KeyboardSend(session, #char "A")
    if !DrawSearch(session, app) { return false }
    oversized: [200]u8
    for index: cast(s32)0..cast(s32)199 { oversized[index] = #char "z" }
    Host.HostClipboardReset(TextView(oversized[:]))
    Input.KeyboardSend(session, #char "V")
    if !DrawSearch(session, app) || Value(app.search_text[:]) != "replacement" { return Failure("Search dialog paste bounds") }
    Input.KeyboardModifiersSend(session, 0)
    Input.KeyboardSend(session, Input.KeyEnter)
    if !DrawSearch(session, app) || !app.search_visible || !app.search_focused { return Failure("Search dialog Find action") }
    Input.KeyboardSend(session, Input.KeyEscape)
    if !DrawSearch(session, app) || app.search_visible || app.search_focused { return Failure("Search dialog Escape") }
    Search.Focus(app)
    if !DrawSearch(session, app) || !ClickKey(session, cast(u64)9203) ||
        !DrawSearch(session, app) || !app.search_visible || !app.search_focused {
        return Failure("Search dialog labeled Find button")
    }
    if !ClickKey(session, cast(u64)9202) || !DrawSearch(session, app) || app.search_visible || app.search_focused {
        return Failure("Search dialog labeled Cancel button")
    }
    Search.Focus(app)
    if !DrawSearch(session, app) { return false }
    Click(session, 20.0, 20.0)
    if !DrawSearch(session, app) || app.search_visible || app.search_focused {
        return Failure("Search dialog outside dismissal")
    }
    return true
}
CheckPromptStorage :: () -> bool {
    output: [8]u8
    Session.CopyText(output[:], "abcd")
    edit: Fields.TextFieldEdit
    edit.changed = true; edit.start = 1; edit.end = 2
    edit.replacement = Value(output[:])[0:3]
    if !Dialog.ApplyEdit(output[:], edit) || Value(output[:]) != "aabccd" { return Failure("Borrowed prompt edit") }
    edit.start = 9
    if Dialog.ApplyEdit(output[:], edit) || Value(output[:]) != "aabccd" { return Failure("Invalid prompt range") }
    edit.start = 0; edit.end = 0; edit.replacement = "01234567"
    if Dialog.ApplyEdit(output[:], edit) || Value(output[:]) != "aabccd" { return Failure("Oversized prompt edit") }
    edit.replacement = "x\0y"
    if Dialog.ApplyEdit(output[:], edit) || Value(output[:]) != "aabccd" { return Failure("NUL prompt edit") }
    return true
}

DrawContext :: (frame: UISessions.Session, app: *State.State) -> bool {
    PaintHost.Reset()
    if cast(s32)Frame.BeginFrame(frame, cast(u64)1, Rectangle.{0.0, 0.0, 800.0, 600.0}) != 0 { return false }
    Context.Draw(frame, app, false)
    return cast(s32)Frame.EndFrame(frame) == 0 && !PaintHost.failed
}
Click :: (frame: UISessions.Session, x: float32, y: float32) {
    Input.TreePointerUpdate(frame, Input.PointerFrame.{x, y, true, true, true})
}
ClickKey :: (frame: UISessions.Session, key: u64) -> bool {
    for index: 0..Tree.TreeCount(frame) - 1 {
        node := Tree.TreeNodeAt(frame, index)
        if node.key == key {
            Click(frame, node.bounds.x + node.bounds.width * 0.5, node.bounds.y + node.bounds.height * 0.5)
            return true
        }
    }
    return false
}
CheckContextMenu :: () -> bool {
    app := Application()
    if app == null { return false }
    defer State.Dispose(app)
    frame := UISessions.SessionOpen()
    if !UISessions.SessionValid(frame) { return false }
    defer Frame.CloseSession(frame)
    app.context_menu_open = true
    if !DrawContext(frame, app) || app.context_menu_open { return Failure("Context menu without a tab") }
    app.session_count = 1; app.active = 0
    app.context_menu_x = 20; app.context_menu_y = 20; app.context_menu_open = true
    if !DrawContext(frame, app) { return false }
    Click(frame, 40.0, 63.0)
    if !DrawContext(frame, app) || !app.context_menu_open || app.session_count != 1 {
        return Failure("Context menu disabled last-tab close")
    }
    Host.HostClipboardReset("keep clipboard")
    Click(frame, 40.0, 98.0)
    if !DrawContext(frame, app) || !app.context_menu_open || Host.HostClipboardText() != "keep clipboard" {
        return Failure("Context menu disabled copy")
    }
    Input.TypedCodepointSend(frame, #char "x")
    Input.KeyboardSend(frame, Input.KeyEscape)
    if !DrawContext(frame, app) || app.context_menu_open || Input.TypedCodepointTake(frame) != 0 {
        return Failure("Context menu Escape and text ownership")
    }
    app.context_menu_open = true
    if !DrawContext(frame, app) { return false }
    Click(frame, 40.0, 37.0)
    if !DrawContext(frame, app) || app.context_menu_open || app.session_count != 2 || app.active != 1 {
        return Failure("Context menu new tab")
    }
    app.context_menu_open = true
    if !DrawContext(frame, app) { return false }
    Click(frame, 40.0, 63.0)
    if !DrawContext(frame, app) || app.context_menu_open || app.session_count != 1 {
        return Failure("Context menu close tab")
    }
    app.context_menu_open = true
    if !DrawContext(frame, app) { return false }
    Click(frame, 700.0, 500.0)
    if !DrawContext(frame, app) || app.context_menu_open { return Failure("Context menu outside dismissal") }
    app.context_menu_open = true
    if !DrawContext(frame, app) { return false }
    Click(frame, 40.0, 210.0)
    if !DrawContext(frame, app) || app.context_menu_open || !app.search_visible || !app.search_focused {
        return Failure("Context menu Find command")
    }
    return true
}

DrawMenu :: (frame: UISessions.Session, app: *State.State, fresh: bool = true) -> bool {
    PaintHost.Reset()
    if cast(s32)Frame.BeginFrame(frame, cast(u64)1, Rectangle.{0.0, 0.0, 800.0, 600.0}) != 0 { return false }
    Menu.Draw(frame, app, Rectangle.{0.0, 0.0, 800.0, 34.0}, false, fresh)
    return cast(s32)Frame.EndFrame(frame) == 0 && !PaintHost.failed
}
MenuRow :: (app: *State.State, depth: s32, index: s32) -> u64 {
    return Widgets.MenuRowKey(Widgets.MenuPanelKey(cast(u64)1200, *app.menu, depth), index)
}
CheckMenuBar :: () -> bool {
    app := Application()
    if app == null { return false }
    defer State.Dispose(app)
    app.session_count = 1; app.active = 0
    frame := UISessions.SessionOpen()
    if !UISessions.SessionValid(frame) { return false }
    defer Frame.CloseSession(frame)
    if !DrawMenu(frame, app) || PaintHost.texts != 6 || app.menu.open_index != -1 { return Failure("Six menu groups") }
    font := app.config.font_size
    if !ClickKey(frame, Widgets.MenuGroupKey(cast(u64)1200, 2)) || !DrawMenu(frame, app) || app.menu.open_index != 2 {
        return Failure("Menu bar pointer opens View")
    }
    Input.TypedCodepointSend(frame, #char "x")
    if !ClickKey(frame, MenuRow(app, 0, 0)) || !DrawMenu(frame, app) ||
        app.config.font_size != font + 1 || app.menu.open_index != -1 || Input.TypedCodepointTake(frame) != 0 {
        return Failure("Menu bar zoom command and text ownership")
    }
    if !Menu.HandleShortcut(app, 299, 0) || !app.menu.focused || !DrawMenu(frame, app) { return Failure("F10 menu focus") }
    Input.KeyboardSend(frame, 299)
    if !DrawMenu(frame, app, false) || !app.menu.focused { return Failure("Repeated F10 retains menu focus") }
    Input.KeyboardSend(frame, Input.KeyDown)
    if !DrawMenu(frame, app) || app.menu.open_index != 2 { return Failure("Focused menu opens with Down") }
    Input.KeyboardSend(frame, Input.KeyRight)
    if !DrawMenu(frame, app) || app.menu.open_index != 3 { return Failure("Menu group keyboard navigation") }
    Input.KeyboardSend(frame, Input.KeyEnd)
    if !DrawMenu(frame, app) || app.menu.selected[0] != 28 || app.menu.scroll[0] <= 0 { return Failure("Long Terminal menu remains reachable") }
    Input.KeyboardSend(frame, Input.KeyEnter)
    if !DrawMenu(frame, app) || app.profile_prompt != Types.TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_IMAGE || app.menu.focused {
        return Failure("Last Terminal menu profile command")
    }
    app.profile_prompt = 0; app.profile_focused = false
    if !Menu.HandleShortcut(app, #char "T", Keys.TERMINAL_PANE_MOD_ALT) { return Failure("Terminal menu mnemonic") }
    app.menu.selected[0] = 13; app.menu.reveal = true
    Input.KeyboardSend(frame, Input.KeyRight)
    if !DrawMenu(frame, app) || app.menu.depth != 1 { return Failure("Cursor Style submenu") }
    Input.KeyboardSend(frame, Input.KeyDown); if !DrawMenu(frame, app) { return false }
    Input.KeyboardSend(frame, Input.KeyDown); if !DrawMenu(frame, app) { return false }
    Input.KeyboardSend(frame, Input.KeyEnter)
    if !DrawMenu(frame, app) || app.config.cursor_style != Engine.TERMINAL_CURSOR_BAR || app.menu.open_index != -1 {
        return Failure("Cursor Style radio command")
    }
    if !Menu.HandleShortcut(app, #char "F", Keys.TERMINAL_PANE_MOD_ALT) || !DrawMenu(frame, app) ||
        !ClickKey(frame, MenuRow(app, 0, 0)) || !DrawMenu(frame, app) || app.session_count != 2 || app.active != 1 {
        return Failure("Menu New Tab lifecycle command")
    }
    if !ClickKey(frame, Widgets.MenuGroupKey(cast(u64)1200, 4)) || !DrawMenu(frame, app) ||
        !ClickKey(frame, MenuRow(app, 0, 4)) || !DrawMenu(frame, app) || app.active != 0 {
        return Failure("Menu Previous Tab command")
    }
    if !ClickKey(frame, Widgets.MenuGroupKey(cast(u64)1200, 1)) || !DrawMenu(frame, app) ||
        !ClickKey(frame, MenuRow(app, 0, 4)) || !DrawMenu(frame, app) || !app.search_visible || !app.search_focused {
        return Failure("Menu Find command")
    }
    app.search_visible = false; app.search_focused = false
    if !ClickKey(frame, Widgets.MenuGroupKey(cast(u64)1200, 5)) || !DrawMenu(frame, app) ||
        !ClickKey(frame, MenuRow(app, 0, 0)) || !DrawMenu(frame, app) || !app.about_visible { return Failure("Menu About command") }
    app.about_visible = false
    if !ClickKey(frame, Widgets.MenuGroupKey(cast(u64)1200, 0)) || !DrawMenu(frame, app) { return false }
    Click(frame, 790.0, 590.0)
    if !DrawMenu(frame, app) || app.menu.open_index != -1 || app.menu.focused { return Failure("Menu outside dismissal") }
    if !Menu.HandleShortcut(app, #char "F", Keys.TERMINAL_PANE_MOD_ALT) || !DrawMenu(frame, app) { return false }
    Input.KeyboardSend(frame, 290)
    if !DrawMenu(frame, app) || !app.about_visible || app.menu.open_index != -1 || app.menu.focused {
        return Failure("Help transfers input ownership from the menu")
    }
    app.about_visible = false
    app.config.disable_menu_shortcut = 1; app.config.disable_menu_mnemonics = 1; app.config.disable_help_shortcut = 1
    if Menu.HandleShortcut(app, 299, 0) || Menu.HandleShortcut(app, #char "F", Keys.TERMINAL_PANE_MOD_ALT) ||
        Menu.HandleShortcut(app, 290, 0) { return Failure("Disabled menu/help shortcuts") }
    app.launch.show_menubar = false
    if !DrawMenu(frame, app) || PaintHost.texts != 0 || app.menu.open_index != -1 { return Failure("Hidden menu bar") }
    app.config.disable_help_shortcut = 0
    return Menu.HandleShortcut(app, 290, 0) && app.about_visible
}

#scope_export
#program_export
main :: () -> s32 {
    if !CheckPalette() { print("Terminal application palette failed\n"); return 1 }
    if !CheckStateAndProfile() { print("Terminal application state/profile failed\n"); return 2 }
    if !CheckSelectionAndClipboard() { print("Terminal application selection/clipboard failed\n"); return 3 }
    if !CheckSessions() { print("Terminal application session ownership failed\n"); return 4 }
    if !CheckCommandsAndSearch() { print("Terminal application command/search policy failed\n"); return 5 }
    if !CheckSearchDialog() { print("Terminal application search dialog failed\n"); return 6 }
    if !CheckPromptStorage() { print("Terminal application prompt storage failed\n"); return 7 }
    if !CheckContextMenu() { print("Terminal application context menu failed\n"); return 8 }
    if !CheckMenuBar() { print("Terminal application menu bar failed\n"); return 9 }
    return 0
}
