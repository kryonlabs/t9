#import "terminal_pane_render"
#import "terminal_pane_render_theme"

#program_export
main :: () -> s32 {
    cells: [4]TerminalPaneGridCell
    grid: TerminalPaneGridDraw

    cells[0].codepoint = 65
    cells[0].combining = 769
    cells[0].foreground = Color.{255, 254, 253, 252}
    cells[1].codepoint = 66
    cells[1].flags = TERMINAL_PANE_GRID_CELL_HIDDEN
    cells[2].codepoint = 67
    cells[2].flags = TERMINAL_PANE_GRID_CELL_WIDE_CONT
    cells[3].codepoint = 68

    grid.bounds = Rectangle.{10.0, 20.0, 24.0, 24.0}
    grid.cols = 2
    grid.rows = 2
    grid.cell_width = 8
    grid.line_height = 12
    grid.font_size = 14
    grid.cells = *cells[0]

    DrawTerminalPaneGlyphGrid(grid)
    if RenderProbeCount != 3 { return 1 }
    if RenderProbeCodepoints[0] != 65 || RenderProbeX[0] != 10 ||
       RenderProbeY[0] != 20 { return 2 }
    if RenderProbeCodepoints[1] != 769 || RenderProbeX[1] != 10 ||
       RenderProbeY[1] != 20 { return 3 }
    if RenderProbeCodepoints[2] != 68 || RenderProbeX[2] != 18 ||
       RenderProbeY[2] != 32 || RenderProbeFont[2] != 14 ||
       RenderProbeColor[2].a != 0 { return 4 }

    RenderProbeCount = 0
    grid.cells = null
    DrawTerminalPaneGlyphGrid(grid)
    if RenderProbeCount != 0 { return 5 }

    grid.cells = *cells[0]
    grid.rows = 0
    DrawTerminalPaneGlyphGrid(grid)
    if RenderProbeCount != 0 { return 6 }

    grid.rows = 2
    grid.cell_width = 0
    DrawTerminalPaneGlyphGrid(grid)
    if RenderProbeCount != 0 { return 7 }
    return 0
}
