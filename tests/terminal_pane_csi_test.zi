#import "terminal_pane_csi"

Same :: (value: *u8, expected: string) -> bool {
    index: s32 = 0
    while index < cast(s32)expected.count {
        if value[index] != expected[index] { return false }
        index += 1
    }
    return value[index] == 0
}

#program_export
main :: () -> s32 {
    output: [64]u8

    if FormatTerminalPaneDeviceStatusReport(*output[0], 64, 0, 5, 2, 4) != 4 ||
       !Same(*output[0], "\x1b[0n") { return 1 }
    if FormatTerminalPaneDeviceStatusReport(*output[0], 64, 0, 6, 2, 4) != 6 ||
       !Same(*output[0], "\x1b[3;5R") { return 2 }
    if FormatTerminalPaneDeviceStatusReport(*output[0], 64, 1, 6, 2, 4) != 7 ||
       !Same(*output[0], "\x1b[?3;5R") { return 3 }
    if FormatTerminalPaneDeviceStatusReport(*output[0], 64, 1, 15, 0, 0) != 6 ||
       !Same(*output[0], "\x1b[?10n") { return 4 }
    if FormatTerminalPaneDeviceStatusReport(*output[0], 64, 1, 26, 0, 0) != 12 ||
       !Same(*output[0], "\x1b[?27;1;0;0n") { return 5 }

    output[0] = 120
    if FormatTerminalPaneDeviceStatusReport(*output[0], 64, 0, 15, 0, 0) != 0 ||
       output[0] != 0 { return 6 }
    output[0] = 120
    if FormatTerminalPaneDeviceStatusReport(*output[0], 4, 1, 26, 0, 0) != 0 ||
       output[0] != 0 { return 7 }
    return 0
}
