#module "app_chrome"
#inspect off
# k2c's generated header app/app_chrome.h would shadow src/app_chrome.h
# (quoted includes search the generated dir first, turning the import into
# a self-include), so pull in the own header's include instead.
#import "app_state.h"
#import "kryon.h"

app_menu_bar_height :: (app: *const State) -> i32 #export {
    return app != nil && app->launch.show_menubar ? Scale(34) : 0
}

app_tab_bar_visible :: (app: *const State) -> i32 #export {
    return app != nil && app->launch.show_toolbar &&
    (app->config.always_show_tabs || app->session_count > 1)
}

app_tab_bar_height :: (app: *const State) -> i32 #export {
    return app_tab_bar_visible(app) ? TabBarHeight() : 0
}

app_chrome_height :: (app: *const State) -> i32 #export {
    return app_menu_bar_height(app) + app_tab_bar_height(app)
}
