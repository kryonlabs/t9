#module "app_clipboard"
#inspect off
# k2c's generated header app/app_clipboard.h would shadow src/app_clipboard.h
# (quoted includes search the generated dir first, turning the import into
# a self-include), so pull in the own header's include instead.
#import "app_state.h"
#import "app_sessions.h"
#import "limits.h"
#import "stddef.h"

clipboard_actions :: (app: *State,
session: *Session) -> TerminalPaneClipboardActions {
    actions: TerminalPaneClipboardActions = {0}
    selection: TerminalPaneClipboardController = {0}
    terminal: TerminalPaneClipboardController = {0}

    if session == nil { return actions }
    if app != nil {
        selection = selection_clipboard_controller(&app->selection,
        &session->terminal)
    }
    terminal = MakeTerminalPaneClipboardController(
    terminal_clipboard(&session->terminal), nil, nil, nil, nil, 0, 0,
    &session->scroll_offset)
    return MakeTerminalPaneClipboardActions(selection, terminal)
}

active_clipboard_actions :: (app: *State) -> TerminalPaneClipboardActions {
    actions: TerminalPaneClipboardActions = {0}

    if app == nil { return actions }
    return clipboard_actions(app, active_session(app))
}

collect_selection_text :: (app: *State, buffer: *char,
buffer_size: size_t) -> i32 #export {
    if buffer == nil || buffer_size == 0 { return 0 }
    buffer[0] = '\0'
    if buffer_size > (size_t)INT_MAX {
        buffer_size = (size_t)INT_MAX
    }
    return TerminalPaneClipboardCollectSelectionText(
    active_clipboard_actions(app), buffer, (int)buffer_size)
}

primary_selection_available :: () -> i32 #export {
    return TerminalPaneClipboardPrimarySelectionAvailable()
}

update_primary_selection :: (app: *State) #export {
    TerminalPaneClipboardUpdatePrimary(active_clipboard_actions(app))
}

copy_selection :: (app: *State) #export {
    TerminalPaneClipboardCopy(active_clipboard_actions(app))
}

paste_text_to_session :: (session: *Session, text: const char*) #export {
    if session == nil || text == nil || text[0] == '\0' { return }
    TerminalPaneClipboardPasteActionsText(
    clipboard_actions(nil, session), text)
}

paste_clipboard_to_session :: (session: *Session) #export {
    if session == nil { return }
    TerminalPaneClipboardPasteActionsClipboard(
    clipboard_actions(nil, session))
}

paste_primary_to_session :: (app: *State, session: *Session) #export {
    if app == nil || session == nil { return }
    TerminalPaneClipboardPasteActionsPrimary(
    clipboard_actions(app, session))
}

paste_primary_or_clipboard_to_session :: (app: *State,
session: *Session) #export {
    if app == nil || session == nil { return }
    TerminalPaneClipboardPasteActionsPreferred(
    clipboard_actions(app, session))
}

sync_host_clipboard_to_terminal :: (session: *Session) #export {
    if session == nil { return }
    TerminalPaneClipboardActionsSyncFromHost(
    clipboard_actions(nil, session))
}

flush_terminal_clipboard_to_host :: (session: *Session) #export {
    if session == nil { return }
    TerminalPaneClipboardActionsFlushToHost(
    clipboard_actions(nil, session))
}

select_all :: (app: *State) #export {
    TerminalPaneClipboardSelectAll(active_clipboard_actions(app))
}
