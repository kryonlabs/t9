#module "app_commands"
#inspect off
# k2c's generated header app/app_commands.h would shadow src/app_commands.h
# (quoted includes search the generated dir first, turning the import into
# a self-include), so pull in the own header's include instead. The
# PROFILE_PROMPT_* kinds from app_profile.h are aliases of the
# TERMINAL_PANE_PROFILE_PROMPT_* constants used below.
#import "app_state.h"
#import "app_clipboard.h"
#import "app_profile.h"
#import "app_search.h"
#import "app_sessions.h"
#import "config.h"
#import "input.h"
#import "profile.h"
#import "kryon.h"

# The AppCommand enum lives in src/app_commands.h, which this module cannot
# #import (the generated app/app_commands.h shadows it into a self-include),
# so mirror the exact values here; k2c lowers them to #defines in the
# generated header for importers.
APP_COMMAND_NONE :: 0
APP_COMMAND_NEW_TAB :: 1001
APP_COMMAND_CLOSE_TAB :: 1002
APP_COMMAND_QUIT :: 1003
APP_COMMAND_COPY :: 1004
APP_COMMAND_PASTE :: 1005
APP_COMMAND_SELECT_ALL :: 1006
APP_COMMAND_FONT_INCREASE :: 1007
APP_COMMAND_FONT_DECREASE :: 1008
APP_COMMAND_FONT_RESET :: 1009
APP_COMMAND_NEXT_TAB :: 1010
APP_COMMAND_PREVIOUS_TAB :: 1011
APP_COMMAND_FIND :: 1012
APP_COMMAND_FIND_NEXT :: 1013
APP_COMMAND_FIND_PREVIOUS :: 1014
APP_COMMAND_PROFILE_SHELL :: 1015
APP_COMMAND_PROFILE_CWD :: 1016
APP_COMMAND_PROFILE_FONT_FILE :: 1017
APP_COMMAND_PROFILE_FONT_SIZE :: 1018
APP_COMMAND_PROFILE_SCROLLBACK :: 1019
APP_COMMAND_PROFILE_FOREGROUND :: 1020
APP_COMMAND_PROFILE_BACKGROUND :: 1021
APP_COMMAND_PROFILE_CURSOR_COLOR :: 1022
APP_COMMAND_PROFILE_SELECTION_FOREGROUND :: 1023
APP_COMMAND_PROFILE_SELECTION_BACKGROUND :: 1024
APP_COMMAND_PROFILE_DYNAMIC_TITLE_MODE :: 1025
APP_COMMAND_PROFILE_BACKSPACE_BINDING :: 1026
APP_COMMAND_PROFILE_DELETE_BINDING :: 1027
APP_COMMAND_PROFILE_AMBIGUOUS_WIDTH :: 1028
APP_COMMAND_PROFILE_ALLOW_BOLD :: 1029
APP_COMMAND_PROFILE_UNLIMITED_SCROLLBACK :: 1030
APP_COMMAND_PROFILE_AUTO_HIDE_MOUSE :: 1031
APP_COMMAND_PROFILE_MIDDLE_CLICK_CLOSE_TAB :: 1032
APP_COMMAND_PROFILE_ALWAYS_SHOW_TABS :: 1033
APP_COMMAND_PROFILE_DISABLE_MENU_MNEMONICS :: 1034
APP_COMMAND_PROFILE_DISABLE_MENU_SHORTCUT :: 1035
APP_COMMAND_PROFILE_DISABLE_HELP_SHORTCUT :: 1036
APP_COMMAND_PROFILE_BACKGROUND_OPACITY :: 1037
APP_COMMAND_PROFILE_BACKGROUND_IMAGE :: 1038
APP_COMMAND_CURSOR_BLOCK :: 1039
APP_COMMAND_CURSOR_UNDERLINE :: 1040
APP_COMMAND_CURSOR_BAR :: 1041
APP_COMMAND_ABOUT :: 1042

clamp_int :: (value: i32, low: i32, high: i32) -> i32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

set_font_size :: (app: *State, font_size: i32) {
    if app == nil { return }
    app->config.font_size = clamp_int(font_size, KTREM_MIN_FONT_SIZE,
    KTREM_MAX_FONT_SIZE)
    config_save(&app->config)
}

handle_alt_tab_shortcut :: (app: *State) -> i32 {
    # k2c drops fixed-array initializers on module globals; the
    # table must stay a local until global initializers lower.
    # MAX_SESSIONS is 8.
    keypad_keys: [8]i32 = {
        KEY_KP_1, KEY_KP_2, KEY_KP_3, KEY_KP_4,
        KEY_KP_5, KEY_KP_6, KEY_KP_7, KEY_KP_8
    }
    i: i32

    if app == nil { return 0 }
    i = 0
    while i < app->session_count && i < 8 {
        if IsLayoutKeyPressed('1' + i) != 0 ||
        IsKeyPressed(keypad_keys[i]) != 0 {
            set_active_session(app, i)
            return 1
        }
        i += 1
    }
    return 0
}

app_execute_command :: (app: *State, command: i32) #export {
    session: *Session = active_session(app)

    if app == nil { return }
    if command == APP_COMMAND_NEW_TAB {
        open_session(app, nil)
    } else if command == APP_COMMAND_CLOSE_TAB {
        close_session(app, app->active)
    } else if command == APP_COMMAND_QUIT {
        app->quit_requested = 1
    } else if command == APP_COMMAND_COPY {
        copy_selection(app)
    } else if command == APP_COMMAND_PASTE {
        paste_clipboard_to_session(session)
    } else if command == APP_COMMAND_SELECT_ALL {
        select_all(app)
    } else if command == APP_COMMAND_FONT_INCREASE {
        set_font_size(app, app->config.font_size + 1)
    } else if command == APP_COMMAND_FONT_DECREASE {
        set_font_size(app, app->config.font_size - 1)
    } else if command == APP_COMMAND_FONT_RESET {
        set_font_size(app, KTREM_DEFAULT_FONT_SIZE)
    } else if command == APP_COMMAND_NEXT_TAB {
        if app->session_count > 0 {
            set_active_session(app, (app->active + 1) % app->session_count)
        }
    } else if command == APP_COMMAND_PREVIOUS_TAB {
        if app->session_count > 0 {
            set_active_session(app,
            (app->active + app->session_count - 1) % app->session_count)
        }
    } else if command == APP_COMMAND_FIND {
        focus_search(app)
    } else if command == APP_COMMAND_FIND_NEXT {
        if app->search_text[0] == '\0' {
            focus_search(app)
        } else {
            find_scrollback_direction(app, 1)
        }
    } else if command == APP_COMMAND_FIND_PREVIOUS {
        if app->search_text[0] == '\0' {
            focus_search(app)
        } else {
            find_scrollback_direction(app, -1)
        }
    } else if command == APP_COMMAND_PROFILE_SHELL {
        open_profile_prompt(app, TERMINAL_PANE_PROFILE_PROMPT_SHELL)
    } else if command == APP_COMMAND_PROFILE_CWD {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_WORKING_DIRECTORY)
    } else if command == APP_COMMAND_PROFILE_FONT_FILE {
        open_profile_prompt(app, TERMINAL_PANE_PROFILE_PROMPT_TERMINAL_FONT)
    } else if command == APP_COMMAND_PROFILE_FONT_SIZE {
        open_profile_prompt(app, TERMINAL_PANE_PROFILE_PROMPT_FONT_SIZE)
    } else if command == APP_COMMAND_PROFILE_SCROLLBACK {
        open_profile_prompt(app, TERMINAL_PANE_PROFILE_PROMPT_SCROLLBACK)
    } else if command == APP_COMMAND_PROFILE_FOREGROUND {
        open_profile_prompt(app, TERMINAL_PANE_PROFILE_PROMPT_FOREGROUND)
    } else if command == APP_COMMAND_PROFILE_BACKGROUND {
        open_profile_prompt(app, TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND)
    } else if command == APP_COMMAND_PROFILE_CURSOR_COLOR {
        open_profile_prompt(app, TERMINAL_PANE_PROFILE_PROMPT_CURSOR_COLOR)
    } else if command == APP_COMMAND_PROFILE_SELECTION_FOREGROUND {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_SELECTION_FOREGROUND)
    } else if command == APP_COMMAND_PROFILE_SELECTION_BACKGROUND {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_SELECTION_BACKGROUND)
    } else if command == APP_COMMAND_PROFILE_DYNAMIC_TITLE_MODE {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_DYNAMIC_TITLE_MODE)
    } else if command == APP_COMMAND_PROFILE_BACKSPACE_BINDING {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_BACKSPACE_BINDING)
    } else if command == APP_COMMAND_PROFILE_DELETE_BINDING {
        open_profile_prompt(app, TERMINAL_PANE_PROFILE_PROMPT_DELETE_BINDING)
    } else if command == APP_COMMAND_PROFILE_AMBIGUOUS_WIDTH {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_AMBIGUOUS_WIDTH)
    } else if command == APP_COMMAND_PROFILE_ALLOW_BOLD {
        open_profile_prompt(app, TERMINAL_PANE_PROFILE_PROMPT_ALLOW_BOLD)
    } else if command == APP_COMMAND_PROFILE_UNLIMITED_SCROLLBACK {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_UNLIMITED_SCROLLBACK)
    } else if command == APP_COMMAND_PROFILE_AUTO_HIDE_MOUSE {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_AUTO_HIDE_MOUSE)
    } else if command == APP_COMMAND_PROFILE_MIDDLE_CLICK_CLOSE_TAB {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_MIDDLE_CLICK_CLOSE_TAB)
    } else if command == APP_COMMAND_PROFILE_ALWAYS_SHOW_TABS {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_ALWAYS_SHOW_TABS)
    } else if command == APP_COMMAND_PROFILE_DISABLE_MENU_MNEMONICS {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_DISABLE_MENU_MNEMONICS)
    } else if command == APP_COMMAND_PROFILE_DISABLE_MENU_SHORTCUT {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_DISABLE_MENU_SHORTCUT)
    } else if command == APP_COMMAND_PROFILE_DISABLE_HELP_SHORTCUT {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_DISABLE_HELP_SHORTCUT)
    } else if command == APP_COMMAND_PROFILE_BACKGROUND_OPACITY {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_OPACITY)
    } else if command == APP_COMMAND_PROFILE_BACKGROUND_IMAGE {
        open_profile_prompt(app,
        TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_IMAGE)
    } else if command == APP_COMMAND_CURSOR_BLOCK {
        app->config.cursor_style = TERMINAL_CURSOR_BLOCK
        config_save(&app->config)
    } else if command == APP_COMMAND_CURSOR_UNDERLINE {
        app->config.cursor_style = TERMINAL_CURSOR_UNDERLINE
        config_save(&app->config)
    } else if command == APP_COMMAND_CURSOR_BAR {
        app->config.cursor_style = TERMINAL_CURSOR_BAR
        config_save(&app->config)
    } else if command == APP_COMMAND_ABOUT {
        app->about_visible = 1
    }
}

app_handle_shortcuts :: (app: *State) -> i32 #export {
    session: *Session = active_session(app)
    ctrl: i32 = IsKeyDown(KEY_LEFT_CONTROL) || IsKeyDown(KEY_RIGHT_CONTROL)
    shift: i32 = IsKeyDown(KEY_LEFT_SHIFT) || IsKeyDown(KEY_RIGHT_SHIFT)
    alt: i32 = IsKeyDown(KEY_LEFT_ALT) || IsKeyDown(KEY_RIGHT_ALT)

    if session == nil { return 0 }
    if alt != 0 && handle_alt_tab_shortcut(app) != 0 {
        return 1
    }
    if ctrl != 0 && shift != 0 && IsLayoutKeyPressed('t') != 0 {
        app_execute_command(app, APP_COMMAND_NEW_TAB)
        return 1
    }
    if ctrl != 0 && shift != 0 && IsLayoutKeyPressed('w') != 0 {
        app_execute_command(app, APP_COMMAND_CLOSE_TAB)
        return 1
    }
    if ctrl != 0 && shift != 0 && IsKeyPressed(KEY_TAB) != 0 {
        app_execute_command(app, APP_COMMAND_PREVIOUS_TAB)
        return 1
    }
    if ctrl != 0 && IsKeyPressed(KEY_PAGE_UP) != 0 {
        app_execute_command(app, APP_COMMAND_PREVIOUS_TAB)
        return 1
    }
    if ctrl != 0 && IsKeyPressed(KEY_TAB) != 0 {
        app_execute_command(app, APP_COMMAND_NEXT_TAB)
        return 1
    }
    if ctrl != 0 && IsKeyPressed(KEY_PAGE_DOWN) != 0 {
        app_execute_command(app, APP_COMMAND_NEXT_TAB)
        return 1
    }
    if ctrl != 0 && (IsKeyPressed(KEY_EQUAL) != 0 ||
    IsKeyPressed(KEY_KP_ADD) != 0) {
        app_execute_command(app, APP_COMMAND_FONT_INCREASE)
        return 1
    }
    if ctrl != 0 && (IsKeyPressed(KEY_MINUS) != 0 ||
    IsKeyPressed(KEY_KP_SUBTRACT) != 0) {
        app_execute_command(app, APP_COMMAND_FONT_DECREASE)
        return 1
    }
    if ctrl != 0 && (IsKeyPressed(KEY_ZERO) != 0 ||
    IsKeyPressed(KEY_KP_0) != 0) {
        app_execute_command(app, APP_COMMAND_FONT_RESET)
        return 1
    }
    if ctrl != 0 && IsKeyPressed(KEY_INSERT) != 0 {
        app_execute_command(app, APP_COMMAND_COPY)
        return 1
    }
    if shift != 0 && IsKeyPressed(KEY_INSERT) != 0 {
        app_execute_command(app, APP_COMMAND_PASTE)
        return 1
    }
    if ctrl != 0 && shift != 0 && IsLayoutKeyPressed('c') != 0 {
        app_execute_command(app, APP_COMMAND_COPY)
        return 1
    }
    if ctrl != 0 && shift != 0 && IsLayoutKeyPressed('v') != 0 {
        app_execute_command(app, APP_COMMAND_PASTE)
        return 1
    }
    if ctrl != 0 && shift != 0 && IsLayoutKeyPressed('a') != 0 {
        app_execute_command(app, APP_COMMAND_SELECT_ALL)
        return 1
    }
    if ctrl != 0 && shift != 0 && IsLayoutKeyPressed('f') != 0 {
        app_execute_command(app, APP_COMMAND_FIND)
        return 1
    }
    if ctrl != 0 && shift != 0 && IsLayoutKeyPressed('g') != 0 {
        app_execute_command(app, APP_COMMAND_FIND_NEXT)
        return 1
    }
    if ctrl != 0 && shift != 0 && IsLayoutKeyPressed('b') != 0 {
        app_execute_command(app, APP_COMMAND_FIND_PREVIOUS)
        return 1
    }
    if ctrl != 0 && shift != 0 && IsLayoutKeyPressed('q') != 0 {
        app_execute_command(app, APP_COMMAND_QUIT)
        return 1
    }
    return 0
}
