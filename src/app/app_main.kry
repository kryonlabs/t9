PLAN9_BUILD :: #defined(KRYON_NATIVE_PLAN9)
WIN32_BUILD :: #defined(_WIN32)
WEB_BUILD :: #defined(PLATFORM_WEB)

# Angle imports above dodge the generated same-name module headers in
# generated/src/app/ so the real src/ headers are used.

CodepointBuilder :: struct {
    values: *i32
    count: i32
    capacity: i32
}

codepoints_append :: (builder: *CodepointBuilder, codepoint: i32) -> i32 {
    next: *i32

    if builder == nil || codepoint <= 0 {
        return 0
    }
    if builder->count >= builder->capacity {
        next_capacity: i32 = builder->capacity > 0
        ? builder->capacity * 2 : 512

        next = realloc(builder->values,
                       (size_t)next_capacity * sizeof(*builder->values))
        if next == nil {
            return 0
        }
        builder->values = next
        builder->capacity = next_capacity
    }
    builder->values[builder->count] = codepoint
    builder->count += 1
    return 1
}

codepoints_append_range :: (builder: *CodepointBuilder, first: i32,
last: i32) -> i32 {
    codepoint: i32 = first

    while codepoint <= last {
        if codepoints_append(builder, codepoint) == 0 {
            return 0
        }
        codepoint += 1
    }
    return 1
}

terminal_codepoints :: (out_count: *i32) -> *i32 {
    builder: CodepointBuilder = {0}
    individual: [5]i32 = {
        0x1f310,
        0x1f4a1,
        0x1f600,
        0x6e2c, 0x8a66
    }
    ranges: [25][2]i32 = {
        {0x0020, 0x007e},
        {0x00a0, 0x024f},
        {0x0300, 0x036f},
        {0x0370, 0x03ff},
        {0x0400, 0x052f},
        {0x2000, 0x206f},
        {0x2070, 0x209f},
        {0x20a0, 0x20cf},
        {0x2100, 0x214f},
        {0x2150, 0x218f},
        {0x2190, 0x21ff},
        {0x2200, 0x22ff},
        {0x2300, 0x23ff},
        {0x2400, 0x243f},
        {0x2460, 0x24ff},
        {0x2500, 0x259f},
        {0x25a0, 0x25ff},
        {0x2600, 0x27bf},
        {0x2800, 0x28ff},
        {0x2b00, 0x2bff},
        {0x1f300, 0x1f5ff},
        {0x1f600, 0x1f64f},
        {0xe0a0, 0xe0ff},
        {0xe700, 0xe7c5},
        {0xf000, 0xf2ff}
    }
    i: i32
    ok: i32 = 1

    if out_count == nil {
        return nil
    }
    *out_count = 0
    i = 0
    while i < (int)(sizeof(ranges) / sizeof(ranges[0])) {
        if codepoints_append_range(&builder, ranges[i][0],
        ranges[i][1]) == 0 {
            ok = 0
            break
        }
        i += 1
    }
    if ok == 0 {
        free(builder.values)
        return nil
    }
    i = 0
    while i < (int)(sizeof(individual) / sizeof(individual[0])) {
        if codepoints_append(&builder, individual[i]) == 0 {
            free(builder.values)
            return nil
        }
        i += 1
    }
    *out_count = builder.count
    return builder.values
}

terminal_cjk_codepoints :: (out_count: *i32) -> *i32 {
    builder: CodepointBuilder = {0}
    individual: [2]i32 = {
        0x6e2c,
        0x8a66
    }
    ranges: [6][2]i32 = {
        {0x3040, 0x309f},
        {0x30a0, 0x30ff},
        {0x3400, 0x34ff},
        {0x4e00, 0x52ff},
        {0x6e00, 0x6eff},
        {0x8a00, 0x8aff}
    }
    i: i32
    ok: i32 = 1

    if out_count == nil {
        return nil
    }
    *out_count = 0
    i = 0
    while i < (int)(sizeof(ranges) / sizeof(ranges[0])) {
        if codepoints_append_range(&builder, ranges[i][0],
        ranges[i][1]) == 0 {
            ok = 0
            break
        }
        i += 1
    }
    if ok == 0 {
        free(builder.values)
        return nil
    }
    i = 0
    while i < (int)(sizeof(individual) / sizeof(individual[0])) {
        if codepoints_append(&builder, individual[i]) == 0 {
            free(builder.values)
            return nil
        }
        i += 1
    }
    *out_count = builder.count
    return builder.values
}

#if PLAN9_BUILD {

native_rill_control_path :: () -> *const char {
    path: *const char

    path = getenv("rillctl")
    if path != nil && path[0] != '\0' {
        return path
    }
    path = getenv("RILLCTL")
    if path != nil && path[0] != '\0' {
        return path
    }
    path = getenv("RILL_COMMAND_FILE")
    if path != nil && path[0] != '\0' {
        return path
    }
    return nil
}

native_request_rill_terminal :: () -> i32 {
    path: *const char
    file: *FILE

    path = native_rill_control_path()
    if path == nil {
        return 0
    }
    file = fopen(path, "a")
    if file == nil {
        return 0
    }
    fprintf(file, "open t9\n")
    fclose(file)
    return 1
}

native_can_open :: (path: *const char, mode: i32) -> i32 {
    fd: i32

    fd = open((char *)path, mode)
    if fd < 0 {
        return 0
    }
    close(fd)
    return 1
}

native_graphics_namespace_ready :: () -> i32 {
    return native_can_open("/dev/draw/new", OREAD) != 0 &&
           native_can_open("/dev/mouse", OREAD) != 0
}

}

path_in_list :: (paths: **const char, count: i32, path: *const char) -> i32 {
    i: i32

    if path == nil || path[0] == '\0' {
        return 1
    }
    i = 0
    while i < count {
        if paths[i] != nil && strcmp(paths[i], path) == 0 {
            return 1
        }
        i += 1
    }
    return 0
}

# The fontconfig branch is POSIX-only; Windows, web, and Plan 9 builds
# simply skip the match.
fontconfig_match_charset :: (codepoint: u32, out: *char,
out_size: i32) -> i32 {
#if !WIN32_BUILD && !WEB_BUILD && !PLAN9_BUILD {
    command: [96]char
    line: [512]char
    pipe: *FILE
    len: size_t

    if out == nil || out_size <= 0 || codepoint == 0 {
        return 0
    }
    snprintf(command, sizeof(command),
             "fc-match -f '%%{file}\\n' ':charset=%x'", codepoint)
    pipe = popen(command, "r")
    if pipe == nil {
        return 0
    }
    if fgets(line, sizeof(line), pipe) == nil {
        pclose(pipe)
        return 0
    }
    pclose(pipe)
    len = strlen(line)
    while len > 0 && (line[len - 1] == '\n' || line[len - 1] == '\r' ||
                      line[len - 1] == ' ' || line[len - 1] == '\t') {
        line[--len] = '\0'
    }
    if len == 0 || len >= (size_t)out_size || access(line, R_OK) != 0 {
        return 0
    }
    snprintf(out, (size_t)out_size, "%s", line)
    return 1
} #else {
    return 0
}
}

register_terminal_fallback :: (name: *const char,
static_paths: **const char, static_count: i32, match_codepoint: u32,
codepoints: *i32, codepoint_count: i32) {
    tried: [16]*const char
    tried_count: i32 = 0
    matched: [512]char
    i: i32

    i = 0
    while i < static_count && static_paths[i] != nil {
        path: *const char = static_paths[i]

        if path_in_list(tried, tried_count, path) != 0 {
            i += 1
            continue
        }
        if tried_count < (int)(sizeof(tried) / sizeof(tried[0])) {
            tried[tried_count] = path
            tried_count += 1
        }
        if RegisterTextFontFileSource(name, path, codepoints,
                                      codepoint_count) != 0 {
            return
        }
        i += 1
    }
    if fontconfig_match_charset(match_codepoint, matched,
                                (int)sizeof(matched)) != 0 &&
       path_in_list(tried, tried_count, matched) == 0 {
        RegisterTextFontFileSource(name, matched, codepoints,
                                   codepoint_count)
    }
}

sync_window_title :: (app: *State) {
    session: *Session
    title: [160]char

    if app == nil {
        return
    }
    session = active_session(app)
    if session != nil && session_title(session)[0] != '\0' {
        snprintf(title, sizeof(title), "%s", session_title(session))
    } else {
        snprintf(title, sizeof(title), "Terminal")
    }
    if strcmp(app->window_title, title) != 0 {
        SetWindowTitle(title)
        snprintf(app->window_title, sizeof(app->window_title), "%s", title)
    }
}

frame_width :: () -> i32 {
    return GetScreenWidth()
}

frame_height :: () -> i32 {
    return GetScreenHeight()
}

initial_window_width :: (launch: *const LaunchOptions) -> i32 {
    if launch != nil && launch->geometry_cols > 0 {
        return launch->geometry_cols * 10 + 20
    }
    return 980
}

initial_window_height :: (launch: *const LaunchOptions) -> i32 {
    if launch != nil && launch->drop_down {
        return 420
    }
    if launch != nil && launch->geometry_rows > 0 {
        return launch->geometry_rows * 20 + 78
    }
    return 660
}

set_launch_window_flags :: (launch: *const LaunchOptions) {
    flags: u32 = FLAG_WINDOW_RESIZABLE

    if launch != nil && launch->drop_down {
        flags |= FLAG_WINDOW_UNDECORATED | FLAG_WINDOW_TOPMOST |
                 FLAG_WINDOW_ALWAYS_RUN
    } else if launch != nil && !launch->show_borders {
        flags |= FLAG_WINDOW_UNDECORATED
    }
    SetConfigFlags(flags)
}

apply_launch_window_state :: (launch: *const LaunchOptions) {
    monitor: i32
    monitor_w: i32
    monitor_h: i32
    width: i32
    height: i32
    pos: Vector2

    if launch == nil {
        return
    }
    if launch->drop_down {
        monitor = GetCurrentMonitor()
        monitor_w = GetMonitorWidth(monitor)
        monitor_h = GetMonitorHeight(monitor)
        pos = GetMonitorPosition(monitor)
        width = monitor_w > 0 ? monitor_w : GetScreenWidth()
        height = monitor_h > 0 ? monitor_h * 45 / 100 : 420
        if height < 280 {
            height = 280
        }
        if height > 720 {
            height = 720
        }
        SetWindowState(FLAG_WINDOW_TOPMOST)
        SetWindowSize(width, height)
        SetWindowPosition((int)pos.x, (int)pos.y)
        return
    }
    if launch->maximize {
        MaximizeWindow()
    }
    if launch->fullscreen {
        ToggleFullscreen()
    }
}

target_fps :: () -> i32 {
    value: const char* = getenv("KTREM_TARGET_FPS")
    end: *char = nil
    fps: long

    if value == nil || value[0] == '\0' {
#if PLAN9_BUILD {
        return 30
} #else {
        return 60
}
    }
    fps = strtol(value, &end, 10)
    if end == value || fps < 0 || fps > 1000 {
        return 60
    }
    return (int)fps
}

active_target_fps :: (idle_fps: i32) -> i32 {
    value: const char* = getenv("KTREM_ACTIVE_FPS")
    end: *char = nil
    fps: long

    if value == nil || value[0] == '\0' {
#if PLAN9_BUILD {
        return idle_fps < 60 ? 60 : idle_fps
} #else {
        return idle_fps < 1000 ? 1000 : idle_fps
}
    }
    fps = strtol(value, &end, 10)
    if end == value || fps < 0 || fps > 1000 {
#if PLAN9_BUILD {
        return idle_fps < 60 ? 60 : idle_fps
} #else {
        return idle_fps < 1000 ? 1000 : idle_fps
}
    }
    if fps > 0 && fps < idle_fps {
        return idle_fps
    }
    return (int)fps
}

pty_burst_ms :: () -> i32 {
    value: const char* = getenv("KTREM_PTY_BURST_MS")
    end: *char = nil
    ms: long

    if value == nil || value[0] == '\0' {
#if PLAN9_BUILD {
        return 0
} #else {
        return 8
}
    }
    ms = strtol(value, &end, 10)
    if end == value || ms < 0 || ms > 20 {
#if PLAN9_BUILD {
        return 0
} #else {
        return 8
}
    }
    return (int)ms
}

drain_terminal_output :: (session: *Session, burst_ms: i32) -> i32 {
    bytes: i32
    empty_polls: i32 = 0
    deadline: f64

    if session == nil {
        return 0
    }
    bytes = terminal_poll_bytes(&session->terminal)
    if bytes <= 0 || burst_ms <= 0 {
        return bytes
    }
    deadline = GetTime() + (double)burst_ms / 1000.0
    while GetTime() < deadline {
        more: i32 = terminal_poll_bytes(&session->terminal)

        if more > 0 {
            bytes += more
            empty_polls = 0
            continue
        }
        empty_polls += 1
        if empty_polls >= 2 {
            break
        }
        usleep(250)
    }
    return bytes
}

app_interaction_active :: (app: *const State) -> i32 {
    if app == nil {
        return 0
    }
    if app->search_visible || app->context_menu_open ||
       app->rename_index >= 0 || app->about_visible ||
       app->profile_prompt != PROFILE_PROMPT_NONE {
        return 1
    }
    if IsKeyDown(KEY_LEFT_CONTROL) || IsKeyDown(KEY_RIGHT_CONTROL) ||
       IsKeyDown(KEY_LEFT_SHIFT) || IsKeyDown(KEY_RIGHT_SHIFT) ||
       IsKeyDown(KEY_LEFT_ALT) || IsKeyDown(KEY_RIGHT_ALT) {
        return 1
    }
    if IsMouseButtonDown(MOUSE_BUTTON_LEFT) ||
       IsMouseButtonDown(MOUSE_BUTTON_MIDDLE) ||
       IsMouseButtonDown(MOUSE_BUTTON_RIGHT) {
        return 1
    }
    return 0
}

refresh_app_theme :: (app: *State) {
    old_colors: TerminalProfileColors

    if app == nil {
        return
    }
    old_colors = terminal_profile_colors(&app->config, &app->palette)
    palette_default(&app->palette)
    palette_apply_system_theme(&app->palette)
    sync_terminal_theme_defaults(app, old_colors)
}

load_kryon_font :: (config: *const Config) {
    cjk_paths: [3]const char* = {
        "/usr/share/fonts/truetype/fonts-ukij-uyghur/UKIJCJK.ttf",
        "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
        nil
    }
    symbol_paths: [5]const char* = {
        "/usr/share/fonts/truetype/noto/NotoSansSymbols2-Regular.ttf",
        "/usr/share/fonts/truetype/noto/NotoSansSymbols-Regular.ttf",
        "/usr/share/fonts/opentype/urw-base35/StandardSymbolsPS.otf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        nil
    }
    emoji_paths: [3]const char* = {
        "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        nil
    }
    ui_paths: [4]const char* = {
        "../kryon/fonts/noto/NotoSans-Regular.ttf",
        "fonts/noto/NotoSans-Regular.ttf",
        "vendor/kryon/fonts/noto/NotoSans-Regular.ttf",
        nil
    }
    terminal_paths: [5]const char* = {
        "/usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        "/usr/share/fonts/opentype/urw-base35/NimbusMonoPS-Regular.otf",
        "../kryon/fonts/noto/NotoSans-Regular.ttf",
        nil
    }
    codepoint_count: i32 = 0
    codepoints: *i32 = terminal_codepoints(&codepoint_count)
    cjk_codepoint_count: i32 = 0
    cjk_codepoints: *i32 = terminal_cjk_codepoints(&cjk_codepoint_count)
    i: i32
    ui_loaded: i32 = 0
    configured: i32 = 0

    i = 0
    while ui_paths[i] != nil {
        if RegisterTextFontFileSource("t9-ui", ui_paths[i], nil, 0) != 0 &&
           UseTextFont("t9-ui") != 0 {
            ui_loaded = 1
            break
        }
        i += 1
    }
    if ui_loaded == 0 {
        EnsureDefaultFont()
    }
    if config != nil && config->terminal_font[0] != '\0' &&
       RegisterTextFontFileSource("t9-terminal", config->terminal_font,
                                  codepoints, codepoint_count) != 0 {
        configured = 1
    }
    if configured == 0 {
        i = 0
        while terminal_paths[i] != nil {
            if RegisterTextFontFileSource("t9-terminal",
                                          terminal_paths[i], codepoints,
                                          codepoint_count) != 0 {
                break
            }
            i += 1
        }
    }
    register_terminal_fallback("t9-terminal-cjk", cjk_paths,
                               (int)(sizeof(cjk_paths) / sizeof(cjk_paths[0])),
                               0x6e2c, cjk_codepoints,
                               cjk_codepoint_count)
    register_terminal_fallback(
        "t9-terminal-symbols", symbol_paths,
        (int)(sizeof(symbol_paths) / sizeof(symbol_paths[0])), 0x2800,
        codepoints, codepoint_count)
    register_terminal_fallback(
        "t9-terminal-emoji", emoji_paths,
        (int)(sizeof(emoji_paths) / sizeof(emoji_paths[0])), 0x1f600,
        codepoints, codepoint_count)
    UseTextFont("t9-terminal")
    free(cjk_codepoints)
    free(codepoints)
}

t9_main :: (argc: i32, argv: **char) -> i32 #export {
    app: State
    i: i32
    idle_fps: i32
    busy_fps: i32
    burst_ms: i32
    fast_poll_until: f64 = 0.0
    arg_error: [256]char
    parse_result: LaunchParseResult

    memset(&app, 0, sizeof(app))
    app.top_menu_index = -1
    app.rename_index = -1
    app.mouse_report_col = -1
    app.mouse_report_row = -1
    app.mouse_report_x = -1
    app.mouse_report_y = -1
    app.mouse_report_button = TERMINAL_MOUSE_RELEASE
    app.selection_click_row = -1
    app.selection_click_col = -1
    config_defaults(&app.config)
    launch_options_defaults(&app.launch)
    config_load(&app.config)
    parse_result = launch_options_parse(&app.launch, &app.config, argc,
                                        argv, arg_error,
                                        (int)sizeof(arg_error))
    if parse_result == LAUNCH_PARSE_HELP {
        launch_options_print_usage()
        return 0
    }
    if parse_result == LAUNCH_PARSE_VERSION {
        launch_options_print_version()
        return 0
    }
    if parse_result == LAUNCH_PARSE_COLOR_TABLE {
        launch_options_print_color_table()
        return 0
    }
    if parse_result == LAUNCH_PARSE_ERROR {
        fprintf(stderr, "%s\n", arg_error[0] != '\0' ? arg_error :
                "invalid launch options")
        return 2
    }
#if PLAN9_BUILD {
    if native_request_rill_terminal() != 0 {
        return 0
    }
    if native_graphics_namespace_ready() == 0 {
        fprintf(stderr,
                "t9: no Plan 9 graphics namespace; open Terminal from Rill\n")
        return 1
    }
}
    SetTraceLogLevel(LOG_WARNING)
    set_launch_window_flags(&app.launch)
    InitWindow(initial_window_width(&app.launch),
               initial_window_height(&app.launch), "Terminal")
    SetExitKey(KEY_NULL)
    if !IsWindowReady() || GetFontDefault().texture.id == 0 {
        fprintf(stderr, "t9: graphics backend failed to initialize\n")
        return 1
    }
    apply_launch_window_state(&app.launch)
    snprintf(app.window_title, sizeof(app.window_title), "Terminal")
    InitInterface(frame_width(), frame_height(), 1.0f)
    app.window_focused = IsWindowFocused() ? 1 : 0
    load_kryon_font(&app.config)
    refresh_app_theme(&app)
    app.next_theme_refresh = GetTime() + 2.0
    idle_fps = target_fps()
    busy_fps = active_target_fps(idle_fps)
    burst_ms = pty_burst_ms()
    SetTargetFPS(idle_fps)
    i = 0
    while i < MAX_SESSIONS {
        session_init(&app.sessions[i])
        i += 1
    }
    if open_launch_sessions(&app) == 0 {
        restore_sessions(&app)
    }
    BeginDrawing()
    ClearBackground(app.palette.background)
    BeginInterfaceFrame(frame_width(), frame_height(), 1.0f)
    draw_starting_frame(&app)
    EndInterfaceFrame()
    EndDrawing()

    while !WindowShouldClose() && !app.quit_requested {
        session: *Session = active_session(&app)
        poll_index: i32 = 0
        bytes: i32 = 0

        if session == nil && app.session_count == 0 {
            open_session(&app, nil)
            session = active_session(&app)
        }
        if session != nil {
            sync_host_clipboard_to_terminal(session)
        }
        while poll_index < app.session_count {
            tab: *Session = &app.sessions[poll_index]

            bytes += drain_terminal_output(
                tab, poll_index == app.active ? burst_ms : 0)
            session_sync_terminal_metadata_with_mode(
                tab, app.config.dynamic_title_mode)
            if !tab->terminal.running && !app.launch.hold {
                close_exited_session(&app, poll_index)
                continue
            }
            poll_index += 1
        }
        session = active_session(&app)
        if bytes > 0 {
            fast_poll_until = GetTime() + 0.25
        }
        SetTargetFPS(GetTime() < fast_poll_until ? busy_fps : idle_fps)
        if session != nil {
            if terminal_consume_bell(&session->terminal) {
                app.bell_until = GetTime() + 0.18
            }
        }
        sync_window_title(&app)
        if session != nil {
            focused: i32 = IsWindowFocused() ? 1 : 0

            if focused != app.window_focused {
                terminal_send_focus(&session->terminal, focused)
                app.window_focused = focused
            }
        }
        if session != nil {
            flush_terminal_clipboard_to_host(session)
        }
        if GetTime() >= app.next_theme_refresh {
            refresh_app_theme(&app)
            app.next_theme_refresh = GetTime() + 2.0
        }
        BeginDrawing()
        ClearBackground(app.palette.background)
        BeginInterfaceFrame(frame_width(), frame_height(), 1.0f)
        app_update_auto_hide_mouse(&app)
        if session != nil {
            draw_terminal_view(&app, session,
                               (Rectangle){0, 0, (float)frame_width(),
                                           (float)frame_height()})
            app_handle_input(&app)
            if app_interaction_active(&app) {
                fast_poll_until = GetTime() + 0.25
            }
        } else {
            draw_starting_frame(&app)
        }
        EndInterfaceFrame()
        EndDrawing()
    }

    save_sessions(&app)
    i = 0
    while i < app.session_count {
        session_close(&app.sessions[i])
        i += 1
    }
    release_terminal_view_resources(&app)
    if app.mouse_hidden {
        ShowCursor()
    }
    CloseWindow()
    return 0
}
