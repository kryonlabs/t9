#module "app_ktrem_host"
#inspect off
#import "app_clipboard.h"
#import <app_input.h>
#import <app_profile.h>
#import "app_sessions.h"
#import "app_state.h"
#import <app_terminal_view.h>
#import "config.h"
#import "palette.h"
#import "session.h"
#import "terminal.h"
#import "kryon.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"
#import "unistd.h"

# Angle imports above dodge the generated same-name module headers in
# generated/src/app/ (app_input.kry, app_profile.kry,
# app_terminal_view.kry) so the real src/ headers are used.

KtremHost :: struct {
    host: AppHost
    app: State
    screen: AppScreenInfo
    focused: i32
    width: i32
    height: i32
    initialized: i32
    burst_ms: i32
    fast_poll_until: f64
}

target_fps :: () -> i32 {
    value: const char* = getenv("KTREM_TARGET_FPS")
    end: *char = nil
    fps: long

    if value == nil || value[0] == '\0' {
        return 60
    }
    fps = strtol(value, &end, 10)
    if end == value || fps < 0 || fps > 1000 {
        return 60
    }
    return (int)fps
}

pty_burst_ms :: () -> i32 {
    value: const char* = getenv("KTREM_PTY_BURST_MS")
    end: *char = nil
    ms: long

    if value == nil || value[0] == '\0' {
        return 8
    }
    ms = strtol(value, &end, 10)
    if end == value || ms < 0 || ms > 20 {
        return 8
    }
    return (int)ms
}

drain_terminal_output :: (session: *Session, burst_ms: i32) -> i32 {
    bytes: i32
    empty_polls: i32 = 0
    deadline: f64

    if session == nil {
        return 0
    }
    bytes = terminal_poll_bytes(&session->terminal)
    if bytes <= 0 || burst_ms <= 0 {
        return bytes
    }
    deadline = GetTime() + (double)burst_ms / 1000.0
    while GetTime() < deadline {
        more: i32 = terminal_poll_bytes(&session->terminal)

        if more > 0 {
            bytes += more
            empty_polls = 0
            continue
        }
        empty_polls += 1
        if empty_polls >= 2 {
            break
        }
        usleep(250)
    }
    return bytes
}

app_interaction_active :: (app: *const State) -> i32 {
    if app == nil {
        return 0
    }
    if app->search_visible || app->context_menu_open ||
       app->rename_index >= 0 || app->about_visible ||
       app->profile_prompt != PROFILE_PROMPT_NONE {
        return 1
    }
    if IsKeyDown(KEY_LEFT_CONTROL) || IsKeyDown(KEY_RIGHT_CONTROL) ||
       IsKeyDown(KEY_LEFT_SHIFT) || IsKeyDown(KEY_RIGHT_SHIFT) ||
       IsKeyDown(KEY_LEFT_ALT) || IsKeyDown(KEY_RIGHT_ALT) {
        return 1
    }
    if IsMouseButtonDown(MOUSE_BUTTON_LEFT) ||
       IsMouseButtonDown(MOUSE_BUTTON_MIDDLE) ||
       IsMouseButtonDown(MOUSE_BUTTON_RIGHT) {
        return 1
    }
    return 0
}

refresh_app_theme :: (app: *State) {
    old_colors: TerminalProfileColors

    if app == nil {
        return
    }
    old_colors = terminal_profile_colors(&app->config, &app->palette)
    palette_default(&app->palette)
    palette_apply_system_theme(&app->palette)
    sync_terminal_theme_defaults(app, old_colors)
}

load_kryon_font :: (config: *const Config) {
    ui_paths: [5]const char* = {
        KTREM_KRYON_FONT_PATH,
        "../kryon/fonts/noto/NotoSans-Regular.ttf",
        "fonts/noto/NotoSans-Regular.ttf",
        "vendor/kryon/fonts/noto/NotoSans-Regular.ttf",
        nil
    }
    terminal_paths: [5]const char* = {
        "/usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        "/usr/share/fonts/opentype/urw-base35/NimbusMonoPS-Regular.otf",
        "../kryon/fonts/noto/NotoSans-Regular.ttf",
        nil
    }
    i: i32
    ui_loaded: i32 = 0
    configured: i32 = 0

    i = 0
    while ui_paths[i] != nil {
        if RegisterTextFontFileSource("t9-ui", ui_paths[i], nil, 0) != 0 &&
           UseTextFont("t9-ui") != 0 {
            ui_loaded = 1
            break
        }
        i += 1
    }
    if ui_loaded == 0 {
        EnsureDefaultFont()
    }
    if config != nil && config->terminal_font[0] != '\0' &&
       RegisterTextFontFileSource("t9-terminal", config->terminal_font,
                                  nil, 0) != 0 {
        configured = 1
    }
    if configured == 0 {
        i = 0
        while terminal_paths[i] != nil {
            if RegisterTextFontFileSource("t9-terminal", terminal_paths[i],
                                          nil, 0) != 0 {
                break
            }
            i += 1
        }
    }
    UseTextFont("t9-terminal")
}

ktrem_state_init :: (host: *KtremHost) {
    app: *State = &host->app
    i: i32 = 0

    memset(app, 0, sizeof(*app))
    app->top_menu_index = -1
    app->rename_index = -1
    app->mouse_report_col = -1
    app->mouse_report_row = -1
    app->mouse_report_x = -1
    app->mouse_report_y = -1
    app->mouse_report_button = TERMINAL_MOUSE_RELEASE
    app->selection_click_row = -1
    app->selection_click_col = -1
    config_defaults(&app->config)
    launch_options_defaults(&app->launch)
    config_load(&app->config)
    app->config.command[0] = '\0'
    snprintf(app->window_title, sizeof(app->window_title), "Terminal")
    app->window_focused = 0
    load_kryon_font(&app->config)
    refresh_app_theme(app)
    app->next_theme_refresh = GetTime() + 2.0
    host->burst_ms = pty_burst_ms()
    SetTargetFPS(target_fps())
    while i < MAX_SESSIONS {
        session_init(&app->sessions[i])
        i += 1
    }
    if open_launch_sessions(app) == 0 {
        open_session(app, nil)
    }
    host->initialized = 1
}

ktrem_screen_count :: (userdata: *void) -> i32 #export {
    return 1
}

ktrem_screen :: (userdata: *void, index: i32) -> AppScreenInfo #export {
    host: *KtremHost = userdata
    empty: AppScreenInfo = {0}

    if host == nil || index != 0 {
        return empty
    }
    return host->screen
}

ktrem_select_screen :: (userdata: *void, index: i32) #export {
}

ktrem_select_source_path :: (
userdata: *void, source_path: const char*) -> i32 #export {
    return 0
}

ktrem_resize :: (userdata: *void, width: i32, height: i32) #export {
    host: *KtremHost = userdata

    if host == nil {
        return
    }
    host->width = width
    host->height = height
}

ktrem_set_focused :: (userdata: *void, focused: i32) #export {
    host: *KtremHost = userdata
    session: *Session

    if host == nil {
        return
    }
    if host->initialized == 0 {
        ktrem_state_init(host)
    }
    if host->focused == (focused != 0) {
        return
    }
    host->focused = focused != 0
    host->app.window_focused = host->focused
    session = active_session(&host->app)
    if session != nil {
        terminal_send_focus(&session->terminal, host->focused)
    }
}

ktrem_opaque_draw_rectangle_rec :: (rect: Rectangle, color: Color) {
    color.a = 255
    DrawRectangleRec(rect, color)
}

ktrem_draw :: (userdata: *void, viewport: Rectangle) #export {
    host: *KtremHost = userdata
    app: *State
    session: *Session
    index: i32 = 0
    bytes: i32 = 0

    if host == nil {
        return
    }
    if host->initialized == 0 {
        ktrem_state_init(host)
    }
    app = &host->app
    if app->session_count == 0 && !app->quit_requested {
        open_session(app, nil)
    }
    session = active_session(app)
    if session != nil {
        sync_host_clipboard_to_terminal(session)
    }
    while index < app->session_count {
        tab: *Session = &app->sessions[index]

        bytes += drain_terminal_output(
            tab, index == app->active ? host->burst_ms : 0)
        session_sync_terminal_metadata_with_mode(
            tab, app->config.dynamic_title_mode)
        if !tab->terminal.running && !app->launch.hold {
            close_exited_session(app, index)
            continue
        }
        index += 1
    }
    if bytes > 0 {
        host->fast_poll_until = GetTime() + 0.25
    }
    session = active_session(app)
    if session != nil {
        if terminal_consume_bell(&session->terminal) {
            app->bell_until = GetTime() + 0.18
        }
        flush_terminal_clipboard_to_host(session)
    }
    if GetTime() >= app->next_theme_refresh {
        refresh_app_theme(app)
        app->next_theme_refresh = GetTime() + 2.0
    }
    ktrem_opaque_draw_rectangle_rec(viewport, app->palette.background)
    app_update_auto_hide_mouse(app)
    if session != nil {
        BeginScissorMode((int)viewport.x, (int)viewport.y,
                         (int)viewport.width, (int)viewport.height)
        draw_terminal_view(app, session, viewport)
        if host->focused {
            app_handle_input(app)
            if app_interaction_active(app) {
                host->fast_poll_until = GetTime() + 0.25
            }
        }
        EndScissorMode()
    } else {
        draw_starting_frame(app)
    }
}

CreateAppHost :: (abi_version: i32,
project_path: const char*) -> *AppHost #export {
    host: *KtremHost

    if abi_version != APP_HOST_ABI_VERSION {
        return nil
    }
    host = (KtremHost *)calloc(1, sizeof(KtremHost))
    if host == nil {
        return nil
    }
    host->screen.id = "terminal"
    host->screen.group = "Applications"
    host->screen.title = "Terminal"
    host->host.userdata = host
    host->host.screen_count = ktrem_screen_count
    host->host.screen = ktrem_screen
    host->host.select_screen = ktrem_select_screen
    host->host.select_source_path = ktrem_select_source_path
    host->host.draw = ktrem_draw
    host->host.resize = ktrem_resize
    host->host.set_focused = ktrem_set_focused
    return &host->host
}

DestroyAppHost :: (app_host: *AppHost) #export {
    host: *KtremHost = (KtremHost *)app_host
    i: i32 = 0

    if host == nil {
        return
    }
    if host->initialized != 0 {
        save_sessions(&host->app)
        while i < host->app.session_count {
            session_close(&host->app.sessions[i])
            i += 1
        }
        release_terminal_view_resources(&host->app)
        if host->app.mouse_hidden {
            ShowCursor()
        }
    }
    free(host)
}
