#module "app_profile"
#inspect off
#import "profile.h"
#import "terminal_pane.h"

profile_color_to_terminal_rgb :: (color: Color) -> i32 #export {
    return TerminalPaneColorToRGB(color)
}

terminal_profile_theme :: (
palette: *const Palette) -> TerminalPaneColors {
    if palette == nil {
        return ResolveTerminalPaneThemeColors(
        GetTerminalPaneThemeColors())
    }
    colors: TerminalPaneColors = (TerminalPaneColors){
        palette->terminal_background,
        palette->foreground,
        palette->muted,
        palette->selection,
        palette->selection_text,
        palette->cursor,
        palette->link,
        palette->chrome_border,
        palette->scroll_indicator,
        palette->scroll_indicator_text,
        palette->bell_overlay,
        palette->bell_border
    }
    return ResolveTerminalPaneThemeColors(colors)
}

terminal_profile_configured :: (
config: *const Config) -> TerminalPaneProfileColors {
    colors: TerminalPaneProfileColors =
    (TerminalPaneProfileColors){
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT
    }
    if config == nil { return colors }
    colors.foreground = config->terminal_foreground
    colors.background = config->terminal_background
    colors.cursor = config->terminal_cursor
    colors.selection_foreground =
    config->terminal_selection_foreground
    colors.selection_background =
    config->terminal_selection_background
    return colors
}

terminal_profile_state :: (
terminal: *const TerminalState) -> TerminalPaneProfileState {
    profile: TerminalPaneProfileState = (TerminalPaneProfileState){
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT,
        COLOR_DEFAULT
    }
    if terminal == nil { return profile }
    profile.base_foreground = terminal->base_fg
    profile.base_background = terminal->base_bg
    profile.base_cursor = terminal->base_cursor_color
    profile.base_selection_foreground = terminal->base_selection_fg
    profile.base_selection_background = terminal->base_selection_bg
    profile.foreground = terminal->default_fg
    profile.background = terminal->default_bg
    profile.cursor = terminal->cursor_color
    profile.selection_foreground = terminal->selection_fg
    profile.selection_background = terminal->selection_bg
    return profile
}

terminal_apply_profile_state :: (terminal: *TerminalState,
state: TerminalPaneProfileState) {
    if terminal == nil { return }
    terminal->base_fg = state.base_foreground
    terminal->base_bg = state.base_background
    terminal->base_cursor_color = state.base_cursor
    terminal->base_selection_fg = state.base_selection_foreground
    terminal->base_selection_bg = state.base_selection_background
    terminal->default_fg = state.foreground
    terminal->default_bg = state.background
    terminal->cursor_color = state.cursor
    terminal->selection_fg = state.selection_foreground
    terminal->selection_bg = state.selection_background
}

terminal_profile_colors :: (config: *const Config,
palette: *const Palette) -> TerminalProfileColors #export {
    return ResolveTerminalPaneProfileColors(
    terminal_profile_configured(config),
    terminal_profile_theme(palette))
}

terminal_profile_apply_new :: (config: *const Config,
palette: *const Palette, terminal: *TerminalState) #export {
    if terminal == nil { return }
    profile: TerminalPaneProfileState = terminal_profile_state(
    terminal)
    TerminalPaneProfileStateApplyNew(&profile,
    terminal_profile_colors(config, palette))
    terminal_apply_profile_state(terminal, profile)
}

terminal_profile_seed_missing :: (config: *const Config,
palette: *const Palette, terminal: *TerminalState) #export {
    if terminal == nil { return }
    profile: TerminalPaneProfileState = terminal_profile_state(
    terminal)
    TerminalPaneProfileStateSeedMissing(&profile,
    terminal_profile_colors(config, palette))
    terminal_apply_profile_state(terminal, profile)
}

terminal_profile_sync_changed :: (terminal: *TerminalState,
old_colors: TerminalProfileColors,
new_colors: TerminalProfileColors) #export {
    if terminal == nil { return }
    profile: TerminalPaneProfileState = terminal_profile_state(
    terminal)
    TerminalPaneProfileStateSyncChanged(&profile, old_colors,
    new_colors)
    terminal_apply_profile_state(terminal, profile)
}
