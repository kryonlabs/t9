#module "app_input"
#inspect off
#import "app_state.h"
#import "app_clipboard.h"
#import "app_commands.h"
#import "terminal_pane.h"
#import "app_sessions.h"
#import "input.h"
#import "selection.h"
#import "terminal.h"
#import "string.h"

keyboard_state :: TerminalPaneInputState #global

InputTarget :: struct {
    terminal: *TerminalState
    key_filter: InputKeyFilter
    filter: InputWriteFilter
    userdata: *void
}

input_key_mode :: (
terminal: *const TerminalState) -> TerminalPaneKeyMode {
    mode: TerminalPaneKeyMode = (TerminalPaneKeyMode){0}

    if terminal == nil { return mode }
    mode.application_cursor_keys = terminal->application_cursor_keys
    mode.application_keypad = terminal->application_keypad
    mode.modify_other_keys = terminal->modify_other_keys
    return mode
}

input_write_terminal :: (userdata: *void, text: const char*,
length: i32) -> i32 #export {
    target: *InputTarget = (InputTarget *)userdata

    if target == nil || target->terminal == nil || text == nil ||
    length <= 0 {
        return 0
    }
    if target->filter != nil &&
    target->filter(target->userdata, text, length) != 0 {
        return 1
    }
    return terminal_write(target->terminal, text, length)
}

input_filter_key :: (userdata: *void, platform_key: i32,
mods: i32) -> i32 #export {
    target: *InputTarget = (InputTarget *)userdata

    if target == nil || target->key_filter == nil { return 0 }
    return target->key_filter(target->userdata, platform_key,
    mods)
}

input_target :: (target: *InputTarget) -> TerminalPaneInput {
    terminal: *TerminalState = target != nil
    ? target->terminal : nil

    return MakeTerminalPaneInput(input_key_mode(terminal),
    input_write_terminal, target, &keyboard_state)
}

input_mods :: () -> i32 #export {
    return GetTerminalPaneInputModifiers()
}

input_send_control_key :: (terminal: *TerminalState, key: i32,
mods: i32) -> i32 #export {
    if terminal == nil { return 0 }
    {
        target: InputTarget = {terminal, nil, nil, nil}

        return SendTerminalPaneControlInput(input_target(&target),
        key, mods)
    }
}

input_send_keyboard :: (terminal: *TerminalState) #export {
    input_send_keyboard_filtered(terminal, nil, nil, nil)
}

input_send_keyboard_filtered :: (terminal: *TerminalState,
key_filter: InputKeyFilter, filter: InputWriteFilter,
userdata: *void) #export {
    if terminal == nil { return }
    {
        target: InputTarget = {terminal, key_filter, filter,
        userdata}

        PumpTerminalPaneKeyboardInputFiltered(
        input_target(&target), input_filter_key, &target)
    }
}

max_int :: (a: i32, b: i32) -> i32 {
    return a > b ? a : b
}

clamp_int :: (value: i32, low: i32, high: i32) -> i32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

layout_key_matches :: (platform_key: i32, codepoint: i32) -> i32 {
    return GetLayoutKeyCodepoint(platform_key) == codepoint
}

any_key_pressed :: () -> i32 {
    key: i32

    key = KEY_SPACE
    while key <= KEY_KB_MENU {
        if IsKeyPressed(key) != 0 { return 1 }
        key += 1
    }
    return 0
}

app_update_auto_hide_mouse :: (app: *State) #export {
    mouse: Vector2
    mouse_x: i32
    mouse_y: i32

    if app == nil { return }
    mouse = GetMousePosition()
    mouse_x = (int)mouse.x
    mouse_y = (int)mouse.y
    if app->config.auto_hide_mouse == 0 || IsWindowFocused() == 0 {
        if app->mouse_hidden != 0 { ShowCursor() }
        app->mouse_hidden = 0
        app->last_mouse_x = mouse_x
        app->last_mouse_y = mouse_y
        return
    }
    if mouse_x != app->last_mouse_x || mouse_y != app->last_mouse_y ||
    IsMouseButtonPressed(MOUSE_BUTTON_LEFT) != 0 ||
    IsMouseButtonPressed(MOUSE_BUTTON_MIDDLE) != 0 ||
    IsMouseButtonPressed(MOUSE_BUTTON_RIGHT) != 0 {
        if app->mouse_hidden != 0 { ShowCursor() }
        app->mouse_hidden = 0
    } else if any_key_pressed() != 0 && CheckCollisionPointRec(mouse,
    app->viewport) {
        if app->mouse_hidden == 0 { HideCursor() }
        app->mouse_hidden = 1
    }
    app->last_mouse_x = mouse_x
    app->last_mouse_y = mouse_y
}

visible_row_from_mouse :: (app: *const State, mouse: Vector2) -> i32 {
    row: i32

    if app == nil || CheckCollisionPointRec(mouse, app->viewport) == 0 {
        return -1
    }
    row = (int)((mouse.y - app->viewport.y) / (float)app->line_h)
    if row < 0 || row >= app->visible_rows { return -1 }
    return app->first_visible_row + row
}

visible_col_from_mouse :: (app: *const State, mouse: Vector2) -> i32 {
    col: i32

    if app == nil || CheckCollisionPointRec(mouse, app->viewport) == 0 {
        return -1
    }
    col = (int)((mouse.x - app->viewport.x) / (float)app->cell_w)
    return max_int(0, col)
}

viewport_row_from_mouse :: (app: *const State, mouse: Vector2) -> i32 {
    row: i32

    if app == nil || CheckCollisionPointRec(mouse, app->viewport) == 0 {
        return -1
    }
    row = (int)((mouse.y - app->viewport.y) / (float)app->line_h)
    if row < 0 || row >= app->visible_rows { return -1 }
    return row
}

viewport_col_from_mouse :: (app: *const State,
terminal: *const TerminalState, mouse: Vector2) -> i32 {
    col: i32

    if app == nil || terminal == nil ||
    CheckCollisionPointRec(mouse, app->viewport) == 0 {
        return -1
    }
    col = (int)((mouse.x - app->viewport.x) / (float)app->cell_w)
    return clamp_int(col, 0, max_int(0, terminal->cols - 1))
}

open_hyperlink_at_mouse :: (app: *State, session: *Session) -> i32 {
    mouse: Vector2 = GetMousePosition()
    viewport_row: i32
    visible_row: i32
    col: i32
    cell: *const Cell
    url: const char*

    if app == nil || session == nil ||
    CheckCollisionPointRec(mouse, app->viewport) == 0 {
        return 0
    }
    viewport_row = viewport_row_from_mouse(app, mouse)
    col = viewport_col_from_mouse(app, &session->terminal, mouse)
    if viewport_row < 0 || col < 0 { return 0 }
    visible_row = app->first_visible_row + viewport_row
    cell = terminal_visible_cell(&session->terminal, col, visible_row)
    if cell == nil || cell->hyperlink <= 0 { return 0 }
    url = terminal_hyperlink(&session->terminal, cell->hyperlink)
    if url == nil || url[0] == '\0' { return 0 }
    OpenURL(url)
    return 1
}

handle_selection :: (app: *State, session: *Session) {
    mouse: Vector2 = GetMousePosition()
    row: i32 = visible_row_from_mouse(app, mouse)
    col: i32 = visible_col_from_mouse(app, mouse)

    if app == nil || session == nil { return }
    if row >= 0 && IsMouseButtonPressed(MOUSE_BUTTON_LEFT) != 0 {
        now: f64 = GetTime()

        if row == app->selection_click_row && col == app->selection_click_col &&
        now - app->selection_click_time < 0.45 {
            app->selection_click_count += 1
        } else {
            app->selection_click_count = 1
        }
        app->selection_click_time = now
        app->selection_click_row = row
        app->selection_click_col = col
        if app->selection_click_count >= 3 {
            selection_select_line(&app->selection, &session->terminal, row)
            return
        }
        if app->selection_click_count == 2 {
            selection_select_word(&app->selection, &session->terminal, row,
            col)
            return
        }
        selection_begin_char(&app->selection, row, col)
    }
    if app->selection.dragging != 0 &&
    IsMouseButtonDown(MOUSE_BUTTON_LEFT) != 0 {
        scroll_delta: i32 = selection_edge_scroll_delta(
        mouse.y, app->viewport.y, app->viewport.height, Scale(24))

        if row < 0 || scroll_delta != 0 {
            total: i32 = terminal_visible_line_count(&session->terminal)
            max_scroll: i32 = max_int(0, total - app->visible_rows)
            first_visible_row: i32 = app->first_visible_row

            if scroll_delta != 0 {
                session->scroll_offset = clamp_int(
                session->scroll_offset + scroll_delta, 0, max_scroll)
                first_visible_row = selection_first_visible_row(
                total, app->visible_rows, session->scroll_offset)
                app->first_visible_row = first_visible_row
            }
            row = selection_edge_scroll_row(first_visible_row,
            app->visible_rows, scroll_delta)
            if row < 0 {
                row = mouse.y < app->viewport.y
                ? first_visible_row
                : first_visible_row + app->visible_rows - 1
            }
            col = visible_col_from_mouse(app, (Vector2){
            clamp_int((int)mouse.x, (int)app->viewport.x,
            (int)(app->viewport.x + app->viewport.width - 1)),
            clamp_int((int)mouse.y, (int)app->viewport.y,
            (int)(app->viewport.y + app->viewport.height - 1))
            })
        }
        if row >= 0 {
            selection_update_end(&app->selection, &session->terminal, row,
            col)
        }
    }
    if app->selection.dragging != 0 &&
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0 {
        app->selection.dragging = 0
        update_primary_selection(app)
    }
}

send_mouse_button :: (terminal: *TerminalState, ray_button: i32,
terminal_button: i32, col: i32, row: i32,
pixel_x: i32, pixel_y: i32, mods: i32, app: *State) -> i32 {
    if IsMouseButtonPressed(ray_button) != 0 {
        app->mouse_report_button = terminal_button
        app->mouse_report_col = col
        app->mouse_report_row = row
        app->mouse_report_x = pixel_x
        app->mouse_report_y = pixel_y
        return terminal_send_mouse_pixels(terminal, terminal_button, col, row,
        pixel_x, pixel_y, 1, 0, mods)
    }
    if IsMouseButtonReleased(ray_button) != 0 {
        result: i32 = terminal_send_mouse_pixels(terminal, terminal_button, col,
        row, pixel_x, pixel_y, 0, 0, mods)

        if app->mouse_report_button == terminal_button {
            app->mouse_report_button = TERMINAL_MOUSE_RELEASE
        }
        app->mouse_report_col = col
        app->mouse_report_row = row
        app->mouse_report_x = pixel_x
        app->mouse_report_y = pixel_y
        return result
    }
    return 0
}

handle_terminal_mouse :: (app: *State, session: *Session,
wheel: f32) -> i32 {
    terminal: *TerminalState
    mouse: Vector2
    row: i32
    col: i32
    pixel_x: i32
    pixel_y: i32
    mods: i32
    consumed: i32 = 0
    steps: i32
    i: i32
    shift: i32

    if app == nil || session == nil { return 0 }
    terminal = &session->terminal
    shift = IsKeyDown(KEY_LEFT_SHIFT) != 0 || IsKeyDown(KEY_RIGHT_SHIFT) != 0
    mouse = GetMousePosition()
    if terminal->mouse_mode == 0 || shift != 0 ||
    CheckCollisionPointRec(mouse, app->viewport) == 0 {
        return 0
    }
    row = viewport_row_from_mouse(app, mouse)
    col = viewport_col_from_mouse(app, terminal, mouse)
    if row < 0 || col < 0 { return 0 }
    row = clamp_int(row, 0, max_int(0, terminal->rows - 1))
    pixel_x = clamp_int((int)(mouse.x - app->viewport.x), 0,
    max_int(0, (int)app->viewport.width - 1))
    pixel_y = clamp_int((int)(mouse.y - app->viewport.y), 0,
    max_int(0, (int)app->viewport.height - 1))
    mods = input_mods()

    if wheel != 0.0f {
        button: i32 = wheel > 0.0f ? TERMINAL_MOUSE_WHEEL_UP
        : TERMINAL_MOUSE_WHEEL_DOWN

        steps = wheel > 0.0f ? (int)(wheel + 0.5f) : (int)((-wheel) + 0.5f)
        if steps < 1 { steps = 1 }
        i = 0
        while i < steps {
            if terminal_send_mouse_pixels(terminal, button, col, row, pixel_x,
            pixel_y, 1, 0, mods) != 0 {
                consumed = 1
            }
            i += 1
        }
    }

    if send_mouse_button(terminal, MOUSE_BUTTON_LEFT, TERMINAL_MOUSE_LEFT, col,
    row, pixel_x, pixel_y, mods, app) != 0 {
        consumed = 1
    }
    if send_mouse_button(terminal, MOUSE_BUTTON_MIDDLE, TERMINAL_MOUSE_MIDDLE,
    col, row, pixel_x, pixel_y, mods, app) != 0 {
        consumed = 1
    }
    if send_mouse_button(terminal, MOUSE_BUTTON_RIGHT, TERMINAL_MOUSE_RIGHT,
    col, row, pixel_x, pixel_y, mods, app) != 0 {
        consumed = 1
    }

    if (terminal->mouse_mode == 1002 &&
    app->mouse_report_button != TERMINAL_MOUSE_RELEASE) ||
    terminal->mouse_mode == 1003 {
        if col != app->mouse_report_col || row != app->mouse_report_row ||
        (terminal->mouse_pixels != 0 &&
        (pixel_x != app->mouse_report_x ||
        pixel_y != app->mouse_report_y)) {
            button: i32 = app->mouse_report_button

            if button == TERMINAL_MOUSE_RELEASE {
                button = TERMINAL_MOUSE_RELEASE
            }
            if terminal_send_mouse_pixels(terminal, button, col, row, pixel_x,
            pixel_y, 1, 1, mods) != 0 {
                consumed = 1
            }
            app->mouse_report_col = col
            app->mouse_report_row = row
            app->mouse_report_x = pixel_x
            app->mouse_report_y = pixel_y
        }
    }
    return consumed
}

handle_terminal_keyboard_shortcut :: (userdata: *void,
text: const char*, length: i32) -> i32 #export {
    app: *State = userdata
    shift: i32 = IsKeyDown(KEY_LEFT_SHIFT) != 0 ||
    IsKeyDown(KEY_RIGHT_SHIFT) != 0
    session: *Session

    if app == nil || text == nil { return 0 }
    session = active_session(app)
    if session == nil { return 0 }
    if length == 1 && text[0] == '\x7f' &&
    app->config.backspace_binding == TERMINAL_PANE_KEY_BINDING_CONTROL_H {
        terminal_write(&session->terminal, "\x08", 1)
        return 1
    }
    if length == 4 && memcmp(text, "\x1b[3~", 4) == 0 &&
    app->config.delete_binding == TERMINAL_PANE_KEY_BINDING_ASCII_DELETE {
        terminal_write(&session->terminal, "\x7f", 1)
        return 1
    }
    if (length == 6 && memcmp(text, "\x1b[2;2~", 6) == 0) ||
    (length == 4 && shift != 0 && memcmp(text, "\x1b[2~", 4) == 0) {
        app_execute_command(app, APP_COMMAND_PASTE)
        return 1
    }
    if length == 6 && memcmp(text, "\x1b[2;5~", 6) == 0 {
        app_execute_command(app, APP_COMMAND_COPY)
        return 1
    }
    return 0
}

handle_terminal_key_shortcut :: (userdata: *void, platform_key: i32,
mods: i32) -> i32 #export {
    app: *State = userdata
    ctrl: i32 = (mods & TERMINAL_PANE_MOD_CTRL) != 0
    shift: i32 = (mods & TERMINAL_PANE_MOD_SHIFT) != 0
    alt: i32 = (mods & TERMINAL_PANE_MOD_ALT) != 0

    if app == nil { return 0 }
    if alt != 0 {
        keypad_keys: [MAX_SESSIONS]i32 = {
            KEY_KP_1, KEY_KP_2, KEY_KP_3, KEY_KP_4,
            KEY_KP_5, KEY_KP_6, KEY_KP_7, KEY_KP_8
        }
        i: i32

        i = 0
        while i < app->session_count && i < MAX_SESSIONS {
            if layout_key_matches(platform_key, '1' + i) != 0 ||
            platform_key == keypad_keys[i] {
                set_active_session(app, i)
                return 1
            }
            i += 1
        }
    }
    if ctrl != 0 && shift != 0 && layout_key_matches(platform_key, 't') != 0 {
        app_execute_command(app, APP_COMMAND_NEW_TAB)
        return 1
    }
    if ctrl != 0 && shift != 0 && layout_key_matches(platform_key, 'w') != 0 {
        app_execute_command(app, APP_COMMAND_CLOSE_TAB)
        return 1
    }
    if ctrl != 0 && shift != 0 && platform_key == KEY_TAB {
        app_execute_command(app, APP_COMMAND_PREVIOUS_TAB)
        return 1
    }
    if ctrl != 0 && platform_key == KEY_TAB {
        app_execute_command(app, APP_COMMAND_NEXT_TAB)
        return 1
    }
    if ctrl != 0 && platform_key == KEY_PAGE_UP {
        app_execute_command(app, APP_COMMAND_PREVIOUS_TAB)
        return 1
    }
    if ctrl != 0 && platform_key == KEY_PAGE_DOWN {
        app_execute_command(app, APP_COMMAND_NEXT_TAB)
        return 1
    }
    if ctrl != 0 && (platform_key == KEY_EQUAL ||
    platform_key == KEY_KP_ADD) {
        app_execute_command(app, APP_COMMAND_FONT_INCREASE)
        return 1
    }
    if ctrl != 0 && (platform_key == KEY_MINUS ||
    platform_key == KEY_KP_SUBTRACT) {
        app_execute_command(app, APP_COMMAND_FONT_DECREASE)
        return 1
    }
    if ctrl != 0 && (platform_key == KEY_ZERO || platform_key == KEY_KP_0) {
        app_execute_command(app, APP_COMMAND_FONT_RESET)
        return 1
    }
    if ctrl != 0 && shift != 0 && layout_key_matches(platform_key, 'a') != 0 {
        app_execute_command(app, APP_COMMAND_SELECT_ALL)
        return 1
    }
    if ctrl != 0 && shift != 0 && layout_key_matches(platform_key, 'f') != 0 {
        app_execute_command(app, APP_COMMAND_FIND)
        return 1
    }
    if ctrl != 0 && shift != 0 && layout_key_matches(platform_key, 'g') != 0 {
        app_execute_command(app, APP_COMMAND_FIND_NEXT)
        return 1
    }
    if ctrl != 0 && shift != 0 && layout_key_matches(platform_key, 'b') != 0 {
        app_execute_command(app, APP_COMMAND_FIND_PREVIOUS)
        return 1
    }
    if ctrl != 0 && shift != 0 && layout_key_matches(platform_key, 'q') != 0 {
        app_execute_command(app, APP_COMMAND_QUIT)
        return 1
    }
    if ctrl != 0 && shift != 0 && layout_key_matches(platform_key, 'v') != 0 {
        app_execute_command(app, APP_COMMAND_PASTE)
        return 1
    }
    if (ctrl != 0 && shift != 0 &&
    layout_key_matches(platform_key, 'c') != 0) ||
    (ctrl != 0 && platform_key == KEY_INSERT) {
        app_execute_command(app, APP_COMMAND_COPY)
        return 1
    }
    return 0
}

handle_down_edge_shortcuts :: (app: *State, ctrl: i32,
shift: i32) -> i32 {
    paste_down: i32
    copy_down: i32
    new_tab_down: i32
    close_tab_down: i32

    if app == nil { return 0 }
    new_tab_down = ctrl != 0 && shift != 0 && IsLayoutKeyDown('t') != 0
    close_tab_down = ctrl != 0 && shift != 0 && IsLayoutKeyDown('w') != 0
    if new_tab_down != 0 {
        if app->new_tab_shortcut_down == 0 {
            app_execute_command(app, APP_COMMAND_NEW_TAB)
        }
        app->new_tab_shortcut_down = 1
        app->close_tab_shortcut_down = close_tab_down
        return 1
    }
    if close_tab_down != 0 {
        if app->close_tab_shortcut_down == 0 {
            app_execute_command(app, APP_COMMAND_CLOSE_TAB)
        }
        app->close_tab_shortcut_down = 1
        app->new_tab_shortcut_down = 0
        return 1
    }
    app->new_tab_shortcut_down = 0
    app->close_tab_shortcut_down = 0
    paste_down = (shift != 0 && IsKeyDown(KEY_INSERT) != 0) ||
    (ctrl != 0 && shift != 0 && IsLayoutKeyDown('v') != 0)
    copy_down = (ctrl != 0 && IsKeyDown(KEY_INSERT) != 0) ||
    (ctrl != 0 && shift != 0 && IsLayoutKeyDown('c') != 0)
    if paste_down != 0 {
        if app->paste_shortcut_down == 0 {
            app_execute_command(app, APP_COMMAND_PASTE)
        }
        app->paste_shortcut_down = 1
        app->copy_shortcut_down = copy_down
        return 1
    }
    if copy_down != 0 {
        if app->copy_shortcut_down == 0 {
            app_execute_command(app, APP_COMMAND_COPY)
        }
        app->copy_shortcut_down = 1
        app->paste_shortcut_down = 0
        return 1
    }
    app->paste_shortcut_down = 0
    app->copy_shortcut_down = 0
    return 0
}

app_handle_input :: (app: *State) #export {
    session: *Session = active_session(app)
    wheel: f32
    ctrl: i32
    shift: i32
    opened_link: i32 = 0

    if session == nil { return }
    # app_profile.h is shadowed by the generated app_profile module
    # header, so use the engine constant it aliases.
    if app->about_visible != 0 || app->rename_index >= 0 ||
    app->search_visible != 0 ||
    app->profile_prompt != TERMINAL_PANE_PROFILE_PROMPT_NONE {
        return
    }
    ctrl = IsKeyDown(KEY_LEFT_CONTROL) != 0 ||
    IsKeyDown(KEY_RIGHT_CONTROL) != 0
    shift = IsKeyDown(KEY_LEFT_SHIFT) != 0 ||
    IsKeyDown(KEY_RIGHT_SHIFT) != 0
    wheel = GetMouseWheelMove()
    if handle_terminal_mouse(app, session, wheel) == 0 {
        if CheckCollisionPointRec(GetMousePosition(), app->viewport) &&
        wheel != 0.0f {
            direction: i32 = wheel > 0.0f ? 1 : -1
            steps: i32 = wheel > 0.0f ? (int)(wheel + 0.5f) :
            (int)((-wheel) + 0.5f)
            consumed: i32 = 0
            i: i32

            if steps < 1 { steps = 1 }
            i = 0
            while i < steps {
                if terminal_send_alternate_scroll(&session->terminal,
                direction, input_mods()) != 0 {
                    consumed = 1
                }
                i += 1
            }
            if consumed != 0 {
                session->scroll_offset = 0
            } else {
                session->scroll_offset += (int)(wheel * 3.0f)
                if session->scroll_offset < 0 {
                    session->scroll_offset = 0
                }
            }
        }
        if session->terminal.mouse_mode == 0 && ctrl != 0 &&
        CheckCollisionPointRec(GetMousePosition(), app->viewport) &&
        IsMouseButtonPressed(MOUSE_BUTTON_LEFT) &&
        open_hyperlink_at_mouse(app, session) != 0 {
            app->selection.active = 0
            session->scroll_offset = 0
            opened_link = 1
        } else if session->terminal.mouse_mode == 0 &&
        CheckCollisionPointRec(GetMousePosition(), app->viewport) &&
        IsMouseButtonPressed(MOUSE_BUTTON_MIDDLE) {
            paste_primary_or_clipboard_to_session(app, session)
        }
        if opened_link == 0 {
            handle_selection(app, session)
        }
    } else {
        app->selection.active = 0
        session->scroll_offset = 0
        app->context_menu_open = 0
    }
    if handle_down_edge_shortcuts(app, ctrl, shift) != 0 { return }
    if app_handle_shortcuts(app) != 0 { return }

    if ctrl != 0 && shift != 0 && (IsLayoutKeyDown('a') != 0 ||
    IsLayoutKeyDown('b') != 0 ||
    IsLayoutKeyDown('c') != 0 || IsLayoutKeyDown('g') != 0 ||
    IsLayoutKeyDown('v') != 0 || IsLayoutKeyDown('t') != 0 ||
    IsLayoutKeyDown('w') != 0 || IsLayoutKeyDown('f') != 0 ||
    IsLayoutKeyDown('q') != 0) {
        return
    }
    if IsWindowFocused() != 0 {
        if IsKeyPressed(KEY_PAGE_UP) != 0 && shift != 0 {
            session->scroll_offset += app->visible_rows
            return
        }
        if IsKeyPressed(KEY_PAGE_DOWN) != 0 && shift != 0 {
            session->scroll_offset -= app->visible_rows
            if session->scroll_offset < 0 {
                session->scroll_offset = 0
            }
            return
        }
        input_send_keyboard_filtered(&session->terminal,
        handle_terminal_key_shortcut,
        handle_terminal_keyboard_shortcut, app)
        if IsKeyPressed(KEY_ENTER) != 0 ||
        IsKeyPressed(KEY_BACKSPACE) != 0 ||
        IsKeyPressed(KEY_TAB) != 0 {
            session->scroll_offset = 0
        }
    }
}
