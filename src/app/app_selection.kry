#module "app_selection"
#inspect off
#import "selection.h"
#import "terminal_pane.h"
#import "limits.h"

app_terminal_line_text :: (userdata: *void, row: i32, out: *char,
out_size: i32) -> i32 #export {
    terminal: *const TerminalState = (const TerminalState *)userdata

    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if terminal == nil || row < 0 { return 0 }
    terminal_visible_line(terminal, row, out, out_size)
    return 1
}

app_terminal_line_wrapped :: (userdata: *void, row: i32) -> i32 #export {
    terminal: *const TerminalState = (const TerminalState *)userdata

    if terminal == nil || row < 0 { return 0 }
    return terminal_visible_line_wrapped(terminal, row)
}

selection_clear :: (selection: *Selection) #export {
    TerminalPaneSelectionClear(selection)
}

selection_set_range :: (selection: *Selection, mode: i32,
dragging: i32, start_row: i32, start_col: i32, end_row: i32,
end_col: i32) #export {
    TerminalPaneSelectionSetRange(selection, mode, dragging,
    start_row, start_col, end_row, end_col)
}

selection_begin_char :: (selection: *Selection, row: i32,
col: i32) #export {
    TerminalPaneSelectionBeginChar(selection, row, col)
}

selection_select_line :: (selection: *Selection,
terminal: *const TerminalState, row: i32) #export {
    TerminalPaneSelectionSelectLine(selection,
    app_terminal_line_text, (void *)terminal, row)
}

selection_select_word :: (selection: *Selection,
terminal: *const TerminalState, row: i32, col: i32) #export {
    TerminalPaneSelectionSelectWord(selection,
    app_terminal_line_text, (void *)terminal, row, col)
}

selection_select_all :: (selection: *Selection,
terminal: *const TerminalState) #export {
    controller: TerminalPaneClipboardController =
    selection_clipboard_controller(selection,
    (TerminalState *)terminal)

    TerminalPaneClipboardPerformCommand(controller,
    TERMINAL_PANE_CLIPBOARD_COMMAND_SELECT_ALL, nil)
}

selection_update_end :: (selection: *Selection,
terminal: *const TerminalState, row: i32, col: i32) #export {
    TerminalPaneSelectionUpdateEnd(selection,
    app_terminal_line_text, (void *)terminal, row, col)
}

selection_contains :: (selection: *const Selection, row: i32,
col: i32) -> i32 #export {
    return TerminalPaneSelectionContains(selection, row, col)
}

selection_collect_text :: (selection: *const Selection,
terminal: *const TerminalState, buffer: *char,
buffer_size: size_t) -> i32 #export {
    if buffer_size > (size_t)INT_MAX {
        buffer_size = (size_t)INT_MAX
    }
    return TerminalPaneSelectionCollectText(
    selection, app_terminal_line_text, app_terminal_line_wrapped,
    (void *)terminal, buffer, (int)buffer_size)
}

selection_clipboard_controller :: (selection: *Selection,
terminal: *TerminalState) -> TerminalPaneClipboardController #export {
    controller: TerminalPaneClipboardController =
    (TerminalPaneClipboardController){0}

    if terminal == nil { return controller }
    return MakeTerminalPaneClipboardController(
    terminal_clipboard(terminal), selection,
    app_terminal_line_text, app_terminal_line_wrapped, terminal,
    terminal_visible_line_count(terminal), terminal->cols, nil)
}

selection_update_primary :: (selection: *const Selection,
terminal: *TerminalState) -> i32 #export {
    return TerminalPaneClipboardPerformCommand(
    selection_clipboard_controller((Selection *)selection,
    terminal),
    TERMINAL_PANE_CLIPBOARD_COMMAND_UPDATE_PRIMARY_SELECTION,
    nil)
}

selection_copy_to_clipboard :: (selection: *const Selection,
terminal: *TerminalState) -> i32 #export {
    return TerminalPaneClipboardPerformCommand(
    selection_clipboard_controller((Selection *)selection,
    terminal),
    TERMINAL_PANE_CLIPBOARD_COMMAND_COPY_SELECTION, nil)
}

selection_edge_scroll_delta :: (mouse_y: float,
viewport_y: float, viewport_height: float,
edge_size: float) -> i32 #export {
    return TerminalPaneSelectionEdgeScrollDelta(mouse_y,
    viewport_y, viewport_height, edge_size)
}

selection_first_visible_row :: (total_rows: i32,
visible_rows: i32, scroll_offset: i32) -> i32 #export {
    return TerminalPaneSelectionFirstVisibleRow(total_rows,
    visible_rows, scroll_offset)
}

selection_edge_scroll_row :: (first_visible_row: i32,
visible_rows: i32, scroll_delta: i32) -> i32 #export {
    return TerminalPaneSelectionEdgeScrollRow(first_visible_row,
    visible_rows, scroll_delta)
}
