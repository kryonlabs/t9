#module "search"
#inspect off
#import "terminal.h"

terminal_search_line_text :: (userdata: *void, row: i32,
out: *char, out_size: i32) -> i32 #export {
    terminal: *const TerminalState = (const TerminalState *)userdata

    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if terminal == nil || row < 0 { return 0 }
    terminal_visible_line(terminal, row, out, out_size)
    return 1
}

terminal_find_visible :: (terminal: *const TerminalState,
needle: const char*, start_row: i32, start_col: i32,
direction: i32, wrap: i32,
out: *TerminalSearchMatch) -> i32 #export {
    if terminal == nil { return 0 }
    return TerminalPaneSearchLines(terminal_search_line_text,
    (void *)terminal, terminal_visible_line_count(terminal),
    needle, start_row, start_col, direction, wrap,
    (TerminalPaneSearchMatch *)out)
}

terminal_search_controller :: (
terminal: *const TerminalState,
selection: *TerminalPaneSelection, visible_rows: i32,
first_visible_row: i32,
scroll_offset: *i32) -> TerminalPaneSearchController #export {
    return MakeTerminalPaneSearchController(
    terminal_search_line_text, (void *)terminal, selection,
    terminal != nil ? terminal_visible_line_count(terminal) : 0,
    visible_rows, first_visible_row, scroll_offset)
}
