#module "keys"
#inspect off
#import "terminal.h"

terminal_key_mode :: (
terminal: *const TerminalState) -> TerminalPaneKeyMode {
    mode: TerminalPaneKeyMode = (TerminalPaneKeyMode){0}

    if terminal == nil { return mode }
    mode.application_cursor_keys = terminal->application_cursor_keys
    mode.application_keypad = terminal->application_keypad
    mode.modify_other_keys = terminal->modify_other_keys
    return mode
}

terminal_write_encoded :: (terminal: *TerminalState,
seq: const char*, len: i32) -> i32 {
    if terminal == nil || seq == nil || len <= 0 { return 0 }
    return terminal_write(terminal, seq, len)
}

terminal_send_codepoint :: (terminal: *TerminalState,
codepoint: u32, mods: i32) -> i32 #export {
    seq: [64]char

    if terminal == nil { return 0 }
    len: i32 = EncodeTerminalPaneCodepoint(seq, (int)sizeof(seq),
    codepoint, mods, terminal_key_mode(terminal))
    return terminal_write_encoded(terminal, seq, len)
}

terminal_send_key :: (terminal: *TerminalState, key: i32,
mods: i32) -> i32 #export {
    seq: [64]char

    if terminal == nil { return 0 }
    len: i32 = EncodeTerminalPaneKey(seq, (int)sizeof(seq), key,
    mods, terminal_key_mode(terminal))
    return terminal_write_encoded(terminal, seq, len)
}

terminal_send_function_key :: (terminal: *TerminalState,
function_index: i32, mods: i32) -> i32 #export {
    if terminal == nil { return 0 }
    mapped: TerminalPaneMappedKey =
    MapTerminalPaneFunctionKey(function_index, mods)
    if mapped.key == 0 { return 0 }
    return terminal_send_key(terminal, mapped.key, mapped.mods)
}

terminal_send_keypad :: (terminal: *TerminalState,
key: char) -> i32 #export {
    seq: [16]char

    if terminal == nil { return 0 }
    len: i32 = EncodeTerminalPaneKeypad(seq, (int)sizeof(seq), key,
    terminal_key_mode(terminal))
    return terminal_write_encoded(terminal, seq, len)
}
