#module "text"
#inspect off
#import "terminal_text.h"

terminal_codepoint_ambiguous_width :: (cp: u32) -> i32 {
    # k2c drops fixed-array initializers on module globals and
    # truncates very long conditions; the table must stay a local.
    ranges: [140][2]u32 = {
        {0x00a1, 0x00a1}, {0x00a4, 0x00a4}, {0x00a7, 0x00a8},
        {0x00aa, 0x00aa}, {0x00ad, 0x00ae}, {0x00b0, 0x00b4},
        {0x00b6, 0x00ba}, {0x00bc, 0x00bf}, {0x00c6, 0x00c6},
        {0x00d0, 0x00d0}, {0x00d7, 0x00d8}, {0x00de, 0x00e1},
        {0x00e6, 0x00e6}, {0x00e8, 0x00ea}, {0x00ec, 0x00ed},
        {0x00f0, 0x00f0}, {0x00f2, 0x00f3}, {0x00f7, 0x00fa},
        {0x00fc, 0x00fc}, {0x00fe, 0x00fe}, {0x0101, 0x0101},
        {0x0111, 0x0111}, {0x0113, 0x0113}, {0x011b, 0x011b},
        {0x0126, 0x0127}, {0x012b, 0x012b}, {0x0131, 0x0133},
        {0x0138, 0x0138}, {0x013f, 0x0142}, {0x0144, 0x0144},
        {0x0148, 0x014b}, {0x014d, 0x014d}, {0x0152, 0x0153},
        {0x0166, 0x0167}, {0x016b, 0x016b}, {0x01ce, 0x01ce},
        {0x01d0, 0x01d0}, {0x01d2, 0x01d2}, {0x01d4, 0x01d4},
        {0x01d6, 0x01d6}, {0x01d8, 0x01d8}, {0x01da, 0x01da},
        {0x01dc, 0x01dc}, {0x0251, 0x0251}, {0x0261, 0x0261},
        {0x02c4, 0x02c4}, {0x02c7, 0x02c7}, {0x02c9, 0x02cb},
        {0x02cd, 0x02cd}, {0x02d0, 0x02d0}, {0x02d8, 0x02db},
        {0x02dd, 0x02dd}, {0x02df, 0x02df}, {0x0391, 0x03a1},
        {0x03a3, 0x03a9}, {0x03b1, 0x03c1}, {0x03c3, 0x03c9},
        {0x0401, 0x0401}, {0x0410, 0x044f}, {0x0451, 0x0451},
        {0x2010, 0x2010}, {0x2013, 0x2016}, {0x2018, 0x2019},
        {0x201c, 0x201d}, {0x2020, 0x2022}, {0x2024, 0x2027},
        {0x2030, 0x2030}, {0x2032, 0x2033}, {0x2035, 0x2035},
        {0x203b, 0x203b}, {0x203e, 0x203e}, {0x2074, 0x2074},
        {0x207f, 0x207f}, {0x2081, 0x2084}, {0x20ac, 0x20ac},
        {0x2103, 0x2103}, {0x2105, 0x2105}, {0x2109, 0x2109},
        {0x2113, 0x2113}, {0x2116, 0x2116}, {0x2121, 0x2122},
        {0x2126, 0x2126}, {0x212b, 0x212b}, {0x2153, 0x2154},
        {0x215b, 0x215e}, {0x2160, 0x216b}, {0x2170, 0x2179},
        {0x2189, 0x2189}, {0x2190, 0x2199}, {0x21b8, 0x21b9},
        {0x21d2, 0x21d2}, {0x21d4, 0x21d4}, {0x21e7, 0x21e7},
        {0x2200, 0x2200}, {0x2202, 0x2203}, {0x2207, 0x2208},
        {0x220b, 0x220b}, {0x220f, 0x220f}, {0x2211, 0x2211},
        {0x2215, 0x2215}, {0x221a, 0x221a}, {0x221d, 0x2220},
        {0x2223, 0x2223}, {0x2225, 0x2225}, {0x2227, 0x222c},
        {0x222e, 0x222e}, {0x2234, 0x2237}, {0x223c, 0x223d},
        {0x2248, 0x2248}, {0x224c, 0x224c}, {0x2252, 0x2252},
        {0x2260, 0x2261}, {0x2264, 0x2267}, {0x226a, 0x226b},
        {0x226e, 0x226f}, {0x2282, 0x2283}, {0x2286, 0x2287},
        {0x2295, 0x2295}, {0x2299, 0x2299}, {0x22a5, 0x22a5},
        {0x22bf, 0x22bf}, {0x2312, 0x2312}, {0x2460, 0x24e9},
        {0x24eb, 0x254b}, {0x2550, 0x2573}, {0x2580, 0x258f},
        {0x2592, 0x2595}, {0x25a0, 0x25a1}, {0x25a3, 0x25a9},
        {0x25b2, 0x25b3}, {0x25b6, 0x25b7}, {0x25bc, 0x25bd},
        {0x25c0, 0x25c1}, {0x25c6, 0x25c8}, {0x25cb, 0x25cb},
        {0x25ce, 0x25d1}, {0x25e2, 0x25e5}, {0x25ef, 0x25ef},
        {0x2605, 0x2606}, {0x2609, 0x2609}, {0x260e, 0x260f},
        {0x261c, 0x261c}, {0x261e, 0x261e}, {0x2640, 0x2640},
        {0x2642, 0x2642}, {0x2660, 0x2661}, {0x2663, 0x2665},
        {0x2667, 0x266a}, {0x266c, 0x266d}, {0x266f, 0x266f},
        {0x269e, 0x269f}, {0x26bf, 0x26bf}, {0x26c6, 0x26cd},
        {0x26cf, 0x26d3}, {0x26d5, 0x26e1}, {0x26e3, 0x26e3},
        {0x26e8, 0x26e9}, {0x26eb, 0x26f1}, {0x26f4, 0x26f4},
        {0x26f6, 0x26f9}, {0x26fb, 0x26fc}, {0x26fe, 0x26ff},
        {0x273d, 0x273d}, {0x2776, 0x277f}, {0x2b56, 0x2b59},
        {0x3248, 0x324f}, {0xe000, 0xf8ff}, {0xfffd, 0xfffd}
    }
    i: i32 = 0

    while i < 140 {
        if cp >= ranges[i][0] && cp <= ranges[i][1] {
            return 1
        }
        i += 1
    }
    return 0
}

terminal_codepoint_width :: (cp: u32) -> i32 #export {
    return terminal_codepoint_width_for(nil, cp)
}

terminal_codepoint_width_for :: (terminal: *const TerminalState,
cp: u32) -> i32 #export {
    if cp == 0 { return 0 }
    if cp < 32 || (cp >= 0x7f && cp < 0xa0) { return 0 }
    if (cp >= 0x0300 && cp <= 0x036f) ||
    (cp >= 0x1ab0 && cp <= 0x1aff) ||
    (cp >= 0x1dc0 && cp <= 0x1dff) ||
    (cp >= 0x20d0 && cp <= 0x20ff) ||
    (cp >= 0xfe20 && cp <= 0xfe2f) {
        return 0
    }
    if (cp >= 0x1100 && cp <= 0x115f) || cp == 0x2329 ||
    cp == 0x232a ||
    (cp >= 0x2e80 && cp <= 0xa4cf && cp != 0x303f) ||
    (cp >= 0xac00 && cp <= 0xd7a3) ||
    (cp >= 0xf900 && cp <= 0xfaff) ||
    (cp >= 0xfe10 && cp <= 0xfe19) ||
    (cp >= 0xfe30 && cp <= 0xfe6f) ||
    (cp >= 0xff00 && cp <= 0xff60) ||
    (cp >= 0xffe0 && cp <= 0xffe6) ||
    (cp >= 0x1f300 && cp <= 0x1f64f) ||
    (cp >= 0x1f900 && cp <= 0x1f9ff) {
        return 2
    }
    if terminal != nil && terminal->ambiguous_width_wide != 0 &&
    terminal_codepoint_ambiguous_width(cp) != 0 {
        return 2
    }
    return 1
}

terminal_translate_charset :: (terminal: *const TerminalState,
codepoint: u32) -> u32 #export {
    if terminal == nil || codepoint < 0x20 || codepoint > 0x7e {
        return codepoint
    }
    charset: i32 = terminal->active_charset == 1
    ? terminal->g1_charset : terminal->g0_charset
    if charset != TERMINAL_CHARSET_DEC_SPECIAL {
        return codepoint
    }
    if codepoint == '`' { return 0x25c6 }
    if codepoint == 'a' { return 0x2592 }
    if codepoint == 'b' { return 0x2409 }
    if codepoint == 'c' { return 0x240c }
    if codepoint == 'd' { return 0x240d }
    if codepoint == 'e' { return 0x240a }
    if codepoint == 'f' { return 0x00b0 }
    if codepoint == 'g' { return 0x00b1 }
    if codepoint == 'h' { return 0x2424 }
    if codepoint == 'i' { return 0x240b }
    if codepoint == 'j' { return 0x2518 }
    if codepoint == 'k' { return 0x2510 }
    if codepoint == 'l' { return 0x250c }
    if codepoint == 'm' { return 0x2514 }
    if codepoint == 'n' { return 0x253c }
    if codepoint == 'o' { return 0x23ba }
    if codepoint == 'p' { return 0x23bb }
    if codepoint == 'q' { return 0x2500 }
    if codepoint == 'r' { return 0x23bc }
    if codepoint == 's' { return 0x23bd }
    if codepoint == 't' { return 0x251c }
    if codepoint == 'u' { return 0x2524 }
    if codepoint == 'v' { return 0x2534 }
    if codepoint == 'w' { return 0x252c }
    if codepoint == 'x' { return 0x2502 }
    if codepoint == 'y' { return 0x2264 }
    if codepoint == 'z' { return 0x2265 }
    if codepoint == '{' { return 0x03c0 }
    if codepoint == '|' { return 0x2260 }
    if codepoint == '}' { return 0x00a3 }
    if codepoint == '~' { return 0x00b7 }
    return codepoint
}

terminal_charset_from_designator :: (codepoint: u32) -> i32 #export {
    return codepoint == '0' ? TERMINAL_CHARSET_DEC_SPECIAL
    : TERMINAL_CHARSET_US_ASCII
}

terminal_append_utf8 :: (out: *char, out_size: i32, used: *i32,
cp: u32) -> i32 #export {
    return AppendTerminalPaneUTF8Codepoint(out, out_size, used, cp)
}
