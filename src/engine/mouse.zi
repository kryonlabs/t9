// Loaded by terminal.zi; engine declarations share one typed state.
#scope_module
#scope_module
terminal_mouse_mode :: (
terminal: *Terminal) -> PaneMouse.TerminalPaneMouseMode {
    mode: PaneMouse.TerminalPaneMouseMode = PaneMouse.TerminalPaneMouseMode.{}

    if terminal == null { return mode }
    mode.mode = terminal.mouse_mode
    mode.utf8 = terminal.mouse_utf8
    mode.sgr = terminal.mouse_sgr
    mode.urxvt = terminal.mouse_urxvt
    mode.pixels = terminal.mouse_pixels
    return mode
}

#scope_export
#program_export
terminal_send_mouse_pixels :: (terminal: *Terminal,
button: s32, col: s32, row: s32, pixel_x: s32, pixel_y: s32,
pressed: s32, motion: s32, mods: s32) -> s32 {
    seq: [64]u8

    if terminal == null { return 0 }
    len: s32 = PaneMouse.EncodeTerminalPaneMouse( *seq[0], cast(s32)size_of(type_of(seq)),
    button, col, row, pixel_x, pixel_y, pressed, motion, mods,
    terminal_mouse_mode(terminal))
    if len <= 0 { return 0 }
    return terminal_write(terminal, cast(*void)(*seq[0]), len)
}

#scope_export
#program_export
terminal_send_mouse :: (terminal: *Terminal, button: s32,
col: s32, row: s32, pressed: s32, motion: s32,
mods: s32) -> s32 {
    return terminal_send_mouse_pixels(terminal, button, col, row,
    col, row, pressed, motion, mods)
}
