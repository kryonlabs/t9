#module "dcs"
#inspect off
#import "terminal_dcs.h"
#import "terminal_sixel.h"
#import "stdio.h"
#import "string.h"

terminal_dcs_begin :: (terminal: *TerminalState) #export {
    if terminal == nil { return }
    ResetTerminalPaneDCSBuffer(&terminal->dcs)
}

terminal_dcs_append :: (terminal: *TerminalState,
codepoint: u32) #export {
    if terminal == nil { return }
    AppendTerminalPaneDCSCodepoint(&terminal->dcs, codepoint)
}

terminal_dcs_finish :: (terminal: *TerminalState) -> i32 #export {
    rows_used: i32 = 0

    if terminal == nil { return 0 }
    payload: const char* = GetTerminalPaneDCSBufferText(&terminal->dcs)
    if payload != nil {
        if terminal_dcs_finish_decrqss(terminal, payload) == 0 &&
        terminal_dcs_finish_xtgettcap(terminal, payload) == 0 &&
        strchr(payload, 'q') != nil {
            rows_used = terminal_sixel_finish(terminal, payload)
        }
    }
    ResetTerminalPaneDCSBuffer(&terminal->dcs)
    return rows_used
}

terminal_dcs_finish_xtgettcap :: (terminal: *TerminalState,
payload: const char*) -> i32 #export {
    if terminal == nil || payload == nil ||
    strncmp(payload, "+q", 2) != 0 {
        return 0
    }
    response: [1024]char
    len: i32 = FormatTerminalPaneXTGETTCAPResponse(response,
    (int)sizeof(response), payload)
    if len <= 0 { return 1 }
    terminal_write_text(terminal, response)
    return 1
}

current_sgr_status :: (terminal: *const TerminalState,
buffer: *char, buffer_size: i32) {
    if buffer == nil || buffer_size <= 0 { return }
    buffer[0] = '\0'
    if terminal == nil { return }
    status: TerminalPaneSGRStatus = (TerminalPaneSGRStatus){
        terminal->current_style &
        (STYLE_BOLD | STYLE_ITALIC | STYLE_UNDERLINE | STYLE_INVERSE |
        STYLE_STRIKE | STYLE_FAINT | STYLE_CONCEAL | STYLE_BLINK |
        STYLE_OVERLINE),
        terminal->current_fg,
        terminal->current_bg,
        terminal->current_underline,
    }
    FormatTerminalPaneSGRStatus(buffer, buffer_size, status)
}

terminal_dcs_finish_decrqss :: (terminal: *TerminalState,
payload: const char*) -> i32 #export {
    if terminal == nil || payload == nil ||
    strncmp(payload, "$q", 2) != 0 {
        return 0
    }
    status: [256]char
    response: [320]char

    selector: const char* = payload + 2
    status[0] = '\0'
    if strcmp(selector, "m") == 0 {
        current_sgr_status(terminal, status, (int)sizeof(status))
    } else if strcmp(selector, "r") == 0 {
        snprintf(status, sizeof(status), "%d;%dr",
        terminal->scroll_top + 1, terminal->scroll_bottom + 1)
    } else if strcmp(selector, " q") == 0 {
        snprintf(status, sizeof(status), "%d q",
        TerminalPaneCursorStyleReportCode(terminal->cursor_style,
        terminal->cursor_blink))
    } else if strcmp(selector, "\" q") == 0 {
        snprintf(status, sizeof(status), "0\"q")
    } else {
        terminal_write_text(terminal, "\x1bP0$r\x1b\\")
        return 1
    }
    snprintf(response, sizeof(response), "\x1bP1$r%s\x1b\\", status)
    terminal_write_text(terminal, response)
    return 1
}
