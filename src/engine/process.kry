#module "process"
#inspect off
#import "terminal.h"
#import "terminal_pty.h"
#import "terminal_screen.h"
#import "terminal_sixel.h"
#import "signal.h"
#import "stdlib.h"
#import "string.h"

terminal_spawn :: (terminal: *TerminalState, cwd: const char*,
shell: const char*, command: const char*, cols: i32,
rows: i32) -> i32 #export {
    if terminal == nil { return 0 }
    terminal_close(terminal)
    terminal_init(terminal)
    if terminal_allocate_screen(terminal, cols, rows) == 0 {
        return 0
    }
    pid: i32 = -1
    master: i32 = TerminalPtyOpen(cwd, shell, command,
    terminal->cols, terminal->rows, &pid)
    if master < 0 { return 0 }
    terminal->pid = pid
    terminal->fd = master
    terminal->running = 1
    return 1
}

terminal_open :: (terminal: *TerminalState, cwd: const char*,
cols: i32, rows: i32) -> i32 #export {
    return terminal_spawn(terminal, cwd, nil, nil, cols, rows)
}

terminal_write :: (terminal: *TerminalState, data: *const void,
size: i32) -> i32 #export {
    if terminal == nil || terminal->running == 0 ||
    terminal->fd < 0 || data == nil || size <= 0 {
        return 0
    }
    return TerminalPtyWrite(terminal->fd, data, size)
}

terminal_write_text :: (terminal: *TerminalState,
text: const char*) -> i32 #export {
    if text == nil { return 0 }
    return terminal_write(terminal, text, (int)strlen(text))
}

terminal_poll_bytes :: (terminal: *TerminalState) -> i32 #export {
    closed: i32 = 0
    bytes: i32 = 0

    if terminal == nil || terminal->fd < 0 { return 0 }
    while 1 {
        buffer: [4096]char
        got: i32 = TerminalPtyRead(terminal->fd, buffer,
        (int)sizeof(buffer))

        if got > 0 {
            terminal_feed(terminal, buffer, got)
            bytes += got
            continue
        }
        if got < 0 { closed = 1 }
        break
    }
    if terminal->running != 0 && terminal->pid > 0 {
        if TerminalPtyChildExited(terminal->pid) != 0 {
            terminal->running = 0
        }
    }
    if closed != 0 && terminal->fd >= 0 {
        TerminalPtyClose(terminal->fd)
        terminal->fd = -1
        terminal->running = 0
    }
    return bytes
}

terminal_poll :: (terminal: *TerminalState) -> i32 #export {
    if terminal == nil { return 0 }
    terminal_poll_bytes(terminal)
    return terminal->running
}

terminal_resize :: (terminal: *TerminalState, cols: i32,
rows: i32) #export {
    if terminal == nil { return }
    cols = terminal_clamp_int(cols, 8, MAX_COLS)
    rows = terminal_clamp_int(rows, 4, MAX_ROWS)
    if cols == terminal->cols && rows == terminal->rows {
        return
    }
    if terminal_allocate_screen(terminal, cols, rows) == 0 {
        return
    }
    if terminal->fd >= 0 {
        TerminalPtyResize(terminal->fd, terminal->cols,
        terminal->rows)
    }
}

terminal_set_scrollback_limit :: (terminal: *TerminalState,
rows: i32) #export {
    if terminal == nil { return }
    if rows < 0 { rows = 0 }
    if rows > 1000000 { rows = 1000000 }
    if rows == 0 { rows = SCROLLBACK_LIMIT }
    terminal->scrollback_limit = rows
    if terminal->cols > 0 {
        terminal_allocate_scrollback(terminal)
    }
}

terminal_set_ambiguous_width :: (terminal: *TerminalState,
wide: i32) #export {
    if terminal == nil { return }
    terminal->ambiguous_width_wide = wide != 0 ? 1 : 0
}

terminal_close :: (terminal: *TerminalState) #export {
    if terminal == nil { return }
    if terminal->fd >= 0 {
        TerminalPtyClose(terminal->fd)
        terminal->fd = -1
    }
    if terminal->running != 0 && terminal->pid > 0 {
        TerminalPtySignal(terminal->pid, SIGHUP)
        TerminalPtySignal(terminal->pid, SIGTERM)
        if TerminalPtyWaitExit(terminal->pid, 200) == 0 {
            TerminalPtySignal(terminal->pid, SIGKILL)
            TerminalPtyWaitExit(terminal->pid, 500)
        }
    }
    free(terminal->main_cells)
    free(terminal->alt_cells)
    free(terminal->scrollback)
    free(terminal->main_wrapped)
    free(terminal->alt_wrapped)
    free(terminal->scrollback_wrapped)
    free(terminal->tab_stops)
    terminal_sixel_clear_images(terminal, -1)
    free(terminal->sixel_images)
    FreeTerminalPaneDCSBuffer(&terminal->dcs)
    terminal_init(terminal)
}
