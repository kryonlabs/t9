#module "screen"
#inspect off
#import "terminal_screen.h"
#import "terminal_sixel.h"
#import "stdlib.h"
#import "string.h"

terminal_clamp_int :: (value: i32, low: i32, high: i32) -> i32 #export {
    if value < low { return low }
    if value > high { return high }
    return value
}

terminal_blank_cell :: (
terminal: *const TerminalState) -> Cell #export {
    cell: Cell

    cell.codepoint = ' '
    cell.combining = 0
    cell.fg = terminal != nil ? terminal->current_fg : COLOR_DEFAULT
    cell.bg = terminal != nil ? terminal->current_bg : COLOR_DEFAULT
    cell.underline = terminal != nil
    ? terminal->current_underline : COLOR_DEFAULT
    cell.hyperlink = terminal != nil
    ? terminal->current_hyperlink : 0
    cell.style = terminal != nil
    ? (unsigned short)terminal->current_style : 0
    return cell
}

terminal_screen_cells :: (terminal: *TerminalState) -> *Cell #export {
    return terminal != nil &&
    terminal->alternate_screen != 0
    ? terminal->alt_cells : terminal->main_cells
}

terminal_screen_wrapped :: (
terminal: *TerminalState) -> *unsigned char #export {
    return terminal != nil &&
    terminal->alternate_screen != 0
    ? terminal->alt_wrapped : terminal->main_wrapped
}

terminal_reset_tab_stops :: (terminal: *TerminalState) #export {
    if terminal == nil || terminal->tab_stops == nil { return }
    memset(terminal->tab_stops, 0, (size_t)terminal->cols)
    col: i32 = 8
    while col < terminal->cols {
        terminal->tab_stops[col] = 1
        col += 8
    }
}

terminal_clear_tab_stops :: (terminal: *TerminalState) #export {
    if terminal == nil || terminal->tab_stops == nil { return }
    memset(terminal->tab_stops, 0, (size_t)terminal->cols)
}

terminal_clear_cell_block :: (terminal: *TerminalState,
cells: *Cell) #export {
    if terminal == nil || cells == nil { return }
    blank: Cell = terminal_blank_cell(terminal)
    count: i32 = terminal->cols * terminal->rows
    i: i32 = 0
    while i < count {
        cells[i] = blank
        i += 1
    }
}

terminal_clear_row :: (terminal: *TerminalState, row: i32) #export {
    cells: *Cell = terminal_screen_cells(terminal)
    wrapped: *unsigned char = terminal_screen_wrapped(terminal)

    if terminal == nil || cells == nil || row < 0 ||
    row >= terminal->rows {
        return
    }
    terminal_sixel_clear_range(terminal, row * terminal->cols,
    (row + 1) * terminal->cols)
    blank: Cell = terminal_blank_cell(terminal)
    col: i32 = 0
    while col < terminal->cols {
        cells[row * terminal->cols + col] = blank
        col += 1
    }
    if wrapped != nil { wrapped[row] = 0 }
}

terminal_clear_screen :: (terminal: *TerminalState) #export {
    if terminal == nil { return }
    terminal_clear_cell_block(terminal,
    terminal_screen_cells(terminal))
    if terminal_screen_wrapped(terminal) != nil {
        memset(terminal_screen_wrapped(terminal), 0,
        (size_t)terminal->rows)
    }
    terminal->cursor_col = 0
    terminal->cursor_row = 0
    terminal_sixel_clear_images(terminal,
    terminal->alternate_screen)
}

terminal_screen_alignment_test :: (terminal: *TerminalState) #export {
    if terminal == nil { return }
    cells: *Cell = terminal_screen_cells(terminal)
    if cells == nil { return }
    cell: Cell = terminal_blank_cell(terminal)
    cell.codepoint = 'E'
    cell.combining = 0
    cell.style &= ~STYLE_WIDE_CONT
    count: i32 = terminal->cols * terminal->rows
    i: i32 = 0
    while i < count {
        cells[i] = cell
        i += 1
    }
    wrapped: *unsigned char = terminal_screen_wrapped(terminal)
    if wrapped != nil {
        memset(wrapped, 0, (size_t)terminal->rows)
    }
    terminal->cursor_col = 0
    terminal->cursor_row = 0
    terminal_sixel_clear_images(terminal,
    terminal->alternate_screen)
}

terminal_clear_alternate_screen :: (terminal: *TerminalState) #export {
    if terminal == nil { return }
    terminal_clear_cell_block(terminal, terminal->alt_cells)
    if terminal->alt_wrapped != nil {
        memset(terminal->alt_wrapped, 0, (size_t)terminal->rows)
    }
    terminal_sixel_clear_images(terminal, 1)
}

terminal_clear_scrollback :: (terminal: *TerminalState) #export {
    if terminal == nil { return }
    terminal->scrollback_count = 0
    terminal->scrollback_head = 0
    if terminal->scrollback_wrapped != nil &&
    terminal->scrollback_capacity > 0 {
        memset(terminal->scrollback_wrapped, 0,
        (size_t)terminal->scrollback_capacity)
    }
    terminal_sixel_prune_scrollback(terminal)
}

terminal_allocate_scrollback :: (
terminal: *TerminalState) -> i32 #export {
    if terminal == nil { return 0 }
    limit: i32 = terminal->scrollback_limit > 0
    ? terminal->scrollback_limit : SCROLLBACK_LIMIT
    scrollback: *Cell = (Cell *)realloc(terminal->scrollback,
    (size_t)(limit * terminal->cols) * sizeof(Cell))
    if scrollback == nil { return 0 }
    wrapped: *unsigned char = (unsigned char *)realloc(
    terminal->scrollback_wrapped, (size_t)limit)
    if wrapped == nil { return 0 }
    terminal->scrollback = scrollback
    terminal->scrollback_wrapped = wrapped
    terminal->scrollback_capacity = limit
    if terminal->scrollback_count > terminal->scrollback_capacity {
        terminal->scrollback_count = terminal->scrollback_capacity
    }
    if terminal->scrollback_head >= terminal->scrollback_capacity {
        terminal->scrollback_head = 0
    }
    if terminal->scrollback_count == 0 {
        memset(terminal->scrollback_wrapped, 0,
        (size_t)terminal->scrollback_capacity)
    }
    terminal_sixel_prune_scrollback(terminal)
    return 1
}

row_text_end :: (cells: *const Cell, cols: i32, row: i32,
keep_full: i32) -> i32 {
    end: i32 = cols

    if cells == nil || cols <= 0 || row < 0 { return 0 }
    if keep_full != 0 { return cols }
    while end > 0 && cells[row * cols + end - 1].codepoint == ' ' {
        end -= 1
    }
    return end
}

reflow_cell_blank :: (cell: *const void, userdata: *void) -> i32 #export {
    terminal_cell: *const Cell = (const Cell *)cell

    return terminal_cell == nil ||
    terminal_cell->codepoint == ' ' ? 1 : 0
}

init_reflow_row :: (rows: *Cell, initialized: *unsigned char,
cols: i32, max_rows: i32, row: i32, blank: Cell) {
    if rows == nil || initialized == nil || cols <= 0 || row < 0 ||
    row >= max_rows || initialized[row] != 0 {
        return
    }
    col: i32 = 0
    while col < cols {
        rows[row * cols + col] = blank
        col += 1
    }
    initialized[row] = 1
}

append_reflow_cell :: (rows: *Cell, wrapped: *unsigned char,
initialized: *unsigned char, cols: i32, max_rows: i32,
out_row: *i32, out_col: *i32, blank: Cell, cell: Cell) {
    if rows == nil || wrapped == nil || initialized == nil ||
    out_row == nil || out_col == nil || cols <= 0 ||
    max_rows <= 0 {
        return
    }
    if *out_col >= cols {
        if *out_row >= 0 && *out_row < max_rows {
            wrapped[*out_row] = 1
        }
        *out_row += 1
        *out_col = 0
    }
    if *out_row >= max_rows { return }
    init_reflow_row(rows, initialized, cols, max_rows, *out_row,
    blank)
    rows[*out_row * cols + *out_col] = cell
    *out_col += 1
}

finish_reflow_line :: (rows: *Cell, initialized: *unsigned char,
cols: i32, max_rows: i32, out_row: *i32, out_col: *i32,
blank: Cell) {
    if out_row == nil || out_col == nil { return }
    if *out_row < max_rows {
        init_reflow_row(rows, initialized, cols, max_rows,
        *out_row, blank)
        *out_row += 1
    }
    *out_col = 0
}

terminal_append_scrollback :: (terminal: *TerminalState,
row: *const Cell, wrapped: i32) {
    if terminal == nil || row == nil ||
    terminal->scrollback == nil ||
    terminal->scrollback_capacity <= 0 {
        return
    }
    index: i32 = terminal->scrollback_head
    memcpy(terminal->scrollback + index * terminal->cols, row,
    (size_t)terminal->cols * sizeof(Cell))
    if terminal->scrollback_wrapped != nil {
        terminal->scrollback_wrapped[index] =
        wrapped != 0 ? 1 : 0
    }
    terminal->scrollback_head =
    (terminal->scrollback_head + 1) %
    terminal->scrollback_capacity
    if terminal->scrollback_count < terminal->scrollback_capacity {
        terminal->scrollback_count += 1
    }
}

terminal_push_scrollback :: (terminal: *TerminalState,
row: *const Cell, wrapped: i32) {
    if terminal == nil || terminal->alternate_screen != 0 {
        return
    }
    terminal_append_scrollback(terminal, row, wrapped)
}

reflow_main_screen :: (terminal: *TerminalState,
old_cells: *const Cell, old_wrapped: *const unsigned char,
old_cols: i32, old_rows: i32, old_cursor_col: i32,
old_cursor_row: i32, new_cursor_col: *i32,
new_cursor_row: *i32) -> i32 {
    if terminal == nil || terminal->main_cells == nil ||
    old_cells == nil || old_cols <= 0 || old_rows <= 0 ||
    terminal->cols <= 0 {
        return 0
    }
    cursor_row: i32 = -1
    cursor_col: i32 = -1
    out_row: i32 = 0
    max_lines: i32 = old_rows *
    ((old_cols + terminal->cols - 1) / terminal->cols + 2)
    if max_lines < terminal->rows {
        max_lines = terminal->rows
    }
    lines: *Cell = (Cell *)calloc(
    (size_t)max_lines * (size_t)terminal->cols, sizeof(Cell))
    wrapped: *unsigned char = (unsigned char *)calloc(
    (size_t)max_lines, 1)
    if lines == nil || wrapped == nil {
        free(lines)
        free(wrapped)
        return 0
    }
    blank: Cell = terminal_blank_cell(terminal)
    spec: TerminalPaneReflowSpec
    memset(&spec, 0, sizeof(spec))
    spec.input_cells = old_cells
    spec.input_wrapped = old_wrapped
    spec.input_cols = old_cols
    spec.input_rows = old_rows
    spec.output_cells = lines
    spec.output_wrapped = wrapped
    spec.output_cols = terminal->cols
    spec.output_rows = max_lines
    spec.cell_size = sizeof(Cell)
    spec.blank_cell = &blank
    spec.is_blank = reflow_cell_blank
    spec.trim_blank_rows_after_cursor = 1
    spec.cursor_input_col = old_cursor_col
    spec.cursor_input_row = old_cursor_row
    spec.cursor_output_col = &cursor_col
    spec.cursor_output_row = &cursor_row
    spec.output_row_count = &out_row
    if TerminalPaneReflowRows(&spec) == 0 {
        free(lines)
        free(wrapped)
        return 0
    }
    if out_row <= 0 {
        free(lines)
        free(wrapped)
        return 1
    }
    copy_rows: i32 = out_row < terminal->rows
    ? out_row : terminal->rows
    start_row: i32 = out_row - copy_rows
    memcpy(terminal->main_cells,
    lines + start_row * terminal->cols,
    (size_t)copy_rows * (size_t)terminal->cols * sizeof(Cell))
    memcpy(terminal->main_wrapped, wrapped + start_row,
    (size_t)copy_rows)
    if cursor_row >= start_row &&
    cursor_row < start_row + copy_rows {
        if new_cursor_row != nil {
            *new_cursor_row = cursor_row - start_row
        }
        if new_cursor_col != nil {
            *new_cursor_col = cursor_col
        }
    } else {
        if new_cursor_row != nil {
            *new_cursor_row = terminal_clamp_int(old_cursor_row,
            0, copy_rows - 1)
        }
        if new_cursor_col != nil {
            *new_cursor_col = old_cursor_col
        }
    }
    free(lines)
    free(wrapped)
    return 1
}

reflow_scrollback :: (terminal: *TerminalState,
old_cells: *const Cell, old_wrapped: *const unsigned char,
old_cols: i32, old_count: i32, old_head: i32,
old_capacity: i32) {
    if terminal == nil || old_cells == nil || old_cols <= 0 ||
    old_count <= 0 || old_capacity <= 0 || terminal->cols <= 0 {
        return
    }
    out_row: i32 = 0
    out_col: i32 = 0
    max_lines: i32 = old_count *
    ((old_cols + terminal->cols - 1) / terminal->cols + 2)
    if max_lines < old_count { max_lines = old_count }
    blank: Cell = terminal_blank_cell(terminal)
    lines: *Cell = (Cell *)malloc((size_t)max_lines *
    (size_t)terminal->cols * sizeof(Cell))
    wrapped: *unsigned char = (unsigned char *)calloc(
    (size_t)max_lines, 1)
    initialized: *unsigned char = (unsigned char *)calloc(
    (size_t)max_lines, 1)
    if lines == nil || wrapped == nil || initialized == nil {
        free(lines)
        free(wrapped)
        free(initialized)
        return
    }
    index: i32 = 0
    while index < old_count {
        physical: i32 = (old_head - old_count + index +
        old_capacity) % old_capacity
        soft: i32 = old_wrapped != nil &&
        old_wrapped[physical] != 0 ? 1 : 0
        end: i32 = row_text_end(old_cells, old_cols, physical,
        soft)
        col: i32 = 0

        while col < end {
            append_reflow_cell(lines, wrapped, initialized,
            terminal->cols, max_lines, &out_row, &out_col,
            blank, old_cells[physical * old_cols + col])
            col += 1
        }
        if soft == 0 {
            finish_reflow_line(lines, initialized,
            terminal->cols, max_lines, &out_row, &out_col,
            blank)
        }
        index += 1
    }
    if out_col > 0 {
        finish_reflow_line(lines, initialized, terminal->cols,
        max_lines, &out_row, &out_col, blank)
    }
    row: i32 = 0
    while row < out_row {
        terminal_append_scrollback(terminal,
        lines + row * terminal->cols, wrapped[row])
        row += 1
    }
    free(lines)
    free(wrapped)
    free(initialized)
}

ReflowStream :: struct {
    terminal: *TerminalState
    blank: Cell
    current: *Cell
    recent: *Cell
    recent_wrapped: *unsigned char
    current_col: i32
    current_wrapped: i32
    total_rows: i32
    failed: i32
}

reflow_stream_blank_current :: (stream: *ReflowStream) {
    if stream == nil || stream->current == nil ||
    stream->terminal == nil {
        return
    }
    col: i32 = 0
    while col < stream->terminal->cols {
        stream->current[col] = stream->blank
        col += 1
    }
    stream->current_col = 0
    stream->current_wrapped = 0
}

reflow_stream_init :: (stream: *ReflowStream,
terminal: *TerminalState) -> i32 {
    if stream == nil || terminal == nil || terminal->cols <= 0 ||
    terminal->rows <= 0 {
        return 0
    }
    memset(stream, 0, sizeof(ReflowStream))
    stream->terminal = terminal
    stream->blank = terminal_blank_cell(terminal)
    stream->current = (Cell *)malloc(
    (size_t)terminal->cols * sizeof(Cell))
    stream->recent = (Cell *)malloc(
    (size_t)terminal->rows * (size_t)terminal->cols *
    sizeof(Cell))
    stream->recent_wrapped = (unsigned char *)calloc(
    (size_t)terminal->rows, 1)
    if stream->current == nil || stream->recent == nil ||
    stream->recent_wrapped == nil {
        free(stream->current)
        free(stream->recent)
        free(stream->recent_wrapped)
        memset(stream, 0, sizeof(ReflowStream))
        return 0
    }
    reflow_stream_blank_current(stream)
    return 1
}

reflow_stream_close :: (stream: *ReflowStream) {
    if stream == nil { return }
    free(stream->current)
    free(stream->recent)
    free(stream->recent_wrapped)
    memset(stream, 0, sizeof(ReflowStream))
}

reflow_stream_emit :: (stream: *ReflowStream) {
    if stream == nil || stream->terminal == nil ||
    stream->failed != 0 {
        return
    }
    slot: i32
    if stream->total_rows >= stream->terminal->rows {
        slot = stream->total_rows % stream->terminal->rows
        terminal_append_scrollback(stream->terminal,
        stream->recent + slot * stream->terminal->cols,
        stream->recent_wrapped[slot])
    } else {
        slot = stream->total_rows
    }
    memcpy(stream->recent + slot * stream->terminal->cols,
    stream->current,
    (size_t)stream->terminal->cols * sizeof(Cell))
    stream->recent_wrapped[slot] =
    stream->current_wrapped != 0 ? 1 : 0
    stream->total_rows += 1
    reflow_stream_blank_current(stream)
}

reflow_stream_append_cell :: (stream: *ReflowStream,
cell: Cell) {
    if stream == nil || stream->terminal == nil ||
    stream->failed != 0 {
        return
    }
    if stream->current_col >= stream->terminal->cols {
        stream->current_wrapped = 1
        reflow_stream_emit(stream)
    }
    if stream->current_col < stream->terminal->cols {
        stream->current[stream->current_col] = cell
        stream->current_col += 1
    }
}

reflow_stream_finish_line :: (stream: *ReflowStream) {
    reflow_stream_emit(stream)
}

reflow_stream_flush_partial :: (stream: *ReflowStream) {
    if stream != nil && stream->current_col > 0 {
        reflow_stream_emit(stream)
    }
}

reflow_stream_copy_main :: (stream: *ReflowStream,
cursor_row: i32, cursor_col: i32, old_cursor_col: i32,
old_cursor_row: i32, new_cursor_col: *i32,
new_cursor_row: *i32) -> i32 {
    if stream == nil || stream->terminal == nil ||
    stream->failed != 0 {
        return 0
    }
    terminal: *TerminalState = stream->terminal
    copy_rows: i32 = stream->total_rows < terminal->rows
    ? stream->total_rows : terminal->rows
    start_row: i32 = stream->total_rows - copy_rows
    row: i32 = 0
    while row < copy_rows {
        slot: i32 = (start_row + row) % terminal->rows

        memcpy(terminal->main_cells + row * terminal->cols,
        stream->recent + slot * terminal->cols,
        (size_t)terminal->cols * sizeof(Cell))
        terminal->main_wrapped[row] =
        stream->recent_wrapped[slot]
        row += 1
    }
    if cursor_row >= start_row &&
    cursor_row < start_row + copy_rows {
        if new_cursor_row != nil {
            *new_cursor_row = cursor_row - start_row
        }
        if new_cursor_col != nil {
            *new_cursor_col = terminal_clamp_int(cursor_col, 0,
            terminal->cols - 1)
        }
    } else {
        if new_cursor_row != nil {
            *new_cursor_row = terminal_clamp_int(old_cursor_row,
            0, terminal->rows - 1)
        }
        if new_cursor_col != nil {
            *new_cursor_col = terminal_clamp_int(old_cursor_col,
            0, terminal->cols - 1)
        }
    }
    return 1
}

reflow_scrollback_and_main :: (terminal: *TerminalState,
old_scrollback: *const Cell,
old_scrollback_wrapped: *const unsigned char, old_cols: i32,
old_scrollback_count: i32, old_scrollback_head: i32,
old_scrollback_capacity: i32, old_main: *const Cell,
old_main_wrapped: *const unsigned char, old_rows: i32,
old_cursor_col: i32, old_cursor_row: i32,
new_cursor_col: *i32, new_cursor_row: *i32) -> i32 {
    if terminal == nil || old_scrollback == nil ||
    old_main == nil || old_cols <= 0 || old_rows <= 0 ||
    old_scrollback_count <= 0 || old_scrollback_capacity <= 0 ||
    terminal->cols <= 0 {
        return 0
    }
    stream: ReflowStream
    cursor_row: i32 = -1
    cursor_col: i32 = -1
    input_rows: i32 = old_rows

    while input_rows > old_cursor_row + 1 {
        soft: i32 = old_main_wrapped != nil &&
        old_main_wrapped[input_rows - 1] != 0 ? 1 : 0

        if soft != 0 || row_text_end(old_main, old_cols,
        input_rows - 1, 0) > 0 {
            break
        }
        input_rows -= 1
    }
    if reflow_stream_init(&stream, terminal) == 0 {
        return 0
    }
    row: i32 = 0
    while row < old_scrollback_count {
        physical: i32 = (old_scrollback_head -
        old_scrollback_count + row + old_scrollback_capacity) %
        old_scrollback_capacity
        soft: i32 = old_scrollback_wrapped != nil &&
        old_scrollback_wrapped[physical] != 0 ? 1 : 0
        end: i32 = row_text_end(old_scrollback, old_cols,
        physical, soft)
        col: i32 = 0

        while col < end {
            reflow_stream_append_cell(&stream,
            old_scrollback[physical * old_cols + col])
            col += 1
        }
        if soft == 0 {
            reflow_stream_finish_line(&stream)
        }
        row += 1
    }
    row = 0
    while row < input_rows {
        soft: i32 = old_main_wrapped != nil &&
        old_main_wrapped[row] != 0 ? 1 : 0
        end: i32 = row_text_end(old_main, old_cols, row, soft)
        col: i32 = 0

        while col < end {
            if row == old_cursor_row && col == old_cursor_col {
                cursor_row = stream.total_rows
                cursor_col = stream.current_col
            }
            reflow_stream_append_cell(&stream,
            old_main[row * old_cols + col])
            col += 1
        }
        if row == old_cursor_row && cursor_row < 0 {
            cursor_row = stream.total_rows
            cursor_col = stream.current_col +
            (old_cursor_col > end ? old_cursor_col - end : 0)
            while cursor_col >= terminal->cols {
                cursor_row += 1
                cursor_col -= terminal->cols
            }
        }
        if soft == 0 {
            reflow_stream_finish_line(&stream)
        }
        row += 1
    }
    reflow_stream_flush_partial(&stream)
    ok: i32 = reflow_stream_copy_main(&stream, cursor_row,
    cursor_col, old_cursor_col, old_cursor_row,
    new_cursor_col, new_cursor_row)
    reflow_stream_close(&stream)
    return ok
}

terminal_allocate_screen :: (terminal: *TerminalState,
cols: i32, rows: i32) -> i32 #export {
    if terminal == nil { return 0 }
    cols = terminal_clamp_int(cols, 8, MAX_COLS)
    rows = terminal_clamp_int(rows, 4, MAX_ROWS)
    old_main: *Cell = terminal->main_cells
    old_alt: *Cell = terminal->alt_cells
    old_scrollback: *Cell = terminal->scrollback
    old_main_wrapped: *unsigned char = terminal->main_wrapped
    old_alt_wrapped: *unsigned char = terminal->alt_wrapped
    old_scrollback_wrapped: *unsigned char =
    terminal->scrollback_wrapped
    old_tabs: *unsigned char = terminal->tab_stops
    old_cols: i32 = terminal->cols
    old_rows: i32 = terminal->rows
    old_scrollback_count: i32 = terminal->scrollback_count
    old_scrollback_head: i32 = terminal->scrollback_head
    old_scrollback_capacity: i32 = terminal->scrollback_capacity
    main_reflowed: i32 = 0
    combined_reflowed: i32 = 0
    scrollback_allocated_early: i32 = 0
    reflow_cursor_col: i32 = terminal->alternate_screen != 0
    ? terminal->saved_col : terminal->cursor_col
    reflow_cursor_row: i32 = terminal->alternate_screen != 0
    ? terminal->saved_row : terminal->cursor_row
    scrollback_reflow_needed: i32 = old_cols > 0 &&
    old_cols != cols && old_scrollback != nil &&
    old_scrollback_count > 0 && old_scrollback_capacity > 0
    ? 1 : 0

    terminal->main_cells = (Cell *)calloc(
    (size_t)(cols * rows), sizeof(Cell))
    terminal->alt_cells = (Cell *)calloc(
    (size_t)(cols * rows), sizeof(Cell))
    terminal->main_wrapped = (unsigned char *)calloc(
    (size_t)rows, 1)
    terminal->alt_wrapped = (unsigned char *)calloc(
    (size_t)rows, 1)
    terminal->tab_stops = (unsigned char *)calloc(
    (size_t)cols, 1)
    if terminal->main_cells == nil || terminal->alt_cells == nil ||
    terminal->main_wrapped == nil ||
    terminal->alt_wrapped == nil || terminal->tab_stops == nil {
        free(terminal->main_cells)
        free(terminal->alt_cells)
        free(terminal->main_wrapped)
        free(terminal->alt_wrapped)
        free(terminal->tab_stops)
        terminal->main_cells = old_main
        terminal->alt_cells = old_alt
        terminal->main_wrapped = old_main_wrapped
        terminal->alt_wrapped = old_alt_wrapped
        terminal->tab_stops = old_tabs
        return 0
    }

    terminal->cols = cols
    terminal->rows = rows
    terminal_clear_cell_block(terminal, terminal->main_cells)
    terminal_clear_cell_block(terminal, terminal->alt_cells)

    if scrollback_reflow_needed != 0 {
        terminal->scrollback = nil
        terminal->scrollback_wrapped = nil
        terminal->scrollback_count = 0
        terminal->scrollback_head = 0
        terminal->scrollback_capacity = 0
        scrollback_allocated_early =
        terminal_allocate_scrollback(terminal)
        if scrollback_allocated_early != 0 &&
        reflow_scrollback_and_main(
        terminal, old_scrollback, old_scrollback_wrapped,
        old_cols, old_scrollback_count, old_scrollback_head,
        old_scrollback_capacity, old_main, old_main_wrapped,
        old_rows, reflow_cursor_col, reflow_cursor_row,
        &reflow_cursor_col, &reflow_cursor_row) != 0 {
            main_reflowed = 1
            combined_reflowed = 1
            scrollback_reflow_needed = 0
        }
    }

    copy_cols: i32 = old_cols < cols ? old_cols : cols
    copy_rows: i32 = old_rows < rows ? old_rows : rows
    if old_main != nil && old_cols > 0 && old_rows > 0 &&
    old_cols != cols && main_reflowed == 0 &&
    reflow_main_screen(terminal, old_main, old_main_wrapped,
    old_cols, old_rows, reflow_cursor_col, reflow_cursor_row,
    &reflow_cursor_col, &reflow_cursor_row) != 0 {
        main_reflowed = 1
    }
    row: i32 = 0
    while row < copy_rows {
        col: i32 = 0
        while col < copy_cols {
            if main_reflowed == 0 && old_main != nil {
                terminal->main_cells[row * cols + col] =
                old_main[row * old_cols + col]
            }
            if old_alt != nil {
                terminal->alt_cells[row * cols + col] =
                old_alt[row * old_cols + col]
            }
            col += 1
        }
        if main_reflowed == 0 && old_main_wrapped != nil {
            terminal->main_wrapped[row] = old_main_wrapped[row]
        }
        if old_alt_wrapped != nil {
            terminal->alt_wrapped[row] = old_alt_wrapped[row]
        }
        row += 1
    }
    free(old_main)
    free(old_alt)
    free(old_main_wrapped)
    free(old_alt_wrapped)
    free(old_tabs)

    terminal->scroll_top = 0
    terminal->scroll_bottom = rows - 1
    reflow_cursor_col = terminal_clamp_int(reflow_cursor_col, 0,
    cols - 1)
    reflow_cursor_row = terminal_clamp_int(reflow_cursor_row, 0,
    rows - 1)
    if main_reflowed != 0 && terminal->alternate_screen != 0 {
        terminal->saved_col = reflow_cursor_col
        terminal->saved_row = reflow_cursor_row
    } else if main_reflowed != 0 {
        terminal->cursor_col = reflow_cursor_col
        terminal->cursor_row = reflow_cursor_row
    }
    terminal->cursor_col = terminal_clamp_int(
    terminal->cursor_col, 0, cols - 1)
    terminal->cursor_row = terminal_clamp_int(
    terminal->cursor_row, 0, rows - 1)
    if scrollback_reflow_needed != 0 &&
    scrollback_allocated_early == 0 {
        terminal->scrollback = nil
        terminal->scrollback_wrapped = nil
        terminal->scrollback_count = 0
        terminal->scrollback_head = 0
        terminal->scrollback_capacity = 0
    }
    terminal_reset_tab_stops(terminal)
    allocated: i32 = scrollback_allocated_early != 0 ? 1
    : terminal_allocate_scrollback(terminal)
    if allocated != 0 && scrollback_reflow_needed != 0 {
        reflow_scrollback(terminal, old_scrollback,
        old_scrollback_wrapped, old_cols, old_scrollback_count,
        old_scrollback_head, old_scrollback_capacity)
        free(old_scrollback)
        free(old_scrollback_wrapped)
    } else if combined_reflowed != 0 {
        free(old_scrollback)
        free(old_scrollback_wrapped)
    } else if allocated == 0 && scrollback_reflow_needed != 0 {
        terminal->scrollback = old_scrollback
        terminal->scrollback_wrapped = old_scrollback_wrapped
        terminal->scrollback_count = old_scrollback_count
        terminal->scrollback_head = old_scrollback_head
        terminal->scrollback_capacity = old_scrollback_capacity
    }
    return allocated
}

terminal_scroll_up :: (terminal: *TerminalState, top: i32,
bottom: i32, count: i32) #export {
    cells: *Cell = terminal_screen_cells(terminal)
    wrapped: *unsigned char = terminal_screen_wrapped(terminal)

    if terminal == nil || cells == nil { return }
    top = terminal_clamp_int(top, 0, terminal->rows - 1)
    bottom = terminal_clamp_int(bottom, 0, terminal->rows - 1)
    if top > bottom { return }
    rows: i32 = bottom - top + 1
    count = terminal_clamp_int(count, 1, rows)
    i: i32 = 0
    while i < count {
        terminal_push_scrollback(terminal,
        cells + (top + i) * terminal->cols,
        wrapped != nil ? wrapped[top + i] : 0)
        i += 1
    }
    terminal_sixel_shift(terminal, top, bottom, -count)
    if rows > count {
        memmove(cells + top * terminal->cols,
        cells + (top + count) * terminal->cols,
        (size_t)(rows - count) * terminal->cols * sizeof(Cell))
        if wrapped != nil {
            memmove(wrapped + top, wrapped + top + count,
            (size_t)(rows - count))
        }
    }
    i = bottom - count + 1
    while i <= bottom {
        terminal_clear_row(terminal, i)
        i += 1
    }
}

terminal_scroll_down :: (terminal: *TerminalState, top: i32,
bottom: i32, count: i32) #export {
    cells: *Cell = terminal_screen_cells(terminal)
    wrapped: *unsigned char = terminal_screen_wrapped(terminal)

    if terminal == nil || cells == nil { return }
    top = terminal_clamp_int(top, 0, terminal->rows - 1)
    bottom = terminal_clamp_int(bottom, 0, terminal->rows - 1)
    if top > bottom { return }
    rows: i32 = bottom - top + 1
    count = terminal_clamp_int(count, 1, rows)
    terminal_sixel_shift(terminal, top, bottom, count)
    if rows > count {
        memmove(cells + (top + count) * terminal->cols,
        cells + top * terminal->cols,
        (size_t)(rows - count) * terminal->cols * sizeof(Cell))
        if wrapped != nil {
            memmove(wrapped + top + count, wrapped + top,
            (size_t)(rows - count))
        }
    }
    i: i32 = top
    while i < top + count {
        terminal_clear_row(terminal, i)
        i += 1
    }
}

terminal_clamp_cursor :: (terminal: *TerminalState) #export {
    if terminal == nil { return }
    terminal->cursor_col = terminal_clamp_int(
    terminal->cursor_col, 0, terminal->cols - 1)
    if terminal->origin_mode != 0 {
        terminal->cursor_row = terminal_clamp_int(
        terminal->cursor_row, terminal->scroll_top,
        terminal->scroll_bottom)
    } else {
        terminal->cursor_row = terminal_clamp_int(
        terminal->cursor_row, 0, terminal->rows - 1)
    }
}

terminal_erase_range :: (terminal: *TerminalState, start: i32,
end: i32) #export {
    cells: *Cell = terminal_screen_cells(terminal)

    if terminal == nil || cells == nil { return }
    limit: i32 = terminal->cols * terminal->rows
    start = terminal_clamp_int(start, 0, limit)
    end = terminal_clamp_int(end, 0, limit)
    if start >= end { return }
    terminal_sixel_clear_range(terminal, start, end)
    blank: Cell = terminal_blank_cell(terminal)
    i: i32 = start
    while i < end {
        cells[i] = blank
        i += 1
    }
}

terminal_insert_blank_chars :: (terminal: *TerminalState,
count: i32) #export {
    cells: *Cell = terminal_screen_cells(terminal)

    if terminal == nil || cells == nil { return }
    available: i32 = terminal->cols - terminal->cursor_col
    count = terminal_clamp_int(count, 1, available)
    row_start: i32 = terminal->cursor_row * terminal->cols
    if available > count {
        memmove(cells + row_start + terminal->cursor_col + count,
        cells + row_start + terminal->cursor_col,
        (size_t)(available - count) * sizeof(Cell))
    }
    blank: Cell = terminal_blank_cell(terminal)
    col: i32 = 0
    while col < count {
        cells[row_start + terminal->cursor_col + col] = blank
        col += 1
    }
}

terminal_delete_chars :: (terminal: *TerminalState,
count: i32) #export {
    cells: *Cell = terminal_screen_cells(terminal)

    if terminal == nil || cells == nil { return }
    available: i32 = terminal->cols - terminal->cursor_col
    count = terminal_clamp_int(count, 1, available)
    row_start: i32 = terminal->cursor_row * terminal->cols
    if available > count {
        memmove(cells + row_start + terminal->cursor_col,
        cells + row_start + terminal->cursor_col + count,
        (size_t)(available - count) * sizeof(Cell))
    }
    blank: Cell = terminal_blank_cell(terminal)
    col: i32 = terminal->cols - count
    while col < terminal->cols {
        cells[row_start + col] = blank
        col += 1
    }
}

terminal_erase_chars :: (terminal: *TerminalState,
count: i32) #export {
    if terminal == nil { return }
    available: i32 = terminal->cols - terminal->cursor_col
    count = terminal_clamp_int(count, 1, available)
    terminal_erase_range(terminal,
    terminal->cursor_row * terminal->cols +
    terminal->cursor_col,
    terminal->cursor_row * terminal->cols +
    terminal->cursor_col + count)
}

terminal_next_tab_stop :: (
terminal: *const TerminalState) -> i32 #export {
    if terminal == nil { return 0 }
    col: i32 = terminal->cursor_col + 1
    while col < terminal->cols {
        if terminal->tab_stops != nil &&
        terminal->tab_stops[col] != 0 {
            return col
        }
        col += 1
    }
    return terminal->cols - 1
}
