#module "sixel"
#inspect off
#import "terminal_sixel.h"
#import "stdlib.h"
#import "string.h"

clamp_sixel_int :: (value: i32, low: i32, high: i32) -> i32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

remove_sixel_image :: (terminal: *TerminalState, index: i32) {
    if terminal == nil || index < 0 || index >= terminal->sixel_count {
        return
    }
    image: *SixelImage = terminal->sixel_images + index
    if image->pixels != nil {
        terminal->sixel_total_pixels -= image->width * image->height
        if terminal->sixel_total_pixels < 0 {
            terminal->sixel_total_pixels = 0
        }
        free(image->pixels)
    }
    if index + 1 < terminal->sixel_count {
        memmove(terminal->sixel_images + index,
        terminal->sixel_images + index + 1,
        (size_t)(terminal->sixel_count - index - 1) *
        sizeof(SixelImage))
    }
    terminal->sixel_count -= 1
}

terminal_sixel_clear_images :: (terminal: *TerminalState,
alternate_filter: i32) #export {
    if terminal == nil { return }
    i: i32 = terminal->sixel_count - 1
    while i >= 0 {
        if alternate_filter < 0 ||
        terminal->sixel_images[i].alternate_screen ==
        alternate_filter {
            remove_sixel_image(terminal, i)
        }
        i -= 1
    }
}

sixel_image_intersects_range :: (terminal: *const TerminalState,
image: *const SixelImage, start: i32, end: i32) -> i32 {
    if terminal == nil || image == nil || terminal->cols <= 0 ||
    image->alternate_screen != terminal->alternate_screen ||
    start >= end {
        return 0
    }
    rows_used: i32 = (image->height + 5) / 6
    cols_used: i32 = (image->width + 5) / 6
    if rows_used < 1 { rows_used = 1 }
    if cols_used < 1 { cols_used = 1 }
    row: i32 = image->row
    while row < image->row + rows_used {
        if row < 0 || row >= terminal->rows {
            row += 1
            continue
        }
        row_start: i32 = row * terminal->cols + image->col
        row_end: i32 = row_start + cols_used

        if row_start < row * terminal->cols {
            row_start = row * terminal->cols
        }
        if row_end > (row + 1) * terminal->cols {
            row_end = (row + 1) * terminal->cols
        }
        if end > row_start && start < row_end {
            return 1
        }
        row += 1
    }
    return 0
}

terminal_sixel_prune_scrollback :: (terminal: *TerminalState) #export {
    if terminal == nil { return }
    i: i32 = terminal->sixel_count - 1
    while i >= 0 {
        image: *SixelImage = terminal->sixel_images + i

        if image->alternate_screen != 0 || image->row >= 0 {
            i -= 1
            continue
        }
        if image->row < -terminal->scrollback_count {
            remove_sixel_image(terminal, i)
        }
        i -= 1
    }
}

terminal_sixel_clear_range :: (terminal: *TerminalState, start: i32,
end: i32) #export {
    if terminal == nil { return }
    start = clamp_sixel_int(start, 0, terminal->cols * terminal->rows)
    end = clamp_sixel_int(end, 0, terminal->cols * terminal->rows)
    if start >= end { return }
    i: i32 = terminal->sixel_count - 1
    while i >= 0 {
        if sixel_image_intersects_range(terminal,
        terminal->sixel_images + i, start, end) != 0 {
            remove_sixel_image(terminal, i)
        }
        i -= 1
    }
}

terminal_sixel_shift :: (terminal: *TerminalState, top: i32,
bottom: i32, delta: i32) #export {
    if terminal == nil || delta == 0 { return }
    i: i32 = terminal->sixel_count - 1
    while i >= 0 {
        image: *SixelImage = terminal->sixel_images + i
        in_scrollback: i32 = (delta < 0 && top == 0 &&
        terminal->alternate_screen == 0 &&
        image->alternate_screen == 0 && image->row < 0) ? 1 : 0

        if image->alternate_screen != terminal->alternate_screen {
            i -= 1
            continue
        }
        if in_scrollback == 0 &&
        (image->row < top || image->row > bottom) {
            i -= 1
            continue
        }
        image->row += delta
        if image->row < top || image->row > bottom {
            if delta < 0 && top == 0 &&
            terminal->alternate_screen == 0 &&
            image->alternate_screen == 0 && image->row < 0 &&
            image->row >= -terminal->scrollback_count {
                i -= 1
                continue
            }
            remove_sixel_image(terminal, i)
        }
        i -= 1
    }
}

add_sixel_image :: (terminal: *TerminalState, pixels: *const int,
stride: i32, width: i32, height: i32, pixel_aspect_num: i32,
pixel_aspect_den: i32) -> i32 {
    if terminal == nil || pixels == nil || width <= 0 ||
    height <= 0 || stride < width {
        return 0
    }
    if (size_t)width * (size_t)height >
    (size_t)MAX_SIXEL_IMAGE_PIXELS {
        return 0
    }
    while terminal->sixel_count >= MAX_SIXEL_IMAGES ||
    terminal->sixel_total_pixels + width * height >
    MAX_SIXEL_TOTAL_PIXELS {
        remove_sixel_image(terminal, 0)
    }
    if terminal->sixel_count >= terminal->sixel_capacity {
        capacity: i32 = terminal->sixel_capacity > 0
        ? terminal->sixel_capacity * 2 : 8

        if capacity > MAX_SIXEL_IMAGES {
            capacity = MAX_SIXEL_IMAGES
        }
        images: *SixelImage = (SixelImage *)realloc(
        terminal->sixel_images,
        (size_t)capacity * sizeof(SixelImage))
        if images == nil { return 0 }
        terminal->sixel_images = images
        terminal->sixel_capacity = capacity
    }
    copy: *i32 = (int *)malloc((size_t)width *
    (size_t)height * sizeof(int))
    if copy == nil { return 0 }
    row: i32 = 0
    while row < height {
        memcpy(copy + row * width, pixels + row * stride,
        (size_t)width * sizeof(int))
        row += 1
    }
    terminal->sixel_images[terminal->sixel_count].col =
    terminal->cursor_col
    terminal->sixel_images[terminal->sixel_count].row =
    terminal->cursor_row
    terminal->sixel_images[terminal->sixel_count].alternate_screen =
    terminal->alternate_screen
    terminal->sixel_images[terminal->sixel_count].width = width
    terminal->sixel_images[terminal->sixel_count].height = height
    terminal->sixel_images[terminal->sixel_count].pixel_aspect_num =
    pixel_aspect_num > 0 ? pixel_aspect_num : 1
    terminal->sixel_images[terminal->sixel_count].pixel_aspect_den =
    pixel_aspect_den > 0 ? pixel_aspect_den : 1
    terminal->sixel_images[terminal->sixel_count].pixels = copy
    terminal->sixel_count += 1
    terminal->sixel_total_pixels += width * height
    return 1
}

terminal_sixel_finish :: (terminal: *TerminalState,
payload: const char*) -> i32 #export {
    image: TerminalPaneSixelImage
    rows_used: i32 = 0

    if terminal == nil || payload == nil { return 0 }
    rows_used = DecodeTerminalPaneSixel(&image, payload,
    COLOR_TRUE_RGB, nil, nil)
    if rows_used > 0 &&
    add_sixel_image(terminal, image.pixels, image.width,
    image.width, image.height, image.pixel_aspect_num,
    image.pixel_aspect_den) == 0 {
        rows_used = 0
    }
    FreeTerminalPaneSixelImage(&image)
    return rows_used
}
