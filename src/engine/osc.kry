#module "osc"
#inspect off
#import "terminal_osc.h"
#import "stdio.h"
#import "string.h"

write_osc52_response :: (userdata: *void, text: const char*,
size: i32) -> i32 #export {
    terminal: *TerminalState = (TerminalState *)userdata

    if terminal == nil || text == nil || size <= 0 { return 0 }
    return terminal_write(terminal, text, size)
}

terminal_default_palette_color :: (index: i32) -> i32 #export {
    return TerminalPaneDefaultPaletteColor(index)
}

find_or_add_hyperlink :: (terminal: *TerminalState, id: const char*,
url: const char*) -> i32 {
    if terminal == nil || url == nil || url[0] == '\0' { return 0 }
    if id == nil { id = "" }
    i: i32 = 0
    while i < terminal->hyperlink_count {
        if id[0] != '\0' {
            if strcmp(terminal->hyperlink_ids[i], id) == 0 &&
            strcmp(terminal->hyperlinks[i], url) == 0 {
                return i + 1
            }
        } else if terminal->hyperlink_ids[i][0] == '\0' &&
        strcmp(terminal->hyperlinks[i], url) == 0 {
            return i + 1
        }
        i += 1
    }
    if terminal->hyperlink_count >= MAX_HYPERLINKS {
        return terminal->hyperlink_count
    }
    snprintf(terminal->hyperlink_ids[terminal->hyperlink_count],
    sizeof(terminal->hyperlink_ids[terminal->hyperlink_count]),
    "%s", id)
    snprintf(terminal->hyperlinks[terminal->hyperlink_count],
    sizeof(terminal->hyperlinks[terminal->hyperlink_count]),
    "%s", url)
    terminal->hyperlink_count += 1
    return terminal->hyperlink_count
}

send_osc_color_response :: (terminal: *TerminalState, code: i32,
color: i32) -> i32 {
    response: [64]char

    if terminal == nil { return 0 }
    len: i32 = FormatTerminalPaneOSCColorResponse(response,
    (int)sizeof(response), code, color)
    if len <= 0 || len >= (int)sizeof(response) { return 0 }
    return terminal_write_text(terminal, response)
}

send_osc_palette_response :: (terminal: *TerminalState, index: i32,
color: i32) -> i32 {
    response: [80]char

    if terminal == nil { return 0 }
    len: i32 = FormatTerminalPaneOSCPaletteResponse(response,
    (int)sizeof(response), index, color)
    if len <= 0 || len >= (int)sizeof(response) { return 0 }
    return terminal_write_text(terminal, response)
}

terminal_osc_color_state :: (
terminal: *const TerminalState) -> TerminalPaneOSCColorState {
    state: TerminalPaneOSCColorState = (TerminalPaneOSCColorState){0}

    if terminal == nil { return state }
    state.foreground = terminal->default_fg
    state.background = terminal->default_bg
    state.cursor = terminal->cursor_color
    state.mouse_foreground = terminal->mouse_fg
    state.mouse_background = terminal->mouse_bg
    state.selection_foreground = terminal->selection_fg
    state.selection_background = terminal->selection_bg
    state.base_foreground = terminal->base_fg
    state.base_background = terminal->base_bg
    state.base_cursor = terminal->base_cursor_color
    state.base_selection_foreground = terminal->base_selection_fg
    state.base_selection_background = terminal->base_selection_bg
    return state
}

terminal_osc_color_slot :: (terminal: *TerminalState,
target: i32) -> *i32 {
    if terminal == nil { return nil }
    if target == TERMINAL_PANE_OSC_COLOR_FOREGROUND {
        return &terminal->default_fg
    }
    if target == TERMINAL_PANE_OSC_COLOR_BACKGROUND {
        return &terminal->default_bg
    }
    if target == TERMINAL_PANE_OSC_COLOR_CURSOR {
        return &terminal->cursor_color
    }
    if target == TERMINAL_PANE_OSC_COLOR_MOUSE_FOREGROUND {
        return &terminal->mouse_fg
    }
    if target == TERMINAL_PANE_OSC_COLOR_MOUSE_BACKGROUND {
        return &terminal->mouse_bg
    }
    if target == TERMINAL_PANE_OSC_COLOR_SELECTION_BACKGROUND {
        return &terminal->selection_bg
    }
    if target == TERMINAL_PANE_OSC_COLOR_SELECTION_FOREGROUND {
        return &terminal->selection_fg
    }
    return nil
}

terminal_send_title_report :: (terminal: *TerminalState,
icon: i32) -> i32 #export {
    response: [320]char

    if terminal == nil { return 0 }
    len: i32 = FormatTerminalPaneOSCTitleReport(response,
    (int)sizeof(response), icon,
    icon != 0 ? terminal->icon_title : terminal->title)
    if len <= 0 || len >= (int)sizeof(response) { return 0 }
    return terminal_write_text(terminal, response)
}

terminal_push_title_targets :: (terminal: *TerminalState,
target: i32) #export {
    if terminal == nil { return }
    if target == 0 || target == 2 {
        TerminalPaneOSCPushTitle(
        (char *)terminal->title_stack, TITLE_STACK_DEPTH,
        (int)sizeof(terminal->title_stack[0]),
        &terminal->title_stack_count, terminal->title)
    }
    if target == 0 || target == 1 {
        TerminalPaneOSCPushTitle(
        (char *)terminal->icon_title_stack, TITLE_STACK_DEPTH,
        (int)sizeof(terminal->icon_title_stack[0]),
        &terminal->icon_title_stack_count, terminal->icon_title)
    }
}

terminal_pop_title_targets :: (terminal: *TerminalState,
target: i32) #export {
    if terminal == nil { return }
    if target == 0 || target == 2 {
        TerminalPaneOSCPopTitle(
        (char *)terminal->title_stack, TITLE_STACK_DEPTH,
        (int)sizeof(terminal->title_stack[0]),
        &terminal->title_stack_count, terminal->title,
        (int)sizeof(terminal->title))
    }
    if target == 0 || target == 1 {
        TerminalPaneOSCPopTitle(
        (char *)terminal->icon_title_stack, TITLE_STACK_DEPTH,
        (int)sizeof(terminal->icon_title_stack[0]),
        &terminal->icon_title_stack_count, terminal->icon_title,
        (int)sizeof(terminal->icon_title))
    }
}

push_titles :: (terminal: *TerminalState, payload: const char*) {
    window: i32
    icon: i32

    if terminal == nil { return }
    TerminalPaneOSCTitleTargets(payload, &window, &icon)
    if window != 0 && icon != 0 {
        terminal_push_title_targets(terminal, 0)
    } else if icon != 0 {
        terminal_push_title_targets(terminal, 1)
    } else if window != 0 {
        terminal_push_title_targets(terminal, 2)
    }
}

pop_titles :: (terminal: *TerminalState, payload: const char*) {
    window: i32
    icon: i32

    if terminal == nil { return }
    TerminalPaneOSCTitleTargets(payload, &window, &icon)
    if window != 0 && icon != 0 {
        terminal_pop_title_targets(terminal, 0)
    } else if icon != 0 {
        terminal_pop_title_targets(terminal, 1)
    } else if window != 0 {
        terminal_pop_title_targets(terminal, 2)
    }
}

terminal_finish_osc :: (terminal: *TerminalState) #export {
    payload: *const char
    code: i32

    if terminal == nil { return }
    terminal->osc[sizeof(terminal->osc) - 1] = '\0'
    if ParseTerminalPaneOSCCommand(terminal->osc, &code,
    &payload) == 0 {
        return
    }
    if code == 0 || code == 2 {
        CopyTerminalPaneTitleText(terminal->title,
        (int)sizeof(terminal->title), payload)
        if code == 2 { return }
    }
    if code == 0 || code == 1 {
        CopyTerminalPaneTitleText(terminal->icon_title,
        (int)sizeof(terminal->icon_title), payload)
        return
    }
    if code == 7 {
        DecodeTerminalPaneOSCFileURIPath(
        terminal->current_directory,
        (int)sizeof(terminal->current_directory), payload)
        return
    }
    if code == 22 {
        push_titles(terminal, payload)
        return
    }
    if code == 23 {
        pop_titles(terminal, payload)
        return
    }
    {
        target: i32 = TerminalPaneOSCColorTargetForCode(code)
        slot: *i32 = terminal_osc_color_slot(terminal, target)

        if slot != nil {
            if payload[0] == '?' {
                color: i32 = TerminalPaneOSCColorQueryValue(
                target, terminal_osc_color_state(terminal))
                send_osc_color_response(terminal, code, color)
                return
            }
            color: i32 = ParseTerminalPaneOSCColor(payload)
            if color == COLOR_DEFAULT { return }
            *slot = color
            return
        }
    }
    {
        target: i32 = TerminalPaneOSCColorTargetForResetCode(code)
        slot: *i32 = terminal_osc_color_slot(terminal, target)

        if slot != nil {
            *slot = COLOR_DEFAULT
            return
        }
    }
    if code == 4 {
        cursor: *const char = payload
        entry: TerminalPaneOSCPaletteEntry

        while NextTerminalPaneOSCPaletteEntry(&cursor, &entry) != 0 {
            if entry.valid == 0 { continue }
            if entry.query != 0 {
                value: i32 = terminal->palette_overrides[entry.index]

                if value == COLOR_DEFAULT {
                    value = terminal_default_palette_color(
                    entry.index)
                }
                send_osc_palette_response(terminal, entry.index,
                value)
            } else {
                terminal->palette_overrides[entry.index] =
                entry.color
            }
        }
        return
    }
    if code == 104 {
        cursor: *const char = payload
        index: i32

        if cursor[0] == '\0' {
            i: i32 = 0
            while i < 256 {
                terminal->palette_overrides[i] = COLOR_DEFAULT
                i += 1
            }
            return
        }
        while NextTerminalPaneOSCPaletteResetIndex(&cursor,
        &index) != 0 {
            if index >= 0 {
                terminal->palette_overrides[index] =
                COLOR_DEFAULT
            }
        }
        return
    }
    if code == 8 {
        safe_id: [HYPERLINK_ID_SIZE]char
        safe_url: [HYPERLINK_SIZE]char
        url: const char* = strchr(payload, ';')

        if url == nil { return }
        url += 1
        if url[0] == '\0' {
            terminal->current_hyperlink = 0
            return
        }
        if CopyTerminalPaneOSCHyperlinkURL(safe_url,
        (int)sizeof(safe_url), url) == 0 {
            return
        }
        CopyTerminalPaneOSCHyperlinkID(safe_id,
        (int)sizeof(safe_id), payload)
        terminal->current_hyperlink =
        find_or_add_hyperlink(terminal, safe_id, safe_url)
        return
    }
    if code == 52 {
        HandleClipboardOSC52(&terminal->clipboard, payload,
        write_osc52_response, terminal)
    }
}
