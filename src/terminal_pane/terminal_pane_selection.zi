#import "terminal_clipboard"

TERMINAL_PANE_SELECTION_CHAR :: 0;
TERMINAL_PANE_SELECTION_WORD :: 1;
TERMINAL_PANE_SELECTION_LINE :: 2;

TerminalPaneSelectionLineFn :: #type (userdata: *void, row: s32,
    out: *u8, out_size: s32) -> s32 #c_call;
TerminalPaneSelectionWrappedFn :: #type (
    userdata: *void, row: s32) -> s32 #c_call;

TerminalPaneSelection :: struct {
    active: s32
    dragging: s32
    mode: s32
    start_row: s32
    start_col: s32
    end_row: s32
    end_col: s32
    anchor_row: s32
    anchor_start_col: s32
    anchor_end_col: s32
}

TerminalPaneSearchMatch :: struct {
    row: s32
    col: s32
    length: s32
}

TerminalPaneSearchStart :: struct {
    row: s32
    col: s32
}

TerminalPaneSearchController :: struct {
    line_text: TerminalPaneSelectionLineFn
    userdata: *void
    selection: *TerminalPaneSelection
    total_rows: s32
    visible_rows: s32
    first_visible_row: s32
    scroll_offset: *s32
}

#scope_file
primary_selection_copy_buffer: [262144]u8;
clipboard_selection_copy_buffer: [262144]u8;

ClampInt :: (value: s32, low: s32, high: s32) -> s32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

MaxInt :: (left: s32, right: s32) -> s32 {
    if left > right { return left }
    return right
}

TextLength :: (text: *u8) -> s32 {
    length: s32 = 0
    if text == null { return 0 }
    while text[length] != 0 { length += 1 }
    return length
}

WordChar :: (value: u8) -> bool {
    if value >= 48 && value <= 57 { return true }
    if value >= 65 && value <= 90 { return true }
    if value >= 97 && value <= 122 { return true }
    return value == 95 || value == 45 || value == 46 ||
        value == 47 || value == 58 || value == 126
}

WordBounds :: (line: *u8, length: s32, col: s32,
    start: *s32, end: *s32) {
    left: s32 = col
    right: s32 = col + 1
    if start != null { start.* = col }
    if end != null { end.* = col + 1 }
    if line == null || length <= 0 { return }
    col = ClampInt(col, 0, MaxInt(0, length))
    if col >= length { col = length - 1 }
    if !WordChar(line[col]) { return }
    left = col
    right = col + 1
    while left > 0 && WordChar(line[left - 1]) { left -= 1 }
    while right < length && WordChar(line[right]) { right += 1 }
    if start != null { start.* = left }
    if end != null { end.* = right }
}

LineText :: (line_text: TerminalPaneSelectionLineFn, userdata: *void,
    row: s32, out: *u8, out_size: s32) -> s32 {
    if out == null || out_size <= 0 { return 0 }
    out[0] = 0
    if line_text == null { return 0 }
    return line_text(userdata, row, out, out_size)
}

LowerByte :: (value: u8) -> u8 {
    if value >= 65 && value <= 90 { return value + 32 }
    return value
}

SearchCaseSensitive :: (needle: *u8) -> bool {
    index: s32 = 0
    if needle == null { return false }
    while needle[index] != 0 {
        if needle[index] >= 65 && needle[index] <= 90 { return true }
        index += 1
    }
    return false
}

SearchBytesEqual :: (left: u8, right: u8, case_sensitive: bool) -> bool {
    if case_sensitive { return left == right }
    return LowerByte(left) == LowerByte(right)
}

SearchFindFrom :: (line: *u8, start: s32, needle: *u8,
    case_sensitive: bool) -> s32 {
    needle_length: s32 = TextLength(needle)
    cursor: s32 = start
    index: s32
    if line == null || needle == null || needle_length <= 0 || start < 0 {
        return -1
    }
    while line[cursor] != 0 {
        index = 0
        while index < needle_length {
            if line[cursor + index] == 0 ||
               !SearchBytesEqual(line[cursor + index], needle[index],
                   case_sensitive) { break }
            index += 1
        }
        if index == needle_length { return cursor }
        cursor += 1
    }
    return -1
}

SearchLastBefore :: (line: *u8, needle: *u8, limit: s32,
    case_sensitive: bool) -> s32 {
    needle_length: s32 = TextLength(needle)
    cursor: s32 = 0
    last: s32 = -1
    match: s32
    if line == null || needle == null || needle_length <= 0 { return -1 }
    while true {
        match = SearchFindFrom(line, cursor, needle, case_sensitive)
        if match < 0 { break }
        if match + needle_length > limit { break }
        last = match
        cursor = match + 1
    }
    return last
}

#scope_export

#program_export
TerminalPaneSelectionClear :: (selection: *TerminalPaneSelection) {
    if selection == null { return }
    selection.* = TerminalPaneSelection.{}
}

#program_export
TerminalPaneSelectionSetRange :: (selection: *TerminalPaneSelection,
    mode: s32, dragging: s32, start_row: s32, start_col: s32,
    end_row: s32, end_col: s32) {
    if selection == null { return }
    selection.active = 1
    if dragging != 0 { selection.dragging = 1 } else { selection.dragging = 0 }
    selection.mode = mode
    selection.start_row = start_row
    selection.start_col = start_col
    selection.end_row = end_row
    selection.end_col = end_col
    selection.anchor_row = start_row
    selection.anchor_start_col = start_col
    selection.anchor_end_col = end_col
}

#program_export
TerminalPaneSelectionBeginChar :: (selection: *TerminalPaneSelection,
    row: s32, col: s32) {
    TerminalPaneSelectionSetRange(selection,
        TERMINAL_PANE_SELECTION_CHAR, 1, row, col, row, col + 1)
}

#program_export
TerminalPaneSelectionSelectLine :: (selection: *TerminalPaneSelection,
    line_text: TerminalPaneSelectionLineFn, userdata: *void, row: s32) {
    line: [4096]u8
    if selection == null || row < 0 { return }
    LineText(line_text, userdata, row, *line[0], 4096)
    TerminalPaneSelectionSetRange(selection,
        TERMINAL_PANE_SELECTION_LINE, 1, row, 0, row, TextLength(*line[0]))
}

#program_export
TerminalPaneSelectionSelectWord :: (selection: *TerminalPaneSelection,
    line_text: TerminalPaneSelectionLineFn, userdata: *void,
    row: s32, col: s32) {
    line: [4096]u8
    length: s32
    start: s32 = 0
    end: s32 = 0
    if selection == null || row < 0 { return }
    LineText(line_text, userdata, row, *line[0], 4096)
    length = TextLength(*line[0])
    col = ClampInt(col, 0, MaxInt(0, length))
    if length == 0 {
        TerminalPaneSelectionSelectLine(selection, line_text, userdata, row)
        if selection != null { selection.mode = TERMINAL_PANE_SELECTION_WORD }
        return
    }
    WordBounds(*line[0], length, col, *start, *end)
    TerminalPaneSelectionSetRange(selection,
        TERMINAL_PANE_SELECTION_WORD, 1, row, start, row, end)
}

#program_export
TerminalPaneSelectionSelectAll :: (selection: *TerminalPaneSelection,
    total_rows: s32, cols: s32) {
    if selection == null || total_rows <= 0 { return }
    if cols < 0 { cols = 0 }
    TerminalPaneSelectionSetRange(selection,
        TERMINAL_PANE_SELECTION_CHAR, 0, 0, 0, total_rows - 1, cols)
}

#program_export
TerminalPaneSelectionUpdateEnd :: (selection: *TerminalPaneSelection,
    line_text: TerminalPaneSelectionLineFn, userdata: *void,
    row: s32, col: s32) {
    line: [4096]u8
    start_line: [4096]u8
    length: s32
    start: s32 = 0
    end: s32 = 0
    if selection == null || row < 0 { return }
    if selection.mode == TERMINAL_PANE_SELECTION_LINE {
        LineText(line_text, userdata, row, *line[0], 4096)
        length = TextLength(*line[0])
        if row < selection.start_row {
            LineText(line_text, userdata, selection.start_row,
                *start_line[0], 4096)
            selection.start_col = TextLength(*start_line[0])
            selection.end_col = 0
        } else {
            selection.start_col = 0
            selection.end_col = length
        }
        selection.end_row = row
        return
    }
    if selection.mode == TERMINAL_PANE_SELECTION_WORD {
        LineText(line_text, userdata, row, *line[0], 4096)
        length = TextLength(*line[0])
        col = ClampInt(col, 0, MaxInt(0, length))
        WordBounds(*line[0], length, col, *start, *end)
        if row < selection.anchor_row ||
           (row == selection.anchor_row && start < selection.anchor_start_col) {
            selection.start_row = selection.anchor_row
            selection.start_col = selection.anchor_end_col
            selection.end_row = row
            selection.end_col = start
        } else {
            selection.start_row = selection.anchor_row
            selection.start_col = selection.anchor_start_col
            selection.end_row = row
            selection.end_col = end
        }
        return
    }
    selection.end_row = row
    selection.end_col = col + 1
}

#program_export
TerminalPaneSelectionContains :: (selection: *TerminalPaneSelection,
    row: s32, col: s32) -> s32 {
    start_row: s32
    end_row: s32
    start_col: s32
    end_col: s32
    temporary: s32
    if selection == null || selection.active == 0 { return 0 }
    start_row = selection.start_row
    end_row = selection.end_row
    start_col = selection.start_col
    end_col = selection.end_col
    if start_row > end_row || (start_row == end_row && start_col > end_col) {
        temporary = start_row
        start_row = end_row
        end_row = temporary
        temporary = start_col
        start_col = end_col
        end_col = temporary
    }
    if row < start_row || row > end_row { return 0 }
    if row == start_row && col < start_col { return 0 }
    if row == end_row && col >= end_col { return 0 }
    return 1
}

#program_export
TerminalPaneSelectionCollectText :: (selection: *TerminalPaneSelection,
    line_text: TerminalPaneSelectionLineFn,
    line_wrapped: TerminalPaneSelectionWrappedFn, userdata: *void,
    buffer: *u8, buffer_size: s32) -> s32 {
    start_row: s32
    end_row: s32
    start_col: s32
    end_col: s32
    temporary: s32
    used: s32 = 0
    row: s32
    if buffer == null || buffer_size <= 0 { return 0 }
    buffer[0] = 0
    if selection == null || selection.active == 0 || line_text == null {
        return 0
    }
    start_row = selection.start_row
    end_row = selection.end_row
    start_col = selection.start_col
    end_col = selection.end_col
    if start_row > end_row || (start_row == end_row && start_col > end_col) {
        temporary = start_row
        start_row = end_row
        end_row = temporary
        temporary = start_col
        start_col = end_col
        end_col = temporary
    }
    row = start_row
    while row <= end_row && used < buffer_size - 1 {
        line: [4096]u8
        length: s32
        start: s32
        end: s32
        index: s32
        LineText(line_text, userdata, row, *line[0], 4096)
        length = TextLength(*line[0])
        if row == start_row { start = start_col } else { start = 0 }
        if row == end_row { end = end_col } else { end = length }
        start = ClampInt(start, 0, length)
        end = ClampInt(end, start, length)
        index = start
        while index < end && used < buffer_size - 1 {
            buffer[used] = line[index]
            used += 1
            index += 1
        }
        if row != end_row && used < buffer_size - 1 &&
           (line_wrapped == null || line_wrapped(userdata, row) == 0) {
            buffer[used] = 10
            used += 1
        }
        row += 1
    }
    buffer[used] = 0
    if used > 0 { return 1 }
    return 0
}

#program_export
TerminalPaneSelectionUpdatePrimary :: (selection: *TerminalPaneSelection,
    line_text: TerminalPaneSelectionLineFn,
    line_wrapped: TerminalPaneSelectionWrappedFn, userdata: *void) -> s32 {
    empty: [1]u8
    empty[0] = 0
    if TerminalPaneSelectionCollectText(selection, line_text, line_wrapped,
            userdata, *primary_selection_copy_buffer[0], 262144) != 0 {
        return SetPrimarySelectionFromText(*primary_selection_copy_buffer[0])
    }
    return SetPrimarySelectionFromText(*empty[0])
}

#program_export
TerminalPaneSelectionCopyToClipboard :: (selection: *TerminalPaneSelection,
    line_text: TerminalPaneSelectionLineFn,
    line_wrapped: TerminalPaneSelectionWrappedFn, userdata: *void,
    clipboard: *void) -> s32 {
    if TerminalPaneSelectionCollectText(selection, line_text, line_wrapped,
            userdata, *clipboard_selection_copy_buffer[0], 262144) == 0 {
        return 0
    }
    return CopySelectionTextToClipboard(clipboard,
        *clipboard_selection_copy_buffer[0])
}

#program_export
TerminalPaneSelectionEdgeScrollDelta :: (mouse_y: float32, viewport_y: float32,
    viewport_height: float32, edge_size: float32) -> s32 {
    if viewport_height <= 0.0 { return 0 }
    if edge_size < 0.0 { edge_size = 0.0 }
    if edge_size > viewport_height / 2.0 { edge_size = viewport_height / 2.0 }
    if mouse_y < viewport_y + edge_size { return 1 }
    if mouse_y > viewport_y + viewport_height - edge_size { return -1 }
    return 0
}

#program_export
TerminalPaneSelectionFirstVisibleRow :: (total_rows: s32, visible_rows: s32,
    scroll_offset: s32) -> s32 {
    first: s32
    if total_rows <= 0 || visible_rows <= 0 { return 0 }
    if scroll_offset < 0 { scroll_offset = 0 }
    first = total_rows - visible_rows - scroll_offset
    if first > 0 { return first }
    return 0
}

#program_export
TerminalPaneSelectionEdgeScrollRow :: (first_visible_row: s32,
    visible_rows: s32, scroll_delta: s32) -> s32 {
    if visible_rows <= 0 || scroll_delta == 0 { return -1 }
    if scroll_delta > 0 { return first_visible_row }
    return first_visible_row + visible_rows - 1
}

#program_export
TerminalPaneSearchLines :: (line_text: TerminalPaneSelectionLineFn,
    userdata: *void, total_rows: s32, needle: *u8, start_row: s32,
    start_col: s32, direction: s32, wrap: s32,
    out: *TerminalPaneSearchMatch) -> s32 {
    needle_length: s32 = TextLength(needle)
    case_sensitive: bool = SearchCaseSensitive(needle)
    pass: s32 = 0
    if out != null {
        out.row = -1
        out.col = -1
        out.length = 0
    }
    if line_text == null || total_rows <= 0 || needle == null ||
       needle[0] == 0 { return 0 }
    if direction >= 0 { direction = 1 } else { direction = -1 }
    if start_row < 0 || start_row >= total_rows {
        if direction > 0 { start_row = 0 } else { start_row = total_rows - 1 }
    }
    while pass < (ifx wrap != 0 then 2 else 1) {
        end_row: s32
        row: s32 = start_row
        if direction > 0 { end_row = total_rows } else { end_row = -1 }
        while row != end_row {
            line: [4096]u8
            line_length: s32
            col_limit: s32 = 0
            match: s32 = -1
            LineText(line_text, userdata, row, *line[0], 4096)
            line_length = TextLength(*line[0])
            if direction > 0 {
                if row == start_row { col_limit = start_col } else { col_limit = 0 }
                col_limit = ClampInt(col_limit, 0, line_length)
                match = SearchFindFrom(*line[0], col_limit, needle,
                    case_sensitive)
            } else {
                if row == start_row { col_limit = start_col } else { col_limit = line_length }
                col_limit = ClampInt(col_limit, 0, line_length)
                match = SearchLastBefore(*line[0], needle, col_limit,
                    case_sensitive)
            }
            if match >= 0 {
                if out != null {
                    out.row = row
                    out.col = match
                    out.length = needle_length
                }
                return 1
            }
            row += direction
        }
        if direction > 0 { start_row = 0 } else { start_row = total_rows - 1 }
        if direction > 0 { start_col = 0 } else { start_col = 4096 }
        pass += 1
    }
    return 0
}

#program_export
TerminalPaneSearchStartForDirection :: (selection: *TerminalPaneSelection,
    total_rows: s32, first_visible_row: s32,
    direction: s32) -> TerminalPaneSearchStart {
    start: TerminalPaneSearchStart = TerminalPaneSearchStart.{}
    if total_rows <= 0 {
        start.row = -1
        start.col = -1
        return start
    }
    if direction >= 0 { direction = 1 } else { direction = -1 }
    if selection != null && selection.active != 0 {
        if direction > 0 {
            start.row = selection.end_row
            start.col = selection.end_col
        } else {
            start.row = selection.start_row
            start.col = selection.start_col - 1
        }
    } else if direction > 0 {
        start.row = first_visible_row
        start.col = 0
    } else {
        start.row = total_rows - 1
        start.col = 4096
    }
    start.row = ClampInt(start.row, 0, total_rows - 1)
    return start
}

#program_export
TerminalPaneSearchMatchScrollOffset :: (total_rows: s32, visible_rows: s32,
    match_row: s32) -> s32 {
    max_scroll: s32
    if total_rows <= 0 || visible_rows <= 0 { return 0 }
    max_scroll = MaxInt(0, total_rows - visible_rows)
    match_row = ClampInt(match_row, 0, total_rows - 1)
    return ClampInt(total_rows - visible_rows - match_row, 0, max_scroll)
}

#program_export
MakeTerminalPaneSearchController :: (
    line_text: TerminalPaneSelectionLineFn, userdata: *void,
    selection: *TerminalPaneSelection, total_rows: s32, visible_rows: s32,
    first_visible_row: s32,
    scroll_offset: *s32) -> TerminalPaneSearchController {
    controller: TerminalPaneSearchController = TerminalPaneSearchController.{}
    controller.line_text = line_text
    controller.userdata = userdata
    controller.selection = selection
    controller.total_rows = total_rows
    controller.visible_rows = visible_rows
    controller.first_visible_row = first_visible_row
    controller.scroll_offset = scroll_offset
    return controller
}

#program_export
TerminalPaneSearchSelectMatch :: (controller: TerminalPaneSearchController,
    match: TerminalPaneSearchMatch) -> s32 {
    if match.row < 0 || match.col < 0 || match.length <= 0 { return 0 }
    if controller.scroll_offset != null {
        controller.scroll_offset.* = TerminalPaneSearchMatchScrollOffset(
            controller.total_rows, controller.visible_rows, match.row)
    }
    if controller.selection != null {
        TerminalPaneSelectionSetRange(controller.selection,
            TERMINAL_PANE_SELECTION_CHAR, 0, match.row, match.col,
            match.row, match.col + match.length)
    }
    return 1
}

#program_export
TerminalPaneSearchFindFrom :: (controller: TerminalPaneSearchController,
    needle: *u8, start_row: s32, start_col: s32, direction: s32, wrap: s32,
    out: *TerminalPaneSearchMatch) -> s32 {
    local_match: TerminalPaneSearchMatch
    if out == null { out = *local_match }
    if TerminalPaneSearchLines(controller.line_text, controller.userdata,
            controller.total_rows, needle, start_row, start_col, direction,
            wrap, out) == 0 { return 0 }
    return TerminalPaneSearchSelectMatch(controller, out.*)
}

#program_export
TerminalPaneSearchFindNext :: (controller: TerminalPaneSearchController,
    needle: *u8, direction: s32,
    out: *TerminalPaneSearchMatch) -> s32 {
    start: TerminalPaneSearchStart
    if direction >= 0 { direction = 1 } else { direction = -1 }
    start = TerminalPaneSearchStartForDirection(controller.selection,
        controller.total_rows, controller.first_visible_row, direction)
    return TerminalPaneSearchFindFrom(controller, needle, start.row,
        start.col, direction, 1, out)
}

#program_export
TerminalPaneSearchFindInitial :: (controller: TerminalPaneSearchController,
    needle: *u8, out: *TerminalPaneSearchMatch) -> s32 {
    return TerminalPaneSearchFindFrom(controller, needle,
        controller.total_rows - 1, 4096, -1, 0, out)
}
