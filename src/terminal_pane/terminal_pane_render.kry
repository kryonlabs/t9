#module "terminal_pane_render_host"
#inspect off
#import "terminal_pane.h"
#import "ui_text.h"

DrawTerminalPaneGlyphCell :: (codepoint: u32, combining: u32,
x: i32, y: i32, font_size: i32, color: Color) #export {
    RenderTextGlyph(codepoint, x, y, font_size, color)
    if combining != 0 {
        RenderTextGlyph(combining, x, y, font_size, color)
    }
}

DrawTerminalPaneGlyphGrid :: (grid: TerminalPaneGridDraw) #export {
    if grid.cells == nil || grid.cols <= 0 || grid.rows <= 0 ||
    grid.cell_width <= 0 || grid.line_height <= 0 ||
    grid.font_size <= 0 { return }
    row: i32 = 0
    while row < grid.rows {
        y: i32 = (int)grid.bounds.y + row * grid.line_height
        col: i32 = 0
        while col < grid.cols {
            cell: *const TerminalPaneGridCell =
            grid.cells + row * grid.cols + col
            x: i32 = (int)grid.bounds.x + col * grid.cell_width
            if (cell->flags & (TERMINAL_PANE_GRID_CELL_WIDE_CONT |
            TERMINAL_PANE_GRID_CELL_HIDDEN)) == 0 {
                DrawTerminalPaneGlyphCell(cell->codepoint,
                cell->combining, x, y, grid.font_size,
                cell->foreground)
            }
            col += 1
        }
        row += 1
    }
}
