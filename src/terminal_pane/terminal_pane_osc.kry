#module "terminal_pane_osc_host"
#inspect off
#import "terminal_pane.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"

osc_hex_value :: (ch: i32) -> i32 {
    if ch >= '0' && ch <= '9' { return ch - '0' }
    if ch >= 'a' && ch <= 'f' { return 10 + ch - 'a' }
    if ch >= 'A' && ch <= 'F' { return 10 + ch - 'A' }
    return -1
}

append_osc_safe_text :: (buffer: *char, buffer_size: i32, used: *i32,
text: const char*) -> i32 {
    cursor: const unsigned char* = (const unsigned char *)text

    if buffer == nil || buffer_size <= 0 || used == nil {
        return 0
    }
    if cursor == nil { cursor = (const unsigned char *)"" }
    while *cursor != '\0' {
        if *cursor == '\a' || *cursor == 0x1b ||
        (*cursor < 0x20 && *cursor != '\t') {
            cursor += 1
            continue
        }
        if *used + 1 >= buffer_size { return 0 }
        buffer[*used] = (char)*cursor
        *used += 1
        cursor += 1
    }
    buffer[*used] = '\0'
    return 1
}

parse_hex_byte :: (text: const char*, used: *i32) -> i32 {
    if text == nil || text[0] == '\0' { return -1 }
    hi: i32 = osc_hex_value((unsigned char)text[0])
    if hi < 0 { return -1 }
    lo: i32 = osc_hex_value((unsigned char)text[1])
    if lo < 0 {
        if used != nil { *used = 1 }
        return (hi << 4) | hi
    }
    if used != nil { *used = 2 }
    return (hi << 4) | lo
}

parse_hash_color_component :: (text: const char*, digits: i32) -> i32 {
    if text == nil || digits <= 0 { return -1 }
    hi: i32 = osc_hex_value((unsigned char)text[0])
    if hi < 0 { return -1 }
    if digits == 1 { return (hi << 4) | hi }
    lo: i32 = osc_hex_value((unsigned char)text[1])
    if lo < 0 { return -1 }
    return (hi << 4) | lo
}

parse_hash_color :: (text: const char*) -> i32 {
    len: i32 = 0

    if text == nil || text[0] != '#' {
        return TERMINAL_PANE_COLOR_DEFAULT
    }
    text += 1
    while text[len] != '\0' {
        if osc_hex_value((unsigned char)text[len]) < 0 {
            return TERMINAL_PANE_COLOR_DEFAULT
        }
        len += 1
    }
    if len < 3 || len > 12 || (len % 3) != 0 {
        return TERMINAL_PANE_COLOR_DEFAULT
    }
    digits: i32 = len / 3
    r: i32 = parse_hash_color_component(text, digits)
    g: i32 = parse_hash_color_component(text + digits, digits)
    b: i32 = parse_hash_color_component(text + digits * 2, digits)
    if r >= 0 && g >= 0 && b >= 0 {
        return TERMINAL_PANE_COLOR_TRUE_RGB |
        (r << 16) | (g << 8) | b
    }
    return TERMINAL_PANE_COLOR_DEFAULT
}

copy_osc_token :: (cursor: **const char, out: *char,
out_size: i32) -> i32 {
    used: i32 = 0

    if cursor == nil || *cursor == nil || **cursor == '\0' ||
    out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    start: const char* = *cursor
    while *start != '\0' && *start != ';' {
        if used + 1 < out_size {
            out[used] = *start
            used += 1
        }
        start += 1
    }
    out[used] = '\0'
    *cursor = *start == ';' ? start + 1 : start
    return 1
}

parse_decimal_span :: (start: const char*, end: const char*,
max_value: i32, out: *i32) -> i32 {
    value: i32 = 0

    if start == nil || end == nil || start == end || out == nil ||
    max_value < 0 { return 0 }
    while start < end {
        if *start < '0' || *start > '9' { return 0 }
        value = value * 10 + (*start - '0')
        if value > max_value { return 0 }
        start += 1
    }
    *out = value
    return 1
}

parse_palette_index_token :: (text: const char*, out: *i32) -> i32 {
    if text == nil { return 0 }
    end: const char* = text + strlen(text)
    return parse_decimal_span(text, end, 255, out)
}

parse_rgbi_component :: (cursor: **const char) -> i32 {
    if cursor == nil || *cursor == nil || **cursor == '\0' {
        return -1
    }
    end: *char
    value: float = strtod(*cursor, &end)
    if end == *cursor || value < 0.0 || value > 1.0 {
        return -1
    }
    *cursor = end
    return (int)(value * 255.0 + 0.5)
}

parse_rgbi_color :: (text: const char*) -> i32 {
    if text == nil || strncmp(text, "rgbi:", 5) != 0 {
        return TERMINAL_PANE_COLOR_DEFAULT
    }
    cursor: const char* = text + 5
    r: i32 = parse_rgbi_component(&cursor)
    if r < 0 || *cursor != '/' {
        return TERMINAL_PANE_COLOR_DEFAULT
    }
    cursor += 1
    g: i32 = parse_rgbi_component(&cursor)
    if g < 0 || *cursor != '/' {
        return TERMINAL_PANE_COLOR_DEFAULT
    }
    cursor += 1
    b: i32 = parse_rgbi_component(&cursor)
    if b < 0 || *cursor != '\0' {
        return TERMINAL_PANE_COLOR_DEFAULT
    }
    return TERMINAL_PANE_COLOR_TRUE_RGB |
    (r << 16) | (g << 8) | b
}

ParseTerminalPaneOSCColor :: (text: const char*) -> i32 #export {
    used: i32 = 0

    if text == nil { return TERMINAL_PANE_COLOR_DEFAULT }
    if text[0] == '#' { return parse_hash_color(text) }
    if strncmp(text, "rgbi:", 5) == 0 {
        return parse_rgbi_color(text)
    }
    if strncmp(text, "rgb:", 4) == 0 ||
    strncmp(text, "rgba:", 5) == 0 {
        cursor: const char* = strchr(text, ':')
        r: i32
        g: i32
        b: i32

        if cursor == nil { return TERMINAL_PANE_COLOR_DEFAULT }
        cursor += 1
        r = parse_hex_byte(cursor, &used)
        cursor = strchr(cursor, '/')
        if cursor == nil { return TERMINAL_PANE_COLOR_DEFAULT }
        cursor += 1
        g = parse_hex_byte(cursor, &used)
        cursor = strchr(cursor, '/')
        if cursor == nil { return TERMINAL_PANE_COLOR_DEFAULT }
        cursor += 1
        b = parse_hex_byte(cursor, &used)
        if r >= 0 && g >= 0 && b >= 0 {
            return TERMINAL_PANE_COLOR_TRUE_RGB |
            (r << 16) | (g << 8) | b
        }
    }
    return TERMINAL_PANE_COLOR_DEFAULT
}

ParseTerminalPaneOSCCommand :: (text: const char*, out_code: *i32,
out_payload: **const char) -> i32 #export {
    code: i32

    if out_code != nil { *out_code = -1 }
    if out_payload != nil { *out_payload = "" }
    if text == nil { return 0 }
    separator: const char* = strchr(text, ';')
    end: const char* = separator != nil
    ? separator : text + strlen(text)
    if parse_decimal_span(text, end, 999999, &code) == 0 {
        return 0
    }
    if out_code != nil { *out_code = code }
    if out_payload != nil {
        *out_payload = separator != nil ? separator + 1 : ""
    }
    return 1
}

NextTerminalPaneOSCPaletteEntry :: (cursor: **const char,
out: *TerminalPaneOSCPaletteEntry) -> i32 #export {
    index_text: [16]char
    color_text: [128]char
    index: i32

    if out != nil {
        out->index = -1
        out->query = 0
        out->color = TERMINAL_PANE_COLOR_DEFAULT
        out->valid = 0
    }
    if cursor == nil || *cursor == nil || **cursor == '\0' {
        return 0
    }
    if copy_osc_token(cursor, index_text,
    (int)sizeof(index_text)) == 0 {
        return 0
    }
    if copy_osc_token(cursor, color_text,
    (int)sizeof(color_text)) == 0 {
        return 1
    }
    if out == nil { return 1 }
    if parse_palette_index_token(index_text, &index) == 0 {
        return 1
    }
    if strcmp(color_text, "?") == 0 {
        out->index = index
        out->query = 1
        out->valid = 1
        return 1
    }
    color: i32 = ParseTerminalPaneOSCColor(color_text)
    if color == TERMINAL_PANE_COLOR_DEFAULT { return 1 }
    out->index = index
    out->color = color
    out->valid = 1
    return 1
}

NextTerminalPaneOSCPaletteResetIndex :: (cursor: **const char,
out_index: *i32) -> i32 #export {
    index_text: [16]char
    index: i32 = -1

    if out_index != nil { *out_index = -1 }
    if cursor == nil || *cursor == nil || **cursor == '\0' {
        return 0
    }
    if copy_osc_token(cursor, index_text,
    (int)sizeof(index_text)) == 0 {
        return 0
    }
    if parse_palette_index_token(index_text, &index) != 0 &&
    out_index != nil {
        *out_index = index
    }
    return 1
}

TerminalPaneDefaultPaletteColor :: (index: i32) -> i32 #export {
    if index < 0 { index = 0 }
    if index > 255 { index = 255 }
    palette: TerminalPanePalette = GetTerminalPaneDefaultPalette()
    color: Color = palette.ansi[index]
    return TerminalPaneColorToRGB(color)
}

TerminalPaneOSCColorTargetForCode :: (code: i32) -> i32 #export {
    if code == 10 { return TERMINAL_PANE_OSC_COLOR_FOREGROUND }
    if code == 11 { return TERMINAL_PANE_OSC_COLOR_BACKGROUND }
    if code == 12 { return TERMINAL_PANE_OSC_COLOR_CURSOR }
    if code == 13 { return TERMINAL_PANE_OSC_COLOR_MOUSE_FOREGROUND }
    if code == 14 { return TERMINAL_PANE_OSC_COLOR_MOUSE_BACKGROUND }
    if code == 17 { return TERMINAL_PANE_OSC_COLOR_SELECTION_BACKGROUND }
    if code == 19 { return TERMINAL_PANE_OSC_COLOR_SELECTION_FOREGROUND }
    return TERMINAL_PANE_OSC_COLOR_INVALID
}

TerminalPaneOSCColorTargetForResetCode :: (code: i32) -> i32 #export {
    if code < 100 { return TERMINAL_PANE_OSC_COLOR_INVALID }
    return TerminalPaneOSCColorTargetForCode(code - 100)
}

TerminalPaneOSCColorQueryValue :: (target: i32,
state: TerminalPaneOSCColorState) -> i32 #export {
    if target == TERMINAL_PANE_OSC_COLOR_FOREGROUND {
        return state.foreground != TERMINAL_PANE_COLOR_DEFAULT
        ? state.foreground : state.base_foreground
    }
    if target == TERMINAL_PANE_OSC_COLOR_BACKGROUND {
        return state.background != TERMINAL_PANE_COLOR_DEFAULT
        ? state.background : state.base_background
    }
    if target == TERMINAL_PANE_OSC_COLOR_CURSOR {
        return state.cursor != TERMINAL_PANE_COLOR_DEFAULT
        ? state.cursor : state.base_cursor
    }
    if target == TERMINAL_PANE_OSC_COLOR_MOUSE_FOREGROUND {
        if state.mouse_foreground != TERMINAL_PANE_COLOR_DEFAULT {
            return state.mouse_foreground
        }
        return state.foreground != TERMINAL_PANE_COLOR_DEFAULT
        ? state.foreground : state.base_foreground
    }
    if target == TERMINAL_PANE_OSC_COLOR_MOUSE_BACKGROUND {
        if state.mouse_background != TERMINAL_PANE_COLOR_DEFAULT {
            return state.mouse_background
        }
        return state.background != TERMINAL_PANE_COLOR_DEFAULT
        ? state.background : state.base_background
    }
    if target == TERMINAL_PANE_OSC_COLOR_SELECTION_BACKGROUND {
        return state.selection_background !=
        TERMINAL_PANE_COLOR_DEFAULT
        ? state.selection_background
        : state.base_selection_background
    }
    if target == TERMINAL_PANE_OSC_COLOR_SELECTION_FOREGROUND {
        return state.selection_foreground !=
        TERMINAL_PANE_COLOR_DEFAULT
        ? state.selection_foreground
        : state.base_selection_foreground
    }
    return TERMINAL_PANE_COLOR_DEFAULT
}

FormatTerminalPaneOSCColorResponse :: (out: *char, out_size: i32,
code: i32, color: i32) -> i32 #export {
    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if (color & TERMINAL_PANE_COLOR_TRUE_RGB) == 0 { return 0 }
    rgb: i32 = color & 0xffffff
    r: i32 = (rgb >> 16) & 255
    g: i32 = (rgb >> 8) & 255
    b: i32 = rgb & 255
    return snprintf(out, (size_t)out_size,
    "\x1b]%d;rgb:%02x%02x/%02x%02x/%02x%02x\a",
    code, r, r, g, g, b, b)
}

FormatTerminalPaneOSCPaletteResponse :: (out: *char, out_size: i32,
index: i32, color: i32) -> i32 #export {
    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if index < 0 || index >= 256 ||
    (color & TERMINAL_PANE_COLOR_TRUE_RGB) == 0 {
        return 0
    }
    rgb: i32 = color & 0xffffff
    r: i32 = (rgb >> 16) & 255
    g: i32 = (rgb >> 8) & 255
    b: i32 = rgb & 255
    return snprintf(out, (size_t)out_size,
    "\x1b]4;%d;rgb:%02x%02x/%02x%02x/%02x%02x\a",
    index, r, r, g, g, b, b)
}

CopyTerminalPaneOSCHyperlinkURL :: (out: *char, out_size: i32,
url: const char*) -> i32 #export {
    cursor: const unsigned char* = (const unsigned char *)url
    used: i32 = 0

    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if cursor == nil { return 0 }
    while *cursor != '\0' {
        if *cursor == '\a' || *cursor == 0x1b || *cursor == 0x7f ||
        *cursor < 0x20 {
            cursor += 1
            continue
        }
        if used + 1 >= out_size { break }
        out[used] = (char)*cursor
        used += 1
        cursor += 1
    }
    out[used] = '\0'
    return used > 0 ? 1 : 0
}

CopyTerminalPaneOSCHyperlinkID :: (out: *char, out_size: i32,
params: const char*) -> i32 #export {
    cursor: const char* = params
    used: i32 = 0

    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if params == nil { return 0 }
    params_end: const char* = strchr(params, ';')
    if params_end == nil { params_end = params + strlen(params) }
    while cursor < params_end {
        end: const char* = cursor
        length: i32

        while end < params_end && *end != ':' { end += 1 }
        length = (int)(end - cursor)

        if length >= 3 && strncmp(cursor, "id=", 3) == 0 {
            value: const char* = cursor + 3
            while used + 1 < out_size && value < cursor + length {
                ch: unsigned char = (unsigned char)*value
                value += 1

                if ch == '\a' || ch == 0x1b || ch == 0x7f ||
                ch < 0x20 { continue }
                out[used] = (char)ch
                used += 1
            }
            out[used] = '\0'
            return used > 0 ? 1 : 0
        }
        if end >= params_end { break }
        cursor = end + 1
    }
    return 0
}

TerminalPaneOSCTitleTargets :: (payload: const char*, window: *i32,
icon: *i32) -> i32 #export {
    cursor: const char* = payload
    saw_token: i32 = 0
    value: i32

    if window != nil { *window = 0 }
    if icon != nil { *icon = 0 }
    if cursor == nil || cursor[0] == '\0' {
        if window != nil { *window = 1 }
        if icon != nil { *icon = 1 }
        return 1
    }
    while cursor[0] != '\0' {
        if cursor[0] == ';' {
            cursor += 1
            continue
        }
        {
            start: const char* = cursor

            while cursor[0] != '\0' && cursor[0] != ';' {
                cursor += 1
            }
            saw_token = 1
            if parse_decimal_span(start, cursor, 999999,
            &value) == 0 {
                continue
            }
        }
        if value == 0 {
            if window != nil { *window = 1 }
            if icon != nil { *icon = 1 }
        } else if value == 1 {
            if icon != nil { *icon = 1 }
        } else if value == 2 {
            if window != nil { *window = 1 }
        }
    }
    if saw_token == 0 {
        if window != nil { *window = 1 }
        if icon != nil { *icon = 1 }
    }
    return 1
}

CopyTerminalPaneTitleText :: (out: *char, out_size: i32,
title: const char*) -> i32 #export {
    used: i32 = 0

    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if append_osc_safe_text(out, out_size, &used, title) == 0 {
        out[0] = '\0'
        return 0
    }
    return 1
}

FormatTerminalPaneOSCTitleReport :: (out: *char, out_size: i32,
icon: i32, title: const char*) -> i32 #export {
    used: i32 = 0

    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if out_size < 5 { return 0 }
    out[used] = '\x1b'
    used += 1
    out[used] = ']'
    used += 1
    out[used] = icon != 0 ? 'L' : 'l'
    used += 1
    if CopyTerminalPaneTitleText(out + used, out_size - used,
    title) == 0 {
        out[0] = '\0'
        return 0
    }
    used += (int)strlen(out + used)
    if used + 2 >= out_size {
        out[0] = '\0'
        return 0
    }
    out[used] = '\x1b'
    used += 1
    out[used] = '\\'
    used += 1
    out[used] = '\0'
    return used
}

TerminalPaneOSCPushTitle :: (stack: *char, depth: i32, item_size: i32,
count: *i32, value: const char*) #export {
    if stack == nil || depth <= 0 || item_size <= 0 || count == nil {
        return
    }
    if value == nil { value = "" }
    if *count < 0 { *count = 0 }
    if *count >= depth {
        i: i32 = 1
        while i < depth {
            snprintf(stack + (i - 1) * item_size,
            (size_t)item_size, "%s", stack + i * item_size)
            i += 1
        }
        *count = depth - 1
    }
    snprintf(stack + *count * item_size, (size_t)item_size, "%s",
    value)
    *count += 1
}

TerminalPaneOSCPopTitle :: (stack: *char, depth: i32, item_size: i32,
count: *i32, value: *char, value_size: i32) #export {
    if stack == nil || depth <= 0 || item_size <= 0 || count == nil ||
    value == nil || value_size <= 0 { return }
    if *count <= 0 { return }
    if *count > depth { *count = depth }
    *count -= 1
    item: *char = stack + *count * item_size
    snprintf(value, (size_t)value_size, "%s", item)
    item[0] = '\0'
}

DecodeTerminalPaneOSCFileURIPath :: (out: *char, out_size: i32,
uri: const char*) -> i32 #export {
    used: i32 = 0

    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if uri == nil || strncmp(uri, "file://", 7) != 0 { return 0 }
    path: const char* = strchr(uri + 7, '/')
    if path == nil { return 0 }
    while *path != '\0' && used < out_size - 1 {
        if *path == '%' &&
        osc_hex_value((unsigned char)path[1]) >= 0 &&
        osc_hex_value((unsigned char)path[2]) >= 0 {
            out[used] =
            (char)((osc_hex_value((unsigned char)path[1]) << 4) |
            osc_hex_value((unsigned char)path[2]))
            used += 1
            path += 3
        } else {
            out[used] = *path
            used += 1
            path += 1
        }
    }
    out[used] = '\0'
    return used > 0 ? 1 : 0
}
