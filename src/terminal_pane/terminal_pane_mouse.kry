#module "terminal_pane_mouse_host"
#import "terminal_pane.h"
#import "stdio.h"

TerminalPaneMouseFinish :: (out: *char, out_size: i32,
used: i32) -> i32 {
    if out == nil || out_size <= 0 || used < 0 || used >= out_size {
        return 0
    }
    out[used] = '\0'
    return used
}

TerminalPaneMouseUtf8 :: (out: *char, out_size: i32,
used: *i32, codepoint: u32) -> i32 {
    if out == nil || used == nil || out_size <= 0 {
        return 0
    }
    if codepoint < 0x80 {
        if *used + 1 >= out_size { return 0 }
        out[*used] = (char)codepoint
        *used += 1
    } else if codepoint < 0x800 {
        if *used + 2 >= out_size { return 0 }
        out[*used] = (char)(0xc0 | (codepoint >> 6))
        *used += 1
        out[*used] = (char)(0x80 | (codepoint & 0x3f))
        *used += 1
    } else if codepoint < 0x10000 {
        if *used + 3 >= out_size { return 0 }
        out[*used] = (char)(0xe0 | (codepoint >> 12))
        *used += 1
        out[*used] = (char)(0x80 | ((codepoint >> 6) & 0x3f))
        *used += 1
        out[*used] = (char)(0x80 | (codepoint & 0x3f))
        *used += 1
    } else if codepoint <= 0x10ffff {
        if *used + 4 >= out_size { return 0 }
        out[*used] = (char)(0xf0 | (codepoint >> 18))
        *used += 1
        out[*used] = (char)(0x80 | ((codepoint >> 12) & 0x3f))
        *used += 1
        out[*used] = (char)(0x80 | ((codepoint >> 6) & 0x3f))
        *used += 1
        out[*used] = (char)(0x80 | (codepoint & 0x3f))
        *used += 1
    } else {
        return 0
    }
    return 1
}

TerminalPaneMouseFormat :: (out: *char, out_size: i32,
format: const char*, a: i32, b: i32, c: i32,
suffix: i32) -> i32 {
    if out == nil || out_size <= 0 || format == nil {
        return 0
    }
    length: i32 = snprintf(out, (size_t)out_size,
    format, a, b, c, suffix)
    if length < 0 || length >= out_size {
        return 0
    }
    return length
}

EncodeTerminalPaneMouse :: (out: *char, out_size: i32,
button: i32, col: i32, row: i32,
pixel_x: i32, pixel_y: i32,
pressed: i32, motion: i32, mods: i32,
mode: TerminalPaneMouseMode) -> i32 #export {
    if out == nil || out_size <= 0 {
        return 0
    }
    out[0] = '\0'
    if mode.mode == 0 || col < 0 || row < 0 {
        return 0
    }
    if pixel_x < 0 { pixel_x = col }
    if pixel_y < 0 { pixel_y = row }
    if mode.mode == 9 &&
    (motion || !pressed || button >= TERMINAL_PANE_MOUSE_WHEEL_UP) {
        return 0
    }
    if motion && (mode.mode == 9 || mode.mode == 1000) {
        return 0
    }
    if motion && mode.mode == 1002 &&
    button == TERMINAL_PANE_MOUSE_RELEASE {
        return 0
    }
    cb: i32 = button
    if cb < TERMINAL_PANE_MOUSE_LEFT {
        cb = TERMINAL_PANE_MOUSE_LEFT
    }
    if cb > TERMINAL_PANE_MOUSE_WHEEL_DOWN {
        cb = TERMINAL_PANE_MOUSE_RELEASE
    }
    if !pressed && !motion && !mode.sgr {
        cb = TERMINAL_PANE_MOUSE_RELEASE
    }
    if motion { cb += 32 }
    if mods & TERMINAL_PANE_MOD_SHIFT { cb += 4 }
    if mods & TERMINAL_PANE_MOD_ALT { cb += 8 }
    if mods & TERMINAL_PANE_MOD_CTRL { cb += 16 }

    if mode.sgr || mode.pixels {
        x: i32 = mode.pixels ? pixel_x : col
        y: i32 = mode.pixels ? pixel_y : row
        return TerminalPaneMouseFormat(out, out_size,
        "\x1b[<%d;%d;%d%c", cb, x + 1, y + 1,
        pressed || motion ? 'M' : 'm')
    }
    if mode.urxvt {
        return TerminalPaneMouseFormat(out, out_size,
        "\x1b[%d;%d;%dM", 32 + cb, col + 1, row + 1, 0)
    }
    if mode.utf8 {
        used: i32 = 3
        if out_size <= used { return 0 }
        out[0] = '\x1b'
        out[1] = '['
        out[2] = 'M'
        if !TerminalPaneMouseUtf8(out, out_size, &used,
        (uint32_t)(32 + cb)) ||
        !TerminalPaneMouseUtf8(out, out_size, &used,
        (uint32_t)(33 + col)) ||
        !TerminalPaneMouseUtf8(out, out_size, &used,
        (uint32_t)(33 + row)) {
            return 0
        }
        return TerminalPaneMouseFinish(out, out_size, used)
    }
    if col > 222 || row > 222 || out_size <= 6 {
        return 0
    }
    out[0] = '\x1b'
    out[1] = '['
    out[2] = 'M'
    out[3] = (char)(32 + cb)
    out[4] = (char)(33 + col)
    out[5] = (char)(33 + row)
    return TerminalPaneMouseFinish(out, out_size, 6)
}
