#module "terminal_pane_keys_host"
#inspect off
#import "terminal_pane.h"
#import "stdio.h"
#import "string.h"

TerminalPaneControlKeyMap :: struct {
    key: i32
    codepoint: u32
}

terminal_pane_key_finish :: (out: *char, out_size: i32,
used: i32) -> i32 {
    if out == nil || out_size <= 0 || used < 0 || used >= out_size {
        return 0
    }
    out[used] = '\0'
    return used
}

terminal_pane_key_copy :: (out: *char, out_size: i32,
text: const char*) -> i32 {
    if out == nil || out_size <= 0 || text == nil { return 0 }
    len: i32 = (int)strlen(text)
    if len >= out_size { return 0 }
    memcpy(out, text, (size_t)len + 1)
    return len
}

terminal_pane_key_format_modified :: (out: *char, out_size: i32,
modifier: i32, codepoint: u32) -> i32 {
    if out == nil || out_size <= 0 { return 0 }
    len: i32 = snprintf(out, (size_t)out_size,
    "\x1b[27;%d;%u~", modifier, codepoint)
    if len < 0 || len >= out_size { return 0 }
    return len
}

terminal_pane_key_format_one :: (out: *char, out_size: i32,
format: const char*, value: i32) -> i32 {
    if out == nil || out_size <= 0 || format == nil { return 0 }
    len: i32 = snprintf(out, (size_t)out_size, format, value)
    if len < 0 || len >= out_size { return 0 }
    return len
}

terminal_pane_key_format_two :: (out: *char, out_size: i32,
format: const char*, a: i32, b: i32) -> i32 {
    if out == nil || out_size <= 0 || format == nil { return 0 }
    len: i32 = snprintf(out, (size_t)out_size, format, a, b)
    if len < 0 || len >= out_size { return 0 }
    return len
}

terminal_pane_key_utf8 :: (out: *char, out_size: i32, used: *i32,
codepoint: u32) -> i32 {
    if out == nil || used == nil || out_size <= 0 { return 0 }
    if codepoint < 0x80 {
        if *used + 1 >= out_size { return 0 }
        out[*used] = (char)codepoint
        *used += 1
    } else if codepoint < 0x800 {
        if *used + 2 >= out_size { return 0 }
        out[*used] = (char)(0xc0 | (codepoint >> 6))
        *used += 1
        out[*used] = (char)(0x80 | (codepoint & 0x3f))
        *used += 1
    } else if codepoint < 0x10000 {
        if *used + 3 >= out_size { return 0 }
        out[*used] = (char)(0xe0 | (codepoint >> 12))
        *used += 1
        out[*used] = (char)(0x80 | ((codepoint >> 6) & 0x3f))
        *used += 1
        out[*used] = (char)(0x80 | (codepoint & 0x3f))
        *used += 1
    } else if codepoint <= 0x10ffff {
        if *used + 4 >= out_size { return 0 }
        out[*used] = (char)(0xf0 | (codepoint >> 18))
        *used += 1
        out[*used] = (char)(0x80 | ((codepoint >> 12) & 0x3f))
        *used += 1
        out[*used] = (char)(0x80 | ((codepoint >> 6) & 0x3f))
        *used += 1
        out[*used] = (char)(0x80 | (codepoint & 0x3f))
        *used += 1
    } else {
        return 0
    }
    return 1
}

terminal_pane_key_control_codepoint :: (codepoint: u32,
out: *unsigned char) -> i32 {
    if out == nil { return 0 }
    if codepoint >= 'a' && codepoint <= 'z' {
        *out = (unsigned char)(codepoint - 'a' + 1)
        return 1
    }
    if codepoint >= 'A' && codepoint <= 'Z' {
        *out = (unsigned char)(codepoint - 'A' + 1)
        return 1
    }
    if codepoint == ' ' || codepoint == '@' || codepoint == '2' {
        *out = 0x00
        return 1
    }
    if codepoint == '[' || codepoint == '{' || codepoint == '3' {
        *out = 0x1b
        return 1
    }
    if codepoint == '\\' || codepoint == '|' || codepoint == '4' {
        *out = 0x1c
        return 1
    }
    if codepoint == ']' || codepoint == '}' || codepoint == '5' {
        *out = 0x1d
        return 1
    }
    if codepoint == '^' || codepoint == '~' || codepoint == '6' {
        *out = 0x1e
        return 1
    }
    if codepoint == '_' || codepoint == '-' || codepoint == '/' ||
    codepoint == '7' {
        *out = 0x1f
        return 1
    }
    if codepoint == '?' || codepoint == '8' {
        *out = 0x7f
        return 1
    }
    return 0
}

terminal_pane_key_modifier_number :: (mods: i32) -> i32 {
    modifier: i32 = 1

    if (mods & TERMINAL_PANE_MOD_SHIFT) != 0 { modifier += 1 }
    if (mods & TERMINAL_PANE_MOD_ALT) != 0 { modifier += 2 }
    if (mods & TERMINAL_PANE_MOD_CTRL) != 0 { modifier += 4 }
    return modifier
}

terminal_pane_key_modified_codepoint :: (out: *char, out_size: i32,
codepoint: u32, mods: i32, mode: TerminalPaneKeyMode) -> i32 {
    if mode.modify_other_keys <= 0 ||
    (mods & (TERMINAL_PANE_MOD_SHIFT | TERMINAL_PANE_MOD_ALT |
    TERMINAL_PANE_MOD_CTRL)) == 0 { return 0 }
    if codepoint < 0x20 || codepoint == 0x7f { return 0 }
    if mode.modify_other_keys == 1 &&
    (mods & (TERMINAL_PANE_MOD_ALT | TERMINAL_PANE_MOD_CTRL)) == 0 {
        return 0
    }
    modifier: i32 = terminal_pane_key_modifier_number(mods)
    if modifier <= 1 { return 0 }
    return terminal_pane_key_format_modified(out, out_size, modifier,
    codepoint)
}

terminal_pane_key_modified_special :: (out: *char, out_size: i32,
codepoint: u32, mods: i32, mode: TerminalPaneKeyMode) -> i32 {
    if mode.modify_other_keys <= 0 ||
    (mods & (TERMINAL_PANE_MOD_SHIFT | TERMINAL_PANE_MOD_ALT |
    TERMINAL_PANE_MOD_CTRL)) == 0 { return 0 }
    if mode.modify_other_keys == 1 &&
    (mods & (TERMINAL_PANE_MOD_ALT | TERMINAL_PANE_MOD_CTRL)) == 0 {
        return 0
    }
    modifier: i32 = terminal_pane_key_modifier_number(mods)
    if modifier <= 1 { return 0 }
    return terminal_pane_key_format_modified(out, out_size, modifier,
    codepoint)
}

EncodeTerminalPaneCodepoint :: (out: *char, out_size: i32,
codepoint: u32, mods: i32,
mode: TerminalPaneKeyMode) -> i32 #export {
    used: i32 = 0

    if out == nil || out_size <= 0 || codepoint == 0 { return 0 }
    out[0] = '\0'
    used = terminal_pane_key_modified_codepoint(out, out_size,
    codepoint, mods, mode)
    if used > 0 { return used }
    if (mods & TERMINAL_PANE_MOD_CTRL) != 0 {
        control: unsigned char = 0

        if terminal_pane_key_control_codepoint(codepoint, &control) != 0 {
            if (mods & TERMINAL_PANE_MOD_ALT) != 0 {
                if used + 1 >= out_size { return 0 }
                out[used] = '\x1b'
                used += 1
            }
            if used + 1 >= out_size { return 0 }
            out[used] = (char)control
            used += 1
            return terminal_pane_key_finish(out, out_size, used)
        }
    }
    if (mods & TERMINAL_PANE_MOD_ALT) != 0 {
        if used + 1 >= out_size { return 0 }
        out[used] = '\x1b'
        used += 1
    }
    if terminal_pane_key_utf8(out, out_size, &used, codepoint) == 0 {
        return 0
    }
    return terminal_pane_key_finish(out, out_size, used)
}

MapTerminalPaneFunctionKey :: (function_index: i32,
mods: i32) -> TerminalPaneMappedKey #export {
    mapped: TerminalPaneMappedKey = (TerminalPaneMappedKey){0}

    mapped.mods = mods
    if function_index < 1 || function_index > 24 { return mapped }
    if function_index <= 12 &&
    (mods & TERMINAL_PANE_MOD_SHIFT) != 0 {
        mapped.key = TERMINAL_PANE_KEY_F13 + function_index - 1
        mapped.mods = mods & ~TERMINAL_PANE_MOD_SHIFT
        return mapped
    }
    mapped.key = TERMINAL_PANE_KEY_F1 + function_index - 1
    return mapped
}

EncodeTerminalPaneKey :: (out: *char, out_size: i32, key: i32,
mods: i32, mode: TerminalPaneKeyMode) -> i32 #export {
    final: char = 0
    modifier: i32 = terminal_pane_key_modifier_number(mods)
    plain: const char* = nil

    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if key == TERMINAL_PANE_KEY_ENTER {
        len: i32 = terminal_pane_key_modified_special(out, out_size,
        13, mods, mode)
        if len > 0 { return len }
        plain = "\r"
    } else if key == TERMINAL_PANE_KEY_BACKSPACE {
        len: i32 = terminal_pane_key_modified_special(out, out_size,
        127, mods, mode)
        if len > 0 { return len }
        plain = "\x7f"
    } else if key == TERMINAL_PANE_KEY_TAB {
        if (mods & TERMINAL_PANE_MOD_SHIFT) != 0 {
            if (mods & TERMINAL_PANE_MOD_ALT) != 0 {
                return terminal_pane_key_copy(out, out_size,
                "\x1b\x1b[Z")
            }
            return terminal_pane_key_copy(out, out_size, "\x1b[Z")
        }
        plain = "\t"
    } else if key == TERMINAL_PANE_KEY_ESCAPE {
        len: i32 = terminal_pane_key_modified_special(out, out_size,
        27, mods, mode)
        if len > 0 { return len }
        plain = "\x1b"
    } else if key == TERMINAL_PANE_KEY_UP {
        final = 'A'
    } else if key == TERMINAL_PANE_KEY_DOWN {
        final = 'B'
    } else if key == TERMINAL_PANE_KEY_RIGHT {
        final = 'C'
    } else if key == TERMINAL_PANE_KEY_LEFT {
        final = 'D'
    } else if key == TERMINAL_PANE_KEY_HOME {
        final = 'H'
    } else if key == TERMINAL_PANE_KEY_END {
        final = 'F'
    } else if key == TERMINAL_PANE_KEY_INSERT ||
    key == TERMINAL_PANE_KEY_DELETE ||
    key == TERMINAL_PANE_KEY_PAGE_UP ||
    key == TERMINAL_PANE_KEY_PAGE_DOWN {
        code: i32 = 2

        if key == TERMINAL_PANE_KEY_DELETE {
            code = 3
        } else if key == TERMINAL_PANE_KEY_PAGE_UP {
            code = 5
        } else if key == TERMINAL_PANE_KEY_PAGE_DOWN {
            code = 6
        }
        if modifier == 1 {
            return terminal_pane_key_format_one(out, out_size,
            "\x1b[%d~", code)
        }
        return terminal_pane_key_format_two(out, out_size,
        "\x1b[%d;%d~", code, modifier)
    } else if key >= TERMINAL_PANE_KEY_F1 &&
    key <= TERMINAL_PANE_KEY_F24 {
        # k2c drops fixed-array initializers on module globals;
        # the table must stay a local until global initializers
        # lower.
        function_codes: [24]i32 = {
            11, 12, 13, 14, 15, 17, 18, 19, 20, 21, 23, 24,
            11, 12, 13, 14, 15, 17, 18, 19, 20, 21, 23, 24
        }
        index: i32 = key - TERMINAL_PANE_KEY_F1
        code: i32 = function_codes[index]
        effective_modifier: i32 = modifier

        if index >= 12 {
            index -= 12
            if (mods & TERMINAL_PANE_MOD_SHIFT) == 0 {
                effective_modifier += 1
            }
        }
        if index < 4 && effective_modifier == 1 {
            if out_size <= 3 { return 0 }
            out[0] = '\x1b'
            out[1] = 'O'
            out[2] = (char)('P' + index)
            return terminal_pane_key_finish(out, out_size, 3)
        }
        if index < 4 {
            len: i32 = snprintf(out, (size_t)out_size,
            "\x1b[1;%d%c", effective_modifier, 'P' + index)
            if len < 0 || len >= out_size { return 0 }
            return len
        }
        if effective_modifier == 1 {
            return terminal_pane_key_format_one(out, out_size,
            "\x1b[%d~", code)
        }
        return terminal_pane_key_format_two(out, out_size,
        "\x1b[%d;%d~", code, effective_modifier)
    }

    if plain != nil {
        if (mods & TERMINAL_PANE_MOD_ALT) != 0 {
            if out_size <= 1 { return 0 }
            out[0] = '\x1b'
            if terminal_pane_key_copy(out + 1, out_size - 1,
            plain) > 0 {
                return (int)strlen(out)
            }
            return 0
        }
        return terminal_pane_key_copy(out, out_size, plain)
    }
    if final != 0 {
        if modifier == 1 && mode.application_cursor_keys != 0 &&
        (final == 'A' || final == 'B' || final == 'C' ||
        final == 'D' || final == 'H' || final == 'F') {
            if out_size <= 3 { return 0 }
            out[0] = '\x1b'
            out[1] = 'O'
            out[2] = final
            return terminal_pane_key_finish(out, out_size, 3)
        }
        if modifier == 1 {
            if out_size <= 3 { return 0 }
            out[0] = '\x1b'
            out[1] = '['
            out[2] = final
            return terminal_pane_key_finish(out, out_size, 3)
        }
        {
            len: i32 = snprintf(out, (size_t)out_size,
            "\x1b[1;%d%c", modifier, final)
            if len < 0 || len >= out_size { return 0 }
            return len
        }
    }
    return 0
}

EncodeTerminalPaneKeypad :: (out: *char, out_size: i32, key: char,
mode: TerminalPaneKeyMode) -> i32 #export {
    app: char = 0

    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if mode.application_keypad == 0 {
        if out_size <= 1 { return 0 }
        out[0] = key
        return terminal_pane_key_finish(out, out_size, 1)
    }
    if key >= '0' && key <= '9' {
        app = (char)('p' + key - '0')
    } else if key == '.' {
        app = 'n'
    } else if key == '/' {
        app = 'o'
    } else if key == '*' {
        app = 'j'
    } else if key == '-' {
        app = 'm'
    } else if key == '+' {
        app = 'k'
    } else if key == '=' {
        app = 'X'
    } else if key == '\r' {
        app = 'M'
    }
    if app == 0 || out_size <= 3 { return 0 }
    out[0] = '\x1b'
    out[1] = 'O'
    out[2] = app
    return terminal_pane_key_finish(out, out_size, 3)
}

terminal_pane_input_write :: (input: TerminalPaneInput,
text: const char*, len: i32) -> i32 {
    if input.write_text == nil || text == nil || len <= 0 {
        return 0
    }
    return input.write_text(input.userdata, text, len)
}

terminal_pane_input_write_codepoint :: (input: TerminalPaneInput,
codepoint: u32, mods: i32) -> i32 {
    seq: [64]char
    len: i32 = EncodeTerminalPaneCodepoint(seq, (int)sizeof(seq),
    codepoint, mods, input.mode)

    return terminal_pane_input_write(input, seq, len)
}

terminal_pane_input_write_key :: (input: TerminalPaneInput, key: i32,
mods: i32) -> i32 {
    seq: [64]char
    len: i32 = EncodeTerminalPaneKey(seq, (int)sizeof(seq), key,
    mods, input.mode)

    return terminal_pane_input_write(input, seq, len)
}

terminal_pane_input_write_function_key :: (input: TerminalPaneInput,
function_index: i32, mods: i32) -> i32 {
    mapped: TerminalPaneMappedKey =
    MapTerminalPaneFunctionKey(function_index, mods)

    if mapped.key == 0 { return 0 }
    return terminal_pane_input_write_key(input, mapped.key,
    mapped.mods)
}

terminal_pane_input_write_keypad :: (input: TerminalPaneInput,
key: char) -> i32 {
    seq: [16]char
    len: i32 = EncodeTerminalPaneKeypad(seq, (int)sizeof(seq), key,
    input.mode)

    return terminal_pane_input_write(input, seq, len)
}

terminal_pane_input_key_pressed_or_repeat :: (key: i32,
queued: *const int) -> i32 {
    if key > 0 && key < TERMINAL_PANE_INPUT_KEY_QUEUE_SIZE &&
    queued != nil && queued[key] != 0 {
        return 1
    }
    return IsKeyPressed(key) != 0 || IsKeyPressedRepeat(key) != 0
}

terminal_pane_input_key_down_or_queued :: (key: i32,
queued: *const int) -> i32 {
    return (IsKeyDown(key) != 0 ||
    (key > 0 && key < TERMINAL_PANE_INPUT_KEY_QUEUE_SIZE &&
    queued != nil && queued[key] != 0)) ? 1 : 0
}

GetTerminalPaneInputModifiers :: () -> i32 #export {
    mods: i32 = 0

    if IsKeyDown(KEY_LEFT_SHIFT) != 0 || IsKeyDown(KEY_RIGHT_SHIFT) != 0 {
        mods |= TERMINAL_PANE_MOD_SHIFT
    }
    if IsKeyDown(KEY_LEFT_ALT) != 0 || IsKeyDown(KEY_RIGHT_ALT) != 0 {
        mods |= TERMINAL_PANE_MOD_ALT
    }
    if IsKeyDown(KEY_LEFT_CONTROL) != 0 ||
    IsKeyDown(KEY_RIGHT_CONTROL) != 0 {
        mods |= TERMINAL_PANE_MOD_CTRL
    }
    return mods
}

MakeTerminalPaneInput :: (mode: TerminalPaneKeyMode,
write_text: TerminalPaneInputWriteFn, userdata: *void,
state: *TerminalPaneInputState) -> TerminalPaneInput #export {
    input: TerminalPaneInput = (TerminalPaneInput){0}

    input.mode = mode
    input.write_text = write_text
    input.userdata = userdata
    input.state = state
    return input
}

SendTerminalPaneControlInput :: (input: TerminalPaneInput,
platform_key: i32, mods: i32) -> i32 #export {
    # k2c drops fixed-array initializers on module globals; the
    # table must stay a local until global initializers lower.
    control_keys: [38]TerminalPaneControlKeyMap = {
        {KEY_SPACE, ' '},
        {KEY_TWO, '2'},
        {KEY_A, 'a'},
        {KEY_B, 'b'},
        {KEY_C, 'c'},
        {KEY_D, 'd'},
        {KEY_E, 'e'},
        {KEY_F, 'f'},
        {KEY_G, 'g'},
        {KEY_H, 'h'},
        {KEY_I, 'i'},
        {KEY_J, 'j'},
        {KEY_K, 'k'},
        {KEY_L, 'l'},
        {KEY_M, 'm'},
        {KEY_N, 'n'},
        {KEY_O, 'o'},
        {KEY_P, 'p'},
        {KEY_Q, 'q'},
        {KEY_R, 'r'},
        {KEY_S, 's'},
        {KEY_T, 't'},
        {KEY_U, 'u'},
        {KEY_V, 'v'},
        {KEY_W, 'w'},
        {KEY_X, 'x'},
        {KEY_Y, 'y'},
        {KEY_Z, 'z'},
        {KEY_LEFT_BRACKET, '['},
        {KEY_THREE, '3'},
        {KEY_BACKSLASH, '\\'},
        {KEY_FOUR, '4'},
        {KEY_RIGHT_BRACKET, ']'},
        {KEY_FIVE, '5'},
        {KEY_SIX, '6'},
        {KEY_SLASH, '/'},
        {KEY_MINUS, '-'},
        {KEY_SEVEN, '7'},
        {KEY_EIGHT, '8'}
    }
    i: i32 = 0

    while i < 38 {
        if control_keys[i].key == platform_key {
            return terminal_pane_input_write_codepoint(
            input, control_keys[i].codepoint, mods)
        }
        i += 1
    }
    return 0
}

PumpTerminalPaneKeyboardInputFiltered :: (input: TerminalPaneInput,
filter: TerminalPaneInputKeyFilterFn,
filter_userdata: *void) -> i32 #export {
    # k2c drops fixed-array initializers on module globals; the
    # tables must stay locals until global initializers lower.
    function_keys: [12]i32 = {
        KEY_F1, KEY_F2, KEY_F3, KEY_F4, KEY_F5, KEY_F6,
        KEY_F7, KEY_F8, KEY_F9, KEY_F10, KEY_F11, KEY_F12
    }
    queued: [TERMINAL_PANE_INPUT_KEY_QUEUE_SIZE]i32 = {0}
    mods: i32 = GetTerminalPaneInputModifiers()
    wrote: i32 = 0
    control_wrote: i32 = 0
    keypad_wrote: i32 = 0
    ch: i32
    key: i32
    i: i32

    if input.write_text == nil { return 0 }
    key = GetKeyPressed()
    while key > 0 {
        if filter != nil &&
        filter(filter_userdata, key, mods) != 0 {
            wrote = 1
        } else if key > 0 &&
        key < TERMINAL_PANE_INPUT_KEY_QUEUE_SIZE {
            queued[key] = 1
        }
        key = GetKeyPressed()
    }

    if terminal_pane_input_key_pressed_or_repeat(KEY_ENTER,
    queued) != 0 ||
    (input.mode.application_keypad == 0 &&
    terminal_pane_input_key_pressed_or_repeat(KEY_KP_ENTER,
    queued) != 0) {
        if terminal_pane_input_write_key(input,
        TERMINAL_PANE_KEY_ENTER, mods) != 0 {
            wrote = 1
        }
    }
    {
        special_keys: [13][2]i32 = {
            {KEY_BACKSPACE, TERMINAL_PANE_KEY_BACKSPACE},
            {KEY_TAB, TERMINAL_PANE_KEY_TAB},
            {KEY_ESCAPE, TERMINAL_PANE_KEY_ESCAPE},
            {KEY_UP, TERMINAL_PANE_KEY_UP},
            {KEY_DOWN, TERMINAL_PANE_KEY_DOWN},
            {KEY_RIGHT, TERMINAL_PANE_KEY_RIGHT},
            {KEY_LEFT, TERMINAL_PANE_KEY_LEFT},
            {KEY_HOME, TERMINAL_PANE_KEY_HOME},
            {KEY_END, TERMINAL_PANE_KEY_END},
            {KEY_PAGE_UP, TERMINAL_PANE_KEY_PAGE_UP},
            {KEY_PAGE_DOWN, TERMINAL_PANE_KEY_PAGE_DOWN},
            {KEY_DELETE, TERMINAL_PANE_KEY_DELETE},
            {KEY_INSERT, TERMINAL_PANE_KEY_INSERT}
        }
        i = 0
        while i < 13 {
            if terminal_pane_input_key_pressed_or_repeat(
            special_keys[i][0], queued) != 0 {
                if terminal_pane_input_write_key(input,
                special_keys[i][1], mods) != 0 {
                    wrote = 1
                }
            }
            i += 1
        }
    }
    i = 0
    while i < 12 {
        if terminal_pane_input_key_pressed_or_repeat(
        function_keys[i], queued) != 0 {
            if terminal_pane_input_write_function_key(input,
            i + 1, mods) != 0 {
                wrote = 1
            }
        }
        i += 1
    }

    if input.mode.application_keypad != 0 {
        keypad_keys: [17][2]i32 = {
            {KEY_KP_0, '0'},
            {KEY_KP_1, '1'},
            {KEY_KP_2, '2'},
            {KEY_KP_3, '3'},
            {KEY_KP_4, '4'},
            {KEY_KP_5, '5'},
            {KEY_KP_6, '6'},
            {KEY_KP_7, '7'},
            {KEY_KP_8, '8'},
            {KEY_KP_9, '9'},
            {KEY_KP_DECIMAL, '.'},
            {KEY_KP_DIVIDE, '/'},
            {KEY_KP_MULTIPLY, '*'},
            {KEY_KP_SUBTRACT, '-'},
            {KEY_KP_ADD, '+'},
            {KEY_KP_EQUAL, '='},
            {KEY_KP_ENTER, '\r'}
        }
        i = 0
        while i < 17 {
            if terminal_pane_input_key_pressed_or_repeat(
            keypad_keys[i][0], queued) != 0 {
                if terminal_pane_input_write_keypad(input,
                (char)keypad_keys[i][1]) != 0 {
                    keypad_wrote = 1
                }
            }
            i += 1
        }
        if keypad_wrote != 0 { return 1 }
    }

    if input.state != nil &&
    (mods & TERMINAL_PANE_MOD_CTRL) != 0 &&
    (mods & TERMINAL_PANE_MOD_SHIFT) == 0 {
        control_keys: [38]TerminalPaneControlKeyMap = {
            {KEY_SPACE, ' '},
            {KEY_TWO, '2'},
            {KEY_A, 'a'},
            {KEY_B, 'b'},
            {KEY_C, 'c'},
            {KEY_D, 'd'},
            {KEY_E, 'e'},
            {KEY_F, 'f'},
            {KEY_G, 'g'},
            {KEY_H, 'h'},
            {KEY_I, 'i'},
            {KEY_J, 'j'},
            {KEY_K, 'k'},
            {KEY_L, 'l'},
            {KEY_M, 'm'},
            {KEY_N, 'n'},
            {KEY_O, 'o'},
            {KEY_P, 'p'},
            {KEY_Q, 'q'},
            {KEY_R, 'r'},
            {KEY_S, 's'},
            {KEY_T, 't'},
            {KEY_U, 'u'},
            {KEY_V, 'v'},
            {KEY_W, 'w'},
            {KEY_X, 'x'},
            {KEY_Y, 'y'},
            {KEY_Z, 'z'},
            {KEY_LEFT_BRACKET, '['},
            {KEY_THREE, '3'},
            {KEY_BACKSLASH, '\\'},
            {KEY_FOUR, '4'},
            {KEY_RIGHT_BRACKET, ']'},
            {KEY_FIVE, '5'},
            {KEY_SIX, '6'},
            {KEY_SLASH, '/'},
            {KEY_MINUS, '-'},
            {KEY_SEVEN, '7'},
            {KEY_EIGHT, '8'}
        }
        i = 0
        while i < 38 {
            control_key: i32 = control_keys[i].key
            down: i32 = (terminal_pane_input_key_down_or_queued(
            control_key, queued) != 0 ||
            IsLayoutKeyDown((int)control_keys[i].codepoint) != 0)
            ? 1 : 0

            if down != 0 &&
            input.state->last_control_keys[control_key] == 0 {
                if SendTerminalPaneControlInput(input,
                control_key, mods) != 0 {
                    control_wrote = 1
                }
            }
            input.state->last_control_keys[control_key] = down
            i += 1
        }
        if control_wrote != 0 { return 1 }
    } else if input.state != nil {
        memset(input.state->last_control_keys, 0,
        sizeof(input.state->last_control_keys))
    }

    ch = GetCharPressed()
    while ch > 0 {
        if terminal_pane_input_write_codepoint(input,
        (unsigned int)ch, mods) != 0 {
            wrote = 1
        }
        ch = GetCharPressed()
    }
    return wrote
}

PumpTerminalPaneKeyboardInput :: (input: TerminalPaneInput) -> i32 #export {
    return PumpTerminalPaneKeyboardInputFiltered(input, nil, nil)
}
