#module "terminal_pane_modes_host"
#import "terminal_pane.h"
#import "stdio.h"

TerminalPaneModeStateSetMode :: (state: *TerminalPaneModeState,
mode: i32, enabled: i32) -> i32 #export {
    if state == nil { return TERMINAL_PANE_MODE_ACTION_NONE }
    if mode == 4 {
        state->insert_mode = enabled != 0
    } else if mode == 20 {
        state->newline_mode = enabled != 0
    }
    return TERMINAL_PANE_MODE_ACTION_NONE
}

TerminalPaneModeStateSetPrivateMode :: (state: *TerminalPaneModeState,
mode: i32, enabled: i32) -> i32 #export {
    if state == nil { return TERMINAL_PANE_MODE_ACTION_NONE }
    enabled = enabled != 0
    if mode == 12 {
        state->cursor_blink = enabled
    } else if mode == 25 {
        state->cursor_visible = enabled
    } else if mode == 6 {
        state->origin_mode = enabled
        return TERMINAL_PANE_MODE_ACTION_ORIGIN_CURSOR
    } else if mode == 7 {
        state->autowrap = enabled
    } else if mode == 1 {
        state->application_cursor_keys = enabled
    } else if mode == 9 || mode == 1000 ||
    mode == 1002 || mode == 1003 {
        if enabled != 0 {
            state->mouse_mode = mode
        } else if state->mouse_mode == mode {
            state->mouse_mode = 0
        }
    } else if mode == 1004 {
        state->focus_reporting = enabled
    } else if mode == 1005 {
        if enabled != 0 {
            state->mouse_sgr = 0
            state->mouse_urxvt = 0
            state->mouse_pixels = 0
        }
        state->mouse_utf8 = enabled
    } else if mode == 1006 {
        if enabled != 0 {
            state->mouse_utf8 = 0
            state->mouse_urxvt = 0
            state->mouse_pixels = 0
        }
        state->mouse_sgr = enabled
    } else if mode == 1007 {
        state->alternate_scroll = enabled
    } else if mode == 1015 {
        if enabled != 0 {
            state->mouse_utf8 = 0
            state->mouse_sgr = 0
            state->mouse_pixels = 0
        }
        state->mouse_urxvt = enabled
    } else if mode == 1016 {
        if enabled != 0 {
            state->mouse_utf8 = 0
            state->mouse_sgr = 0
            state->mouse_urxvt = 0
        }
        state->mouse_pixels = enabled
    } else if mode == 2004 {
        state->bracketed_paste = enabled
    } else if mode == 1048 {
        if enabled != 0 {
            return TERMINAL_PANE_MODE_ACTION_SAVE_CURSOR
        }
        return TERMINAL_PANE_MODE_ACTION_RESTORE_CURSOR
    } else if mode == 47 {
        state->alternate_screen = enabled
    } else if mode == 1047 {
        if enabled != 0 {
            state->alternate_screen = 1
            return TERMINAL_PANE_MODE_ACTION_CLEAR_SCREEN
        }
        state->alternate_screen = 0
        return TERMINAL_PANE_MODE_ACTION_CLEAR_ALTERNATE
    } else if mode == 1049 {
        if enabled != 0 {
            state->alternate_screen = 1
            return TERMINAL_PANE_MODE_ACTION_SAVE_CURSOR |
            TERMINAL_PANE_MODE_ACTION_CLEAR_SCREEN
        }
        state->alternate_screen = 0
        return TERMINAL_PANE_MODE_ACTION_CLEAR_ALTERNATE |
        TERMINAL_PANE_MODE_ACTION_RESTORE_CURSOR
    }
    return TERMINAL_PANE_MODE_ACTION_NONE
}

TerminalPaneModeReportStatus :: (state: TerminalPaneModeState,
private_mode: i32, mode: i32) -> i32 #export {
    if private_mode == 0 {
        if mode == 4 { return 2 - (state.insert_mode != 0) }
        if mode == 20 { return 2 - (state.newline_mode != 0) }
        return 0
    }
    if mode == 12 { return 2 - (state.cursor_blink != 0) }
    if mode == 25 { return 2 - (state.cursor_visible != 0) }
    if mode == 6 { return 2 - (state.origin_mode != 0) }
    if mode == 7 { return 2 - (state.autowrap != 0) }
    if mode == 1 { return 2 - (state.application_cursor_keys != 0) }
    if mode == 9 || mode == 1000 || mode == 1002 || mode == 1003 {
        return 2 - (state.mouse_mode == mode)
    }
    if mode == 1004 { return 2 - (state.focus_reporting != 0) }
    if mode == 1005 { return 2 - (state.mouse_utf8 != 0) }
    if mode == 1006 { return 2 - (state.mouse_sgr != 0) }
    if mode == 1007 { return 2 - (state.alternate_scroll != 0) }
    if mode == 1015 { return 2 - (state.mouse_urxvt != 0) }
    if mode == 1016 { return 2 - (state.mouse_pixels != 0) }
    if mode == 2004 { return 2 - (state.bracketed_paste != 0) }
    if mode == 1048 { return 2 }
    if mode == 47 || mode == 1047 || mode == 1049 {
        return 2 - (state.alternate_screen != 0)
    }
    return 0
}

FormatTerminalPaneModeReport :: (out: *char, out_size: i32,
state: TerminalPaneModeState, private_mode: i32,
mode: i32) -> i32 #export {
    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    status: i32 = TerminalPaneModeReportStatus(
    state, private_mode, mode)
    length: i32 = 0
    if private_mode != 0 {
        length = snprintf(out, (size_t)out_size,
        "\x1b[?%d;%d$y", mode, status)
    } else {
        length = snprintf(out, (size_t)out_size,
        "\x1b[%d;%d$y", mode, status)
    }
    if length <= 0 || length >= out_size {
        out[0] = '\0'
        return 0
    }
    return length
}
