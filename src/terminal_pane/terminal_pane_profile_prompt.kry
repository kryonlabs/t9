#module "terminal_pane_profile_prompt_host"
#inspect off
#import "terminal_pane.h"
#import "stdio.h"
#import "string.h"

PanePromptInfo :: struct {
    title: const char*
    setting: const char*
}

PanePrompt :: (prompt: i32) -> PanePromptInfo {
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SHELL {
        return (PanePromptInfo){"Shell", "shell"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_WORKING_DIRECTORY {
        return (PanePromptInfo){"Working Directory", "working-directory"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_TERMINAL_FONT {
        return (PanePromptInfo){"Terminal Font", "terminal-font"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_FONT_SIZE {
        return (PanePromptInfo){"Font Size", "font-size"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SCROLLBACK {
        return (PanePromptInfo){"Scrollback Lines", "scrollback"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_FOREGROUND {
        return (PanePromptInfo){"Terminal Foreground", "terminal-foreground"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND {
        return (PanePromptInfo){"Terminal Background", "terminal-background"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_CURSOR_COLOR {
        return (PanePromptInfo){"Terminal Cursor", "terminal-cursor"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_FOREGROUND {
        return (PanePromptInfo){"Selection Foreground", "terminal-selection-foreground"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_BACKGROUND {
        return (PanePromptInfo){"Selection Background", "terminal-selection-background"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DYNAMIC_TITLE_MODE {
        return (PanePromptInfo){"Dynamic Title Mode", "dynamic-title-mode"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKSPACE_BINDING {
        return (PanePromptInfo){"Backspace Key", "backspace-binding"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DELETE_BINDING {
        return (PanePromptInfo){"Delete Key", "delete-binding"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_AMBIGUOUS_WIDTH {
        return (PanePromptInfo){"Ambiguous Width", "ambiguous-width"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_ALLOW_BOLD {
        return (PanePromptInfo){"Allow Bold Text", "allow-bold"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_UNLIMITED_SCROLLBACK {
        return (PanePromptInfo){"Unlimited Scrollback", "unlimited-scrollback"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_AUTO_HIDE_MOUSE {
        return (PanePromptInfo){"Auto-hide Mouse", "auto-hide-mouse"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_MIDDLE_CLICK_CLOSE_TAB {
        return (PanePromptInfo){"Middle Click Closes Tab", "middle-click-closes-tab"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_ALWAYS_SHOW_TABS {
        return (PanePromptInfo){"Always Show Tabs", "always-show-tabs"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_MENU_MNEMONICS {
        return (PanePromptInfo){"Disable Menu Access Keys", "disable-menu-mnemonics"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_MENU_SHORTCUT {
        return (PanePromptInfo){"Disable Menu Shortcut", "disable-menu-shortcut"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_HELP_SHORTCUT {
        return (PanePromptInfo){"Disable Help Shortcut", "disable-help-shortcut"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_OPACITY {
        return (PanePromptInfo){"Background Opacity", "background-opacity"}
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_IMAGE {
        return (PanePromptInfo){"Background Image", "background-image"}
    }
    return (PanePromptInfo){"Profile", nil}
}

TerminalPaneProfilePromptTitle :: (prompt: i32) -> const char* #export {
    return PanePrompt(prompt).title
}

TerminalPaneProfilePromptSettingName :: (prompt: i32) -> const char* #export {
    return PanePrompt(prompt).setting
}

TerminalPaneProfilePromptAffectsColors :: (prompt: i32) -> i32 #export {
    return prompt == TERMINAL_PANE_PROFILE_PROMPT_FOREGROUND ||
    prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND ||
    prompt == TERMINAL_PANE_PROFILE_PROMPT_CURSOR_COLOR ||
    prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_FOREGROUND ||
    prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_BACKGROUND
}

TerminalPaneProfilePromptAffectsFont :: (prompt: i32) -> i32 #export {
    return prompt == TERMINAL_PANE_PROFILE_PROMPT_TERMINAL_FONT
}

TerminalPaneProfilePromptAffectsScrollback :: (prompt: i32) -> i32 #export {
    return prompt == TERMINAL_PANE_PROFILE_PROMPT_SCROLLBACK ||
    prompt == TERMINAL_PANE_PROFILE_PROMPT_UNLIMITED_SCROLLBACK
}

PanePromptColor :: (out: *char, out_size: i32, color: i32) -> i32 {
    if out == nil || out_size <= 0 {
        return 0
    }
    if color == TERMINAL_PANE_COLOR_DEFAULT {
        return snprintf(out, (size_t)out_size, "default")
    }
    if FormatTerminalPaneProfileColor(out, out_size, color) > 0 {
        return (int)strlen(out)
    }
    out[0] = '\0'
    return 0
}

PaneBoolName :: (value: i32) -> const char* {
    return value != 0 ? "true" : "false"
}

PaneTitleModeName :: (mode: i32) -> const char* {
    if mode == TERMINAL_PANE_TITLE_PREPEND { return "prepend" }
    if mode == TERMINAL_PANE_TITLE_APPEND { return "append" }
    if mode == TERMINAL_PANE_TITLE_IGNORE { return "ignore" }
    return "replace"
}

PaneKeyBindingName :: (binding: i32) -> const char* {
    if binding == TERMINAL_PANE_KEY_BINDING_CONTROL_H { return "control-h" }
    if binding == TERMINAL_PANE_KEY_BINDING_ESCAPE_SEQUENCE {
        return "escape-sequence"
    }
    return "ascii-delete"
}

FormatTerminalPaneProfilePromptValue :: (
out: *char, out_size: i32, settings: *const TerminalPaneProfileSettings,
prompt: i32) -> i32 #export {
    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if settings == nil { return 0 }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SHELL {
        return snprintf(out, (size_t)out_size, "%s", settings->shell)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_WORKING_DIRECTORY {
        return snprintf(out, (size_t)out_size, "%s", settings->working_directory)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_TERMINAL_FONT {
        return snprintf(out, (size_t)out_size, "%s", settings->terminal_font)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_FONT_SIZE {
        return snprintf(out, (size_t)out_size, "%d", settings->font_size)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SCROLLBACK {
        return snprintf(out, (size_t)out_size, "%d", settings->scrollback_limit)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_FOREGROUND {
        return PanePromptColor(out, out_size, settings->terminal_foreground)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND {
        return PanePromptColor(out, out_size, settings->terminal_background)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_CURSOR_COLOR {
        return PanePromptColor(out, out_size, settings->terminal_cursor)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_FOREGROUND {
        return PanePromptColor(out, out_size,
        settings->terminal_selection_foreground)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_BACKGROUND {
        return PanePromptColor(out, out_size,
        settings->terminal_selection_background)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DYNAMIC_TITLE_MODE {
        return snprintf(out, (size_t)out_size, "%s",
        PaneTitleModeName(settings->dynamic_title_mode))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKSPACE_BINDING {
        return snprintf(out, (size_t)out_size, "%s",
        PaneKeyBindingName(settings->backspace_binding))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DELETE_BINDING {
        return snprintf(out, (size_t)out_size, "%s",
        PaneKeyBindingName(settings->delete_binding))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_AMBIGUOUS_WIDTH {
        return snprintf(out, (size_t)out_size, "%s",
        settings->ambiguous_width_wide ? "wide" : "narrow")
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_ALLOW_BOLD {
        return snprintf(out, (size_t)out_size, "%s",
        PaneBoolName(settings->allow_bold))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_UNLIMITED_SCROLLBACK {
        return snprintf(out, (size_t)out_size, "%s",
        PaneBoolName(settings->unlimited_scrollback))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_AUTO_HIDE_MOUSE {
        return snprintf(out, (size_t)out_size, "%s",
        PaneBoolName(settings->auto_hide_mouse))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_MIDDLE_CLICK_CLOSE_TAB {
        return snprintf(out, (size_t)out_size, "%s",
        PaneBoolName(settings->middle_click_closes_tab))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_ALWAYS_SHOW_TABS {
        return snprintf(out, (size_t)out_size, "%s",
        PaneBoolName(settings->always_show_tabs))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_MENU_MNEMONICS {
        return snprintf(out, (size_t)out_size, "%s",
        PaneBoolName(settings->disable_menu_mnemonics))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_MENU_SHORTCUT {
        return snprintf(out, (size_t)out_size, "%s",
        PaneBoolName(settings->disable_menu_shortcut))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_HELP_SHORTCUT {
        return snprintf(out, (size_t)out_size, "%s",
        PaneBoolName(settings->disable_help_shortcut))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_OPACITY {
        return snprintf(out, (size_t)out_size, "%d",
        settings->background_opacity)
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_IMAGE {
        return snprintf(out, (size_t)out_size, "%s",
        settings->background_image)
    }
    return 0
}

ApplyTerminalPaneProfilePromptValue :: (
settings: *TerminalPaneProfileSettings,
limits: TerminalPaneProfileLimits, prompt: i32,
value: const char*) -> i32 #export {
    name: const char* = TerminalPaneProfilePromptSettingName(prompt)
    if name == nil { return 0 }
    return ApplyTerminalPaneProfileSetting(settings, limits, name, value)
}
