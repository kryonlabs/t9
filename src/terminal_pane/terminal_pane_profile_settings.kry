#module "terminal_pane_profile_settings_host"
#inspect off
#import "terminal_pane.h"
#import "stdlib.h"
#import "stdio.h"
#import "string.h"

PaneProfileCopyText :: (dst: *char, dst_size: i32,
src: const char*) {
    if dst == nil || dst_size <= 0 { return }
    value: const char* = src != nil ? src : ""
    snprintf(dst, (size_t)dst_size, "%s", value)
}

PaneSettingNameIs :: (name: const char*, a: const char*,
b: const char*, c: const char*, d: const char*,
e: const char*) -> i32 {
    if name == nil { return 0 }
    return (a != nil && strcmp(name, a) == 0) ||
    (b != nil && strcmp(name, b) == 0) ||
    (c != nil && strcmp(name, c) == 0) ||
    (d != nil && strcmp(name, d) == 0) ||
    (e != nil && strcmp(name, e) == 0)
}

PaneSettingInRange :: (value: i32, minimum: i32,
maximum: i32) -> i32 {
    return minimum <= maximum && value >= minimum && value <= maximum
}

PaneParseBool :: (value: const char*, out: *int) -> i32 {
    if value == nil || out == nil { return 0 }
    if strcmp(value, "1") == 0 || strcmp(value, "true") == 0 ||
    strcmp(value, "yes") == 0 || strcmp(value, "on") == 0 ||
    strcmp(value, "enabled") == 0 {
        *out = 1
        return 1
    }
    if strcmp(value, "0") == 0 || strcmp(value, "false") == 0 ||
    strcmp(value, "no") == 0 || strcmp(value, "off") == 0 ||
    strcmp(value, "disabled") == 0 {
        *out = 0
        return 1
    }
    return 0
}

PaneParsePercent :: (value: const char*, out: *int) -> i32 {
    if value == nil || value[0] == '\0' || out == nil { return 0 }
    end: *char = nil
    parsed: long = strtol(value, &end, 10)
    if end == value || (*end != '\0' && *end != '%') ||
    (end[0] == '%' && end[1] != '\0') ||
    parsed < 0 || parsed > 100 { return 0 }
    *out = (int)parsed
    return 1
}

GetDefaultTerminalPaneProfileLimits :: () -> TerminalPaneProfileLimits #export {
    limits: TerminalPaneProfileLimits
    limits.default_font_size = 16
    limits.min_font_size = 10
    limits.max_font_size = 48
    limits.default_scrollback_limit = 5000
    limits.min_scrollback_limit = 100
    limits.max_scrollback_limit = 100000
    limits.default_cursor_style = TERMINAL_PANE_CURSOR_BLOCK
    return limits
}

InitTerminalPaneProfileSettings :: (
settings: *TerminalPaneProfileSettings,
limits: TerminalPaneProfileLimits) #export {
    if settings == nil { return }
    memset(settings, 0, sizeof(*settings))
    settings->font_size = limits.default_font_size
    settings->scrollback_limit = limits.default_scrollback_limit
    settings->unlimited_scrollback = 0
    settings->cursor_style = limits.default_cursor_style
    settings->dynamic_title_mode = TERMINAL_PANE_TITLE_REPLACE
    settings->backspace_binding = TERMINAL_PANE_KEY_BINDING_ASCII_DELETE
    settings->delete_binding = TERMINAL_PANE_KEY_BINDING_ESCAPE_SEQUENCE
    settings->ambiguous_width_wide = 0
    settings->allow_bold = 1
    settings->auto_hide_mouse = 0
    settings->middle_click_closes_tab = 0
    settings->always_show_tabs = 0
    settings->disable_menu_mnemonics = 0
    settings->disable_menu_shortcut = 0
    settings->disable_help_shortcut = 0
    settings->background_opacity = 100
    settings->terminal_foreground = TERMINAL_PANE_COLOR_DEFAULT
    settings->terminal_background = TERMINAL_PANE_COLOR_DEFAULT
    settings->terminal_cursor = TERMINAL_PANE_COLOR_DEFAULT
    settings->terminal_selection_foreground = TERMINAL_PANE_COLOR_DEFAULT
    settings->terminal_selection_background = TERMINAL_PANE_COLOR_DEFAULT
}

ApplyTerminalPaneProfileSetting :: (
settings: *TerminalPaneProfileSettings,
limits: TerminalPaneProfileLimits, name: const char*,
value: const char*) -> i32 #export {
    if settings == nil || name == nil || value == nil { return 0 }
    parsed: i32 = 0
    if PaneSettingNameIs(name, "font_size", "font-size", nil, nil, nil) {
        parsed = atoi(value)
        if !PaneSettingInRange(parsed, limits.min_font_size,
        limits.max_font_size) { return 0 }
        settings->font_size = parsed
        return 1
    }
    if PaneSettingNameIs(name, "scrollback", "scrollback_limit",
    "scrollback-limit", nil, nil) {
        parsed = atoi(value)
        if !PaneSettingInRange(parsed, limits.min_scrollback_limit,
        limits.max_scrollback_limit) { return 0 }
        settings->scrollback_limit = parsed
        return 1
    }
    if PaneSettingNameIs(name, "unlimited_scrollback",
    "unlimited-scrollback", nil, nil, nil) {
        if !PaneParseBool(value, &parsed) { return 0 }
        settings->unlimited_scrollback = parsed
        return 1
    }
    if PaneSettingNameIs(name, "cursor_style", "cursor-style", nil, nil, nil) {
        settings->cursor_style = ParseTerminalPaneCursorStyle(value,
        settings->cursor_style)
        return 1
    }
    if PaneSettingNameIs(name, "dynamic_title_mode", "dynamic-title-mode",
    "dynamic_title", "dynamic-title", nil) {
        if strcmp(value, "replace") == 0 || strcmp(value, "auto") == 0 {
            settings->dynamic_title_mode = TERMINAL_PANE_TITLE_REPLACE
        } else if strcmp(value, "prepend") == 0 {
            settings->dynamic_title_mode = TERMINAL_PANE_TITLE_PREPEND
        } else if strcmp(value, "append") == 0 {
            settings->dynamic_title_mode = TERMINAL_PANE_TITLE_APPEND
        } else if strcmp(value, "ignore") == 0 ||
        strcmp(value, "none") == 0 {
            settings->dynamic_title_mode = TERMINAL_PANE_TITLE_IGNORE
        } else {
            return 0
        }
        return 1
    }
    if PaneSettingNameIs(name, "backspace_binding", "backspace-binding",
    "backspace", nil, nil) {
        if strcmp(value, "delete") == 0 ||
        strcmp(value, "ascii-delete") == 0 || strcmp(value, "del") == 0 {
            settings->backspace_binding = TERMINAL_PANE_KEY_BINDING_ASCII_DELETE
        } else if strcmp(value, "control-h") == 0 ||
        strcmp(value, "backspace") == 0 || strcmp(value, "bs") == 0 {
            settings->backspace_binding = TERMINAL_PANE_KEY_BINDING_CONTROL_H
        } else {
            return 0
        }
        return 1
    }
    if PaneSettingNameIs(name, "delete_binding", "delete-binding",
    "delete", nil, nil) {
        if strcmp(value, "escape-sequence") == 0 ||
        strcmp(value, "sequence") == 0 || strcmp(value, "esc") == 0 {
            settings->delete_binding = TERMINAL_PANE_KEY_BINDING_ESCAPE_SEQUENCE
        } else if strcmp(value, "delete") == 0 ||
        strcmp(value, "ascii-delete") == 0 || strcmp(value, "del") == 0 {
            settings->delete_binding = TERMINAL_PANE_KEY_BINDING_ASCII_DELETE
        } else {
            return 0
        }
        return 1
    }
    if PaneSettingNameIs(name, "ambiguous_width_wide",
    "ambiguous-width-wide", "ambiguous_width", "ambiguous-width", nil) {
        if strcmp(value, "wide") == 0 {
            parsed = 1
        } else if strcmp(value, "narrow") == 0 {
            parsed = 0
        } else {
            if !PaneParseBool(value, &parsed) {
                return 0
            }
        }
        settings->ambiguous_width_wide = parsed
        return 1
    }
    if PaneSettingNameIs(name, "allow_bold", "allow-bold", nil, nil, nil) {
        if !PaneParseBool(value, &parsed) { return 0 }
        settings->allow_bold = parsed
        return 1
    }
    if PaneSettingNameIs(name, "auto_hide_mouse", "auto-hide-mouse",
    "auto_hide_pointer", "auto-hide-pointer", nil) {
        if !PaneParseBool(value, &parsed) { return 0 }
        settings->auto_hide_mouse = parsed
        return 1
    }
    if PaneSettingNameIs(name, "middle_click_closes_tab",
    "middle-click-closes-tab", "middle_click_close_tab",
    "middle-click-close-tab", nil) {
        if !PaneParseBool(value, &parsed) { return 0 }
        settings->middle_click_closes_tab = parsed
        return 1
    }
    if PaneSettingNameIs(name, "always_show_tabs", "always-show-tabs",
    nil, nil, nil) {
        if !PaneParseBool(value, &parsed) { return 0 }
        settings->always_show_tabs = parsed
        return 1
    }
    if PaneSettingNameIs(name, "disable_menu_mnemonics",
    "disable-menu-mnemonics", "disable_menu_access_keys",
    "disable-menu-access-keys", nil) {
        if !PaneParseBool(value, &parsed) { return 0 }
        settings->disable_menu_mnemonics = parsed
        return 1
    }
    if PaneSettingNameIs(name, "disable_menu_shortcut",
    "disable-menu-shortcut", "disable_f10", "disable-f10", nil) {
        if !PaneParseBool(value, &parsed) { return 0 }
        settings->disable_menu_shortcut = parsed
        return 1
    }
    if PaneSettingNameIs(name, "disable_help_shortcut",
    "disable-help-shortcut", "disable_f1", "disable-f1", nil) {
        if !PaneParseBool(value, &parsed) { return 0 }
        settings->disable_help_shortcut = parsed
        return 1
    }
    if PaneSettingNameIs(name, "background_opacity",
    "background-opacity", "opacity", nil, nil) {
        if !PaneParsePercent(value, &parsed) { return 0 }
        settings->background_opacity = parsed
        return 1
    }
    if PaneSettingNameIs(name, "background_image", "background-image",
    nil, nil, nil) {
        PaneProfileCopyText(settings->background_image,
        (int)sizeof(settings->background_image), value)
        return 1
    }
    if strcmp(name, "shell") == 0 {
        PaneProfileCopyText(settings->shell,
        (int)sizeof(settings->shell), value)
        return 1
    }
    if PaneSettingNameIs(name, "working_directory", "working-directory",
    "cwd", nil, nil) {
        PaneProfileCopyText(settings->working_directory,
        (int)sizeof(settings->working_directory), value)
        return 1
    }
    if strcmp(name, "command") == 0 {
        PaneProfileCopyText(settings->command,
        (int)sizeof(settings->command), value)
        return 1
    }
    if PaneSettingNameIs(name, "terminal_font", "terminal-font",
    "font", nil, nil) {
        PaneProfileCopyText(settings->terminal_font,
        (int)sizeof(settings->terminal_font), value)
        return 1
    }
    if PaneSettingNameIs(name, "terminal_foreground",
    "terminal-foreground", "foreground", nil, nil) {
        if !ParseTerminalPaneProfileColor(value, &parsed) { return 0 }
        settings->terminal_foreground = parsed
        return 1
    }
    if PaneSettingNameIs(name, "terminal_background",
    "terminal-background", "background", nil, nil) {
        if !ParseTerminalPaneProfileColor(value, &parsed) { return 0 }
        settings->terminal_background = parsed
        return 1
    }
    if PaneSettingNameIs(name, "terminal_cursor", "terminal-cursor",
    "cursor", "cursor_color", "cursor-color") {
        if !ParseTerminalPaneProfileColor(value, &parsed) { return 0 }
        settings->terminal_cursor = parsed
        return 1
    }
    if PaneSettingNameIs(name, "terminal_selection_foreground",
    "terminal-selection-foreground", "selection_foreground",
    "selection-foreground", nil) {
        if !ParseTerminalPaneProfileColor(value, &parsed) { return 0 }
        settings->terminal_selection_foreground = parsed
        return 1
    }
    if PaneSettingNameIs(name, "terminal_selection_background",
    "terminal-selection-background", "selection_background",
    "selection-background", nil) {
        if !ParseTerminalPaneProfileColor(value, &parsed) { return 0 }
        settings->terminal_selection_background = parsed
        return 1
    }
    return 0
}
