#module "terminal_pane_reflow_host"
#import "terminal_pane.h"
#import "string.h"

ReflowCellIsBlank :: (spec: const TerminalPaneReflowSpec*,
cell: const void*) -> i32 {
    if spec == nil || cell == nil { return 1 }
    if spec->is_blank != nil {
        return spec->is_blank(cell, spec->userdata)
    }
    if spec->blank_cell != nil {
        return memcmp(cell, spec->blank_cell, spec->cell_size) == 0
    }
    return 0
}

ReflowCopyCell :: (spec: const TerminalPaneReflowSpec*,
row: i32, col: i32, cell: const void*) {
    if spec == nil || cell == nil || spec->output_cells == nil ||
    row < 0 || row >= spec->output_rows || col < 0 ||
    col >= spec->output_cols {
        return
    }
    output: *u8 = spec->output_cells
    output = memcpy(output + ((size_t)row *
    (size_t)spec->output_cols + (size_t)col) *
    spec->cell_size, cell, spec->cell_size)
}

ReflowInputCell :: (spec: const TerminalPaneReflowSpec*,
row: i32, col: i32) -> const void* {
    if spec == nil || spec->input_cells == nil || row < 0 ||
    row >= spec->input_rows || col < 0 || col >= spec->input_cols {
        return nil
    }
    input: const unsigned char* = spec->input_cells
    return input + ((size_t)row * (size_t)spec->input_cols +
    (size_t)col) * spec->cell_size
}

ReflowFillOutput :: (spec: const TerminalPaneReflowSpec*) {
    if spec == nil { return }
    if spec->output_wrapped != nil {
        row: i32 = 0
        while row < spec->output_rows {
            spec->output_wrapped[row] = 0
            row += 1
        }
    }
    if spec->output_cells == nil || spec->blank_cell == nil {
        return
    }
    row: i32 = 0
    while row < spec->output_rows {
        col: i32 = 0
        while col < spec->output_cols {
            ReflowCopyCell(spec, row, col, spec->blank_cell)
            col += 1
        }
        row += 1
    }
}

ReflowRowTextEnd :: (spec: const TerminalPaneReflowSpec*,
row: i32, keep_full: i32) -> i32 {
    if spec == nil || row < 0 || row >= spec->input_rows ||
    spec->input_cols <= 0 {
        return 0
    }
    if keep_full { return spec->input_cols }
    end: i32 = spec->input_cols
    while end > 0 && ReflowCellIsBlank(spec,
    ReflowInputCell(spec, row, end - 1)) {
        end -= 1
    }
    return end
}

ReflowAppendCell :: (spec: const TerminalPaneReflowSpec*,
out_row: *i32, out_col: *i32, cell: const void*) {
    if spec == nil || out_row == nil || out_col == nil ||
    spec->output_cols <= 0 {
        return
    }
    if *out_col >= spec->output_cols {
        if spec->output_wrapped != nil && *out_row >= 0 &&
        *out_row < spec->output_rows {
            spec->output_wrapped[*out_row] = 1
        }
        *out_row += 1
        *out_col = 0
    }
    ReflowCopyCell(spec, *out_row, *out_col, cell)
    *out_col += 1
}

ReflowFinishLine :: (out_row: *i32, out_col: *i32) {
    if out_row == nil || out_col == nil { return }
    *out_row += 1
    *out_col = 0
}

TerminalPaneReflowRows :: (spec: const TerminalPaneReflowSpec*) -> i32 #export {
    if spec == nil || spec->input_cells == nil ||
    spec->output_cells == nil || spec->input_cols <= 0 ||
    spec->input_rows <= 0 || spec->output_cols <= 0 ||
    spec->output_rows <= 0 || spec->cell_size == 0 {
        return 0
    }
    ReflowFillOutput(spec)
    input_rows: i32 = spec->input_rows
    if spec->trim_blank_rows_after_cursor {
        while input_rows > spec->cursor_input_row + 1 {
            soft: i32 = spec->input_wrapped != nil &&
            spec->input_wrapped[input_rows - 1]
            if soft || ReflowRowTextEnd(spec, input_rows - 1, 0) > 0 {
                break
            }
            input_rows -= 1
        }
    }
    out_row: i32 = 0
    out_col: i32 = 0
    cursor_row: i32 = -1
    cursor_col: i32 = -1
    row: i32 = 0
    while row < input_rows {
        soft: i32 = spec->input_wrapped != nil &&
        spec->input_wrapped[row]
        end: i32 = ReflowRowTextEnd(spec, row, soft)
        col: i32 = 0
        while col < end {
            if row == spec->cursor_input_row &&
            col == spec->cursor_input_col {
                cursor_row = out_row
                cursor_col = out_col
            }
            ReflowAppendCell(spec, &out_row, &out_col,
            ReflowInputCell(spec, row, col))
            col += 1
        }
        if row == spec->cursor_input_row && cursor_row < 0 {
            cursor_row = out_row
            cursor_col = out_col +
            (spec->cursor_input_col > end
            ? spec->cursor_input_col - end : 0)
            while cursor_col >= spec->output_cols {
                cursor_row += 1
                cursor_col -= spec->output_cols
            }
        }
        if !soft {
            ReflowFinishLine(&out_row, &out_col)
        }
        row += 1
    }
    if out_col > 0 {
        ReflowFinishLine(&out_row, &out_col)
    }
    if spec->cursor_output_row != nil {
        *spec->cursor_output_row = cursor_row
    }
    if spec->cursor_output_col != nil {
        *spec->cursor_output_col = cursor_col
    }
    if spec->output_row_count != nil {
        *spec->output_row_count = out_row
    }
    return 1
}
