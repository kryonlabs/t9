TerminalPaneReflowBlankCellFn :: #type (
    cell: *void, userdata: *void) -> s32 #c_call;
TerminalPaneReflowSpec :: struct {
    input_cells: *void
    input_wrapped: *u8
    input_cols: s32
    input_rows: s32
    output_cells: *void
    output_wrapped: *u8
    output_cols: s32
    output_rows: s32
    cell_size: usize
    blank_cell: *void
    is_blank: TerminalPaneReflowBlankCellFn
    userdata: *void
    trim_blank_rows_after_cursor: s32
    cursor_input_col: s32
    cursor_input_row: s32
    cursor_output_col: *s32
    cursor_output_row: *s32
    output_row_count: *s32
}

#scope_file
CellOffset :: (cols: s32, row: s32, col: s32, cell_size: usize) -> s64 {
    return cast(s64)(cast(u64)row * cast(u64)cols +
        cast(u64)col) * cast(s64)cell_size
}

InputCell :: (spec: *TerminalPaneReflowSpec, row: s32,
    col: s32) -> *u8 {
    input: *u8
    if spec == null || spec.input_cells == null || row < 0 ||
       row >= spec.input_rows || col < 0 || col >= spec.input_cols {
        return null
    }
    input = cast(*u8)spec.input_cells
    return *input[CellOffset(spec.input_cols, row, col, spec.cell_size)]
}

BytesEqual :: (left: *u8, right: *u8, size: usize) -> bool {
    index: u64 = 0
    if left == null || right == null { return false }
    while index < cast(u64)size {
        if left[cast(s64)index] != right[cast(s64)index] { return false }
        index += 1
    }
    return true
}

CopyBytes :: (destination: *u8, source: *u8, size: usize) {
    index: u64 = 0
    if destination == null || source == null { return }
    while index < cast(u64)size {
        destination[cast(s64)index] = source[cast(s64)index]
        index += 1
    }
}
#scope_file

ReflowCellIsBlank :: (spec: *TerminalPaneReflowSpec,
    cell: *u8) -> s32 {
    if spec == null || cell == null { return 1 }
    if spec.is_blank != null {
        return spec.is_blank(cast(*void)cell, spec.userdata)
    }
    if spec.blank_cell != null {
        return cast(s32)BytesEqual(cell, cast(*u8)spec.blank_cell,
            spec.cell_size)
    }
    return 0
}

ReflowCopyCell :: (spec: *TerminalPaneReflowSpec, row: s32, col: s32,
    cell: *u8) {
    output: *u8
    if spec == null || cell == null || spec.output_cells == null ||
       row < 0 || row >= spec.output_rows || col < 0 ||
       col >= spec.output_cols { return }
    output = cast(*u8)spec.output_cells
    CopyBytes(*output[CellOffset(spec.output_cols, row, col,
        spec.cell_size)], cell, spec.cell_size)
}

ReflowFillOutput :: (spec: *TerminalPaneReflowSpec) {
    row: s32 = 0
    if spec == null { return }
    if spec.output_wrapped != null {
        while row < spec.output_rows {
            spec.output_wrapped[row] = 0
            row += 1
        }
    }
    if spec.output_cells == null || spec.blank_cell == null { return }
    row = 0
    while row < spec.output_rows {
        col: s32 = 0
        while col < spec.output_cols {
            ReflowCopyCell(spec, row, col, cast(*u8)spec.blank_cell)
            col += 1
        }
        row += 1
    }
}

ReflowRowTextEnd :: (spec: *TerminalPaneReflowSpec, row: s32,
    keep_full: s32) -> s32 {
    end: s32
    if spec == null || row < 0 || row >= spec.input_rows ||
       spec.input_cols <= 0 { return 0 }
    if keep_full != 0 { return spec.input_cols }
    end = spec.input_cols
    while end > 0 && ReflowCellIsBlank(spec,
            InputCell(spec, row, end - 1)) != 0 {
        end -= 1
    }
    return end
}

ReflowAppendCell :: (spec: *TerminalPaneReflowSpec, out_row: *s32,
    out_col: *s32, cell: *u8) {
    if spec == null || out_row == null || out_col == null ||
       spec.output_cols <= 0 { return }
    if out_col.* >= spec.output_cols {
        if spec.output_wrapped != null && out_row.* >= 0 &&
           out_row.* < spec.output_rows {
            spec.output_wrapped[out_row.*] = 1
        }
        out_row.* += 1
        out_col.* = 0
    }
    ReflowCopyCell(spec, out_row.*, out_col.*, cell)
    out_col.* += 1
}

ReflowFinishLine :: (out_row: *s32, out_col: *s32) {
    if out_row == null || out_col == null { return }
    out_row.* += 1
    out_col.* = 0
}

#scope_export

#program_export
TerminalPaneReflowRows :: (spec: *TerminalPaneReflowSpec) -> s32 {
    input_rows: s32
    out_row: s32 = 0
    out_col: s32 = 0
    cursor_row: s32 = -1
    cursor_col: s32 = -1
    row: s32 = 0
    if spec == null || spec.input_cells == null ||
       spec.output_cells == null || spec.input_cols <= 0 ||
       spec.input_rows <= 0 || spec.output_cols <= 0 ||
       spec.output_rows <= 0 || spec.cell_size == 0 { return 0 }
    ReflowFillOutput(spec)
    input_rows = spec.input_rows
    if spec.trim_blank_rows_after_cursor != 0 {
        while input_rows > spec.cursor_input_row + 1 {
            soft: bool = spec.input_wrapped != null &&
                spec.input_wrapped[input_rows - 1] != 0
            if soft || ReflowRowTextEnd(spec, input_rows - 1, 0) > 0 {
                break
            }
            input_rows -= 1
        }
    }
    while row < input_rows {
        soft: bool = spec.input_wrapped != null &&
                spec.input_wrapped[row] != 0
        end: s32 = ReflowRowTextEnd(spec, row, cast(s32)soft)
        col: s32 = 0
        while col < end {
            if row == spec.cursor_input_row &&
               col == spec.cursor_input_col {
                cursor_row = out_row
                cursor_col = out_col
            }
            ReflowAppendCell(spec, *out_row, *out_col,
                InputCell(spec, row, col))
            col += 1
        }
        if row == spec.cursor_input_row && cursor_row < 0 {
            cursor_row = out_row
            extra: s32 = 0
            if spec.cursor_input_col > end {
                extra = spec.cursor_input_col - end
            }
            cursor_col = out_col + extra
            while cursor_col >= spec.output_cols {
                cursor_row += 1
                cursor_col -= spec.output_cols
            }
        }
        if !soft { ReflowFinishLine(*out_row, *out_col) }
        row += 1
    }
    if out_col > 0 { ReflowFinishLine(*out_row, *out_col) }
    if spec.cursor_output_row != null {
        spec.cursor_output_row.* = cursor_row
    }
    if spec.cursor_output_col != null {
        spec.cursor_output_col.* = cursor_col
    }
    if spec.output_row_count != null {
        spec.output_row_count.* = out_row
    }
    return 1
}
