#import "terminal_pane_profile"
#import "terminal_pane_profile_types"
#import "terminal_pane_profile_settings"


PanePromptInfo :: struct {
    title: *u8
    setting: *u8
}


AppendByte :: (output: *u8, output_size: s32, used: *s32, value: u8) -> bool {
    if output == null || used == null || used.* < 0 || used.* + 1 >= output_size { return false }
    output[used.*] = value
    used.* += 1
    output[used.*] = 0
    return true
}

AppendNumber :: (output: *u8, output_size: s32, used: *s32, value: s32) -> bool {
    digits: [16]u8
    next: s32 = 15
    remaining: u32
    digits[next] = 0
    next -= 1
    if value < 0 {
        if !AppendByte(output, output_size, used, 45) { return false }
        remaining = cast(u32)(0 - value)
    } else {
        remaining = cast(u32)value
    }
    while true {
        digits[next] = cast(u8)(48 + remaining % 10)
        remaining /= 10
        if remaining == 0 { break }
        next -= 1
    }
    while next < 15 {
        if !AppendByte(output, output_size, used, digits[next]) { return false }
        next += 1
    }
    return true
}

CopyText :: (output: *u8, output_size: s32, value: *u8) -> s32 {
    length: s32 = 0
    if output == null || output_size <= 0 { return 0 }
    output[0] = 0
    if value == null { return 0 }
    while value[length] != 0 {
        if length < output_size - 1 { output[length] = value[length] }
        length += 1
    }
    if length < output_size { output[length] = 0 }
    return length
}

PanePrompt :: (prompt: s32) -> PanePromptInfo {
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SHELL { return PanePromptInfo.{TerminalPaneTextBytes("Shell"), TerminalPaneTextBytes("shell")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_WORKING_DIRECTORY { return PanePromptInfo.{TerminalPaneTextBytes("Working Directory"), TerminalPaneTextBytes("working-directory")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_TERMINAL_FONT { return PanePromptInfo.{TerminalPaneTextBytes("Terminal Font"), TerminalPaneTextBytes("terminal-font")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_FONT_SIZE { return PanePromptInfo.{TerminalPaneTextBytes("Font Size"), TerminalPaneTextBytes("font-size")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SCROLLBACK { return PanePromptInfo.{TerminalPaneTextBytes("Scrollback Lines"), TerminalPaneTextBytes("scrollback")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_FOREGROUND { return PanePromptInfo.{TerminalPaneTextBytes("Terminal Foreground"), TerminalPaneTextBytes("terminal-foreground")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND { return PanePromptInfo.{TerminalPaneTextBytes("Terminal Background"), TerminalPaneTextBytes("terminal-background")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_CURSOR_COLOR { return PanePromptInfo.{TerminalPaneTextBytes("Terminal Cursor"), TerminalPaneTextBytes("terminal-cursor")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_FOREGROUND { return PanePromptInfo.{TerminalPaneTextBytes("Selection Foreground"), TerminalPaneTextBytes("terminal-selection-foreground")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_BACKGROUND { return PanePromptInfo.{TerminalPaneTextBytes("Selection Background"), TerminalPaneTextBytes("terminal-selection-background")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DYNAMIC_TITLE_MODE { return PanePromptInfo.{TerminalPaneTextBytes("Dynamic Title Mode"), TerminalPaneTextBytes("dynamic-title-mode")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKSPACE_BINDING { return PanePromptInfo.{TerminalPaneTextBytes("Backspace Key"), TerminalPaneTextBytes("backspace-binding")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DELETE_BINDING { return PanePromptInfo.{TerminalPaneTextBytes("Delete Key"), TerminalPaneTextBytes("delete-binding")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_AMBIGUOUS_WIDTH { return PanePromptInfo.{TerminalPaneTextBytes("Ambiguous Width"), TerminalPaneTextBytes("ambiguous-width")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_ALLOW_BOLD { return PanePromptInfo.{TerminalPaneTextBytes("Allow Bold Text"), TerminalPaneTextBytes("allow-bold")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_UNLIMITED_SCROLLBACK { return PanePromptInfo.{TerminalPaneTextBytes("Unlimited Scrollback"), TerminalPaneTextBytes("unlimited-scrollback")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_AUTO_HIDE_MOUSE { return PanePromptInfo.{TerminalPaneTextBytes("Auto-hide Mouse"), TerminalPaneTextBytes("auto-hide-mouse")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_MIDDLE_CLICK_CLOSE_TAB { return PanePromptInfo.{TerminalPaneTextBytes("Middle Click Closes Tab"), TerminalPaneTextBytes("middle-click-closes-tab")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_ALWAYS_SHOW_TABS { return PanePromptInfo.{TerminalPaneTextBytes("Always Show Tabs"), TerminalPaneTextBytes("always-show-tabs")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_MENU_MNEMONICS { return PanePromptInfo.{TerminalPaneTextBytes("Disable Menu Access Keys"), TerminalPaneTextBytes("disable-menu-mnemonics")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_MENU_SHORTCUT { return PanePromptInfo.{TerminalPaneTextBytes("Disable Menu Shortcut"), TerminalPaneTextBytes("disable-menu-shortcut")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_HELP_SHORTCUT { return PanePromptInfo.{TerminalPaneTextBytes("Disable Help Shortcut"), TerminalPaneTextBytes("disable-help-shortcut")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_OPACITY { return PanePromptInfo.{TerminalPaneTextBytes("Background Opacity"), TerminalPaneTextBytes("background-opacity")} }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_IMAGE { return PanePromptInfo.{TerminalPaneTextBytes("Background Image"), TerminalPaneTextBytes("background-image")} }
    return PanePromptInfo.{TerminalPaneTextBytes("Profile"), null}
}

PanePromptColor :: (output: *u8, output_size: s32, color: s32) -> s32 {
    if output == null || output_size <= 0 { return 0 }
    if color == TERMINAL_PANE_COLOR_DEFAULT { return CopyText(output, output_size, TerminalPaneTextBytes("default")) }
    formatted: s32 = FormatTerminalPaneProfileColor(output, output_size, color)
    if formatted > 0 { return formatted }
    output[0] = 0
    return 0
}
#scope_export

#program_export
TerminalPaneProfilePromptTitle :: (prompt: s32) -> *u8 {
    return PanePrompt(prompt).title
}

#program_export
TerminalPaneProfilePromptSettingName :: (prompt: s32) -> *u8 {
    return PanePrompt(prompt).setting
}

#program_export
TerminalPaneProfilePromptAffectsColors :: (prompt: s32) -> s32 {
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_FOREGROUND ||
       prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND ||
       prompt == TERMINAL_PANE_PROFILE_PROMPT_CURSOR_COLOR ||
       prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_FOREGROUND ||
       prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_BACKGROUND { return 1 }
    return 0
}

#program_export
TerminalPaneProfilePromptAffectsFont :: (prompt: s32) -> s32 {
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_TERMINAL_FONT { return 1 }
    return 0
}

#program_export
TerminalPaneProfilePromptAffectsScrollback :: (prompt: s32) -> s32 {
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SCROLLBACK ||
       prompt == TERMINAL_PANE_PROFILE_PROMPT_UNLIMITED_SCROLLBACK { return 1 }
    return 0
}

#program_export
FormatTerminalPaneProfilePromptValue :: (output: *u8, output_size: s32, settings: *TerminalPaneProfileSettings, prompt: s32) -> s32 {
    used: s32 = 0
    if output == null || output_size <= 0 { return 0 }
    output[0] = 0
    if settings == null { return 0 }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SHELL { return CopyText(output, output_size, *settings.shell[0]) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_WORKING_DIRECTORY { return CopyText(output, output_size, *settings.working_directory[0]) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_TERMINAL_FONT { return CopyText(output, output_size, *settings.terminal_font[0]) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_FONT_SIZE {
        if !AppendNumber(output, output_size, *used, settings.font_size) { output[0] = 0; return 0 }
        return used
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SCROLLBACK {
        if !AppendNumber(output, output_size, *used, settings.scrollback_limit) { output[0] = 0; return 0 }
        return used
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_FOREGROUND { return PanePromptColor(output, output_size, settings.terminal_foreground) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND { return PanePromptColor(output, output_size, settings.terminal_background) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_CURSOR_COLOR { return PanePromptColor(output, output_size, settings.terminal_cursor) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_FOREGROUND { return PanePromptColor(output, output_size, settings.terminal_selection_foreground) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_SELECTION_BACKGROUND { return PanePromptColor(output, output_size, settings.terminal_selection_background) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DYNAMIC_TITLE_MODE {
        if settings.dynamic_title_mode == TERMINAL_PANE_TITLE_PREPEND { return CopyText(output, output_size, TerminalPaneTextBytes("prepend")) }
        if settings.dynamic_title_mode == TERMINAL_PANE_TITLE_APPEND { return CopyText(output, output_size, TerminalPaneTextBytes("append")) }
        if settings.dynamic_title_mode == TERMINAL_PANE_TITLE_IGNORE { return CopyText(output, output_size, TerminalPaneTextBytes("ignore")) }
        return CopyText(output, output_size, TerminalPaneTextBytes("replace"))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKSPACE_BINDING || prompt == TERMINAL_PANE_PROFILE_PROMPT_DELETE_BINDING {
        binding: s32 = ifx prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKSPACE_BINDING then settings.backspace_binding else settings.delete_binding
        if binding == TERMINAL_PANE_KEY_BINDING_CONTROL_H { return CopyText(output, output_size, TerminalPaneTextBytes("control-h")) }
        if binding == TERMINAL_PANE_KEY_BINDING_ESCAPE_SEQUENCE { return CopyText(output, output_size, TerminalPaneTextBytes("escape-sequence")) }
        return CopyText(output, output_size, TerminalPaneTextBytes("ascii-delete"))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_AMBIGUOUS_WIDTH {
        if settings.ambiguous_width_wide != 0 { return CopyText(output, output_size, TerminalPaneTextBytes("wide")) }
        return CopyText(output, output_size, TerminalPaneTextBytes("narrow"))
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_ALLOW_BOLD { if settings.allow_bold != 0 { return CopyText(output, output_size, TerminalPaneTextBytes("true")) }; return CopyText(output, output_size, TerminalPaneTextBytes("false")) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_UNLIMITED_SCROLLBACK { if settings.unlimited_scrollback != 0 { return CopyText(output, output_size, TerminalPaneTextBytes("true")) }; return CopyText(output, output_size, TerminalPaneTextBytes("false")) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_AUTO_HIDE_MOUSE { if settings.auto_hide_mouse != 0 { return CopyText(output, output_size, TerminalPaneTextBytes("true")) }; return CopyText(output, output_size, TerminalPaneTextBytes("false")) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_MIDDLE_CLICK_CLOSE_TAB { if settings.middle_click_closes_tab != 0 { return CopyText(output, output_size, TerminalPaneTextBytes("true")) }; return CopyText(output, output_size, TerminalPaneTextBytes("false")) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_ALWAYS_SHOW_TABS { if settings.always_show_tabs != 0 { return CopyText(output, output_size, TerminalPaneTextBytes("true")) }; return CopyText(output, output_size, TerminalPaneTextBytes("false")) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_MENU_MNEMONICS { if settings.disable_menu_mnemonics != 0 { return CopyText(output, output_size, TerminalPaneTextBytes("true")) }; return CopyText(output, output_size, TerminalPaneTextBytes("false")) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_MENU_SHORTCUT { if settings.disable_menu_shortcut != 0 { return CopyText(output, output_size, TerminalPaneTextBytes("true")) }; return CopyText(output, output_size, TerminalPaneTextBytes("false")) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_DISABLE_HELP_SHORTCUT { if settings.disable_help_shortcut != 0 { return CopyText(output, output_size, TerminalPaneTextBytes("true")) }; return CopyText(output, output_size, TerminalPaneTextBytes("false")) }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_OPACITY {
        if !AppendNumber(output, output_size, *used, settings.background_opacity) { output[0] = 0; return 0 }
        return used
    }
    if prompt == TERMINAL_PANE_PROFILE_PROMPT_BACKGROUND_IMAGE { return CopyText(output, output_size, *settings.background_image[0]) }
    return 0
}

#program_export
ApplyTerminalPaneProfilePromptValue :: (settings: *TerminalPaneProfileSettings, limits: TerminalPaneProfileLimits, prompt: s32, value: *u8) -> s32 {
    name: *u8 = TerminalPaneProfilePromptSettingName(prompt)
    if name == null { return 0 }
    return ApplyTerminalPaneProfileSetting(settings, limits, name, value)
}
