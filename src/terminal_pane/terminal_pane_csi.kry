#module "terminal_pane_csi_host"
#import "terminal_pane.h"
#import "stdio.h"

TerminalPaneCSILiteral :: (out: *char, out_size: i32,
text: const char*) -> i32 {
    if out == nil || out_size <= 0 || text == nil { return 0 }
    out[0] = '\0'
    length: i32 = snprintf(out, (size_t)out_size, "%s", text)
    if length <= 0 || length >= out_size {
        out[0] = '\0'
        return 0
    }
    return length
}

FormatTerminalPaneDeviceStatusReport :: (out: *char, out_size: i32,
private_mode: i32, request: i32, cursor_row: i32,
cursor_col: i32) -> i32 #export {
    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if private_mode != 0 {
        if request == 6 {
            length: i32 = snprintf(out, (size_t)out_size,
            "\x1b[?%d;%dR", cursor_row + 1, cursor_col + 1)
            if length <= 0 || length >= out_size {
                out[0] = '\0'
                return 0
            }
            return length
        }
        if request == 15 {
            return TerminalPaneCSILiteral(out, out_size, "\x1b[?10n")
        }
        if request == 25 {
            return TerminalPaneCSILiteral(out, out_size, "\x1b[?20n")
        }
        if request == 26 {
            return TerminalPaneCSILiteral(out, out_size, "\x1b[?27;1;0;0n")
        }
        if request == 55 {
            return TerminalPaneCSILiteral(out, out_size, "\x1b[?53n")
        }
        if request == 56 {
            return TerminalPaneCSILiteral(out, out_size, "\x1b[?57;0n")
        }
        if request == 75 {
            return TerminalPaneCSILiteral(out, out_size, "\x1b[?70n")
        }
        if request == 85 {
            return TerminalPaneCSILiteral(out, out_size, "\x1b[?83n")
        }
        return 0
    }
    if request == 5 {
        return TerminalPaneCSILiteral(out, out_size, "\x1b[0n")
    }
    if request == 6 {
        length: i32 = snprintf(out, (size_t)out_size,
        "\x1b[%d;%dR", cursor_row + 1, cursor_col + 1)
        if length <= 0 || length >= out_size {
            out[0] = '\0'
            return 0
        }
        return length
    }
    return 0
}
