#module "terminal_pane_sgr_host"
#import "terminal_pane.h"
#import "stdio.h"
#import "string.h"

TerminalPaneAppendText :: (buffer: *char, buffer_size: i32,
used: *i32, value: const char*) -> i32 {
    if buffer == nil || used == nil || value == nil ||
    buffer_size <= 0 {
        return 0
    }
    length: i32 = (int)strlen(value)
    if *used < 0 || *used + length >= buffer_size { return 0 }
    memcpy(buffer + *used, value, (size_t)length)
    *used += length
    buffer[*used] = '\0'
    return 1
}

TerminalPaneAppendParam :: (buffer: *char, buffer_size: i32,
used: *i32, first: *i32, value: const char*) -> i32 {
    if first == nil { return 0 }
    if *first == 0 &&
    TerminalPaneAppendText(buffer, buffer_size, used, ";") == 0 {
        return 0
    }
    if TerminalPaneAppendText(buffer, buffer_size, used, value) == 0 {
        return 0
    }
    *first = 0
    return 1
}

TerminalPaneAppendNumber :: (buffer: *char, buffer_size: i32,
used: *i32, first: *i32, value: i32) -> i32 {
    digits: [32]char
    snprintf(digits, sizeof(digits), "%d", value)
    return TerminalPaneAppendParam(
    buffer, buffer_size, used, first, digits)
}

TerminalPaneAppendColor :: (buffer: *char, buffer_size: i32,
used: *i32, first: *i32, prefix: i32, value: i32) -> i32 {
    if value == TERMINAL_PANE_COLOR_DEFAULT { return 1 }
    digits: [64]char
    if (value & TERMINAL_PANE_COLOR_TRUE_RGB) != 0 {
        rgb: i32 = value & 0xffffff
        snprintf(digits, sizeof(digits), "%d;2;%d;%d;%d",
        prefix, (rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255)
    } else {
        snprintf(digits, sizeof(digits), "%d;5;%d",
        prefix, value & 255)
    }
    return TerminalPaneAppendParam(
    buffer, buffer_size, used, first, digits)
}

TerminalPaneClearStatus :: (out: *char) -> i32 {
    if out != nil { out[0] = '\0' }
    return 0
}

FormatTerminalPaneSGRStatus :: (out: *char, out_size: i32,
status: TerminalPaneSGRStatus) -> i32 #export {
    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    used: i32 = 0
    first: i32 = 1
    if (status.styles & TERMINAL_PANE_SGR_BOLD) != 0 &&
    TerminalPaneAppendNumber(out, out_size, &used, &first, 1) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if (status.styles & TERMINAL_PANE_SGR_FAINT) != 0 &&
    TerminalPaneAppendNumber(out, out_size, &used, &first, 2) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if (status.styles & TERMINAL_PANE_SGR_ITALIC) != 0 &&
    TerminalPaneAppendNumber(out, out_size, &used, &first, 3) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if (status.styles & TERMINAL_PANE_SGR_UNDERLINE) != 0 &&
    TerminalPaneAppendNumber(out, out_size, &used, &first, 4) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if (status.styles & TERMINAL_PANE_SGR_BLINK) != 0 &&
    TerminalPaneAppendNumber(out, out_size, &used, &first, 5) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if (status.styles & TERMINAL_PANE_SGR_INVERSE) != 0 &&
    TerminalPaneAppendNumber(out, out_size, &used, &first, 7) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if (status.styles & TERMINAL_PANE_SGR_CONCEAL) != 0 &&
    TerminalPaneAppendNumber(out, out_size, &used, &first, 8) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if (status.styles & TERMINAL_PANE_SGR_STRIKE) != 0 &&
    TerminalPaneAppendNumber(out, out_size, &used, &first, 9) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if (status.styles & TERMINAL_PANE_SGR_OVERLINE) != 0 &&
    TerminalPaneAppendNumber(out, out_size, &used, &first, 53) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if TerminalPaneAppendColor(out, out_size, &used, &first,
    38, status.foreground) == 0 ||
    TerminalPaneAppendColor(out, out_size, &used, &first,
    48, status.background) == 0 ||
    TerminalPaneAppendColor(out, out_size, &used, &first,
    58, status.underline) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if first != 0 &&
    TerminalPaneAppendNumber(out, out_size, &used, &first, 0) == 0 {
        return TerminalPaneClearStatus(out)
    }
    if TerminalPaneAppendText(out, out_size, &used, "m") == 0 {
        return TerminalPaneClearStatus(out)
    }
    return used
}
