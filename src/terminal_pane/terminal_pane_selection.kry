#module "terminal_pane_selection_host"
#inspect off
#import "terminal_pane.h"
#import "ctype.h"
#import "string.h"

primary_selection_copy_buffer :: [262144]char #global
clipboard_selection_copy_buffer :: [262144]char #global

PaneClampInt :: (value: i32, low: i32, high: i32) -> i32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

PaneMaxInt :: (a: i32, b: i32) -> i32 {
    return a > b ? a : b
}

PaneWordChar :: (ch: i32) -> i32 {
    return isalnum((unsigned char)ch) || ch == '_' ||
    ch == '-' || ch == '.' || ch == '/' || ch == ':' || ch == '~'
}

PaneWordBounds :: (line: const char*, length: i32,
col: i32, start: *i32, end: *i32) {
    if start != nil { *start = col }
    if end != nil { *end = col + 1 }
    if line == nil || length <= 0 { return }
    col = PaneClampInt(col, 0, PaneMaxInt(0, length))
    if col >= length { col = length - 1 }
    if !PaneWordChar((unsigned char)line[col]) { return }
    left: i32 = col
    right: i32 = col + 1
    while left > 0 && PaneWordChar((unsigned char)line[left - 1]) {
        left -= 1
    }
    while right < length && PaneWordChar((unsigned char)line[right]) {
        right += 1
    }
    if start != nil { *start = left }
    if end != nil { *end = right }
}

PaneSelectionLineText :: (line_text: TerminalPaneSelectionLineFn,
userdata: *void, row: i32, out: *char, out_size: i32) -> i32 {
    if out == nil || out_size <= 0 { return 0 }
    out[0] = '\0'
    if line_text == nil { return 0 }
    return line_text(userdata, row, out, out_size)
}

TerminalPaneSelectionClear :: (selection: *TerminalPaneSelection) #export {
    if selection == nil { return }
    *selection = (TerminalPaneSelection){0}
}

TerminalPaneSelectionSetRange :: (selection: *TerminalPaneSelection,
mode: i32, dragging: i32, start_row: i32, start_col: i32,
end_row: i32, end_col: i32) #export {
    if selection == nil { return }
    selection->active = 1
    selection->dragging = dragging ? 1 : 0
    selection->mode = mode
    selection->start_row = start_row
    selection->start_col = start_col
    selection->end_row = end_row
    selection->end_col = end_col
    selection->anchor_row = start_row
    selection->anchor_start_col = start_col
    selection->anchor_end_col = end_col
}

TerminalPaneSelectionBeginChar :: (selection: *TerminalPaneSelection,
row: i32, col: i32) #export {
    TerminalPaneSelectionSetRange(selection,
    TERMINAL_PANE_SELECTION_CHAR, 1, row, col, row, col + 1)
}

TerminalPaneSelectionSelectLine :: (selection: *TerminalPaneSelection,
line_text: TerminalPaneSelectionLineFn,
userdata: *void, row: i32) #export {
    if selection == nil || row < 0 { return }
    line: [4096]char
    PaneSelectionLineText(line_text, userdata, row, line, 4096)
    length: i32 = (int)strlen(line)
    TerminalPaneSelectionSetRange(selection,
    TERMINAL_PANE_SELECTION_LINE, 1, row, 0, row, length)
}

TerminalPaneSelectionSelectWord :: (selection: *TerminalPaneSelection,
line_text: TerminalPaneSelectionLineFn,
userdata: *void, row: i32, col: i32) #export {
    if selection == nil || row < 0 { return }
    line: [4096]char
    PaneSelectionLineText(line_text, userdata, row, line, 4096)
    length: i32 = (int)strlen(line)
    col = PaneClampInt(col, 0, PaneMaxInt(0, length))
    if length == 0 {
        TerminalPaneSelectionSelectLine(selection,
        line_text, userdata, row)
        selection->mode = TERMINAL_PANE_SELECTION_WORD
        return
    }
    start: i32 = 0
    end: i32 = 0
    PaneWordBounds(line, length, col, &start, &end)
    TerminalPaneSelectionSetRange(selection,
    TERMINAL_PANE_SELECTION_WORD, 1, row, start, row, end)
}

TerminalPaneSelectionSelectAll :: (selection: *TerminalPaneSelection,
total_rows: i32, cols: i32) #export {
    if selection == nil || total_rows <= 0 { return }
    if cols < 0 { cols = 0 }
    TerminalPaneSelectionSetRange(selection,
    TERMINAL_PANE_SELECTION_CHAR, 0, 0, 0, total_rows - 1, cols)
}

TerminalPaneSelectionUpdateEnd :: (selection: *TerminalPaneSelection,
line_text: TerminalPaneSelectionLineFn,
userdata: *void, row: i32, col: i32) #export {
    if selection == nil || row < 0 { return }
    if selection->mode == TERMINAL_PANE_SELECTION_LINE {
        line: [4096]char
        PaneSelectionLineText(line_text, userdata, row, line, 4096)
        length: i32 = (int)strlen(line)
        if row < selection->start_row {
            start_line: [4096]char
            PaneSelectionLineText(line_text, userdata,
            selection->start_row, start_line, 4096)
            selection->start_col = (int)strlen(start_line)
            selection->end_col = 0
        } else {
            selection->start_col = 0
            selection->end_col = length
        }
        selection->end_row = row
        return
    }
    if selection->mode == TERMINAL_PANE_SELECTION_WORD {
        line: [4096]char
        PaneSelectionLineText(line_text, userdata, row, line, 4096)
        length: i32 = (int)strlen(line)
        col = PaneClampInt(col, 0, PaneMaxInt(0, length))
        start: i32 = 0
        end: i32 = 0
        PaneWordBounds(line, length, col, &start, &end)
        if row < selection->anchor_row ||
        (row == selection->anchor_row &&
        start < selection->anchor_start_col) {
            selection->start_row = selection->anchor_row
            selection->start_col = selection->anchor_end_col
            selection->end_row = row
            selection->end_col = start
        } else {
            selection->start_row = selection->anchor_row
            selection->start_col = selection->anchor_start_col
            selection->end_row = row
            selection->end_col = end
        }
        return
    }
    selection->end_row = row
    selection->end_col = col + 1
}

TerminalPaneSelectionContains :: (selection: const TerminalPaneSelection*,
row: i32, col: i32) -> i32 #export {
    if selection == nil || !selection->active { return 0 }
    sr: i32 = selection->start_row
    er: i32 = selection->end_row
    sc: i32 = selection->start_col
    ec: i32 = selection->end_col
    if sr > er || (sr == er && sc > ec) {
        temporary: i32 = sr
        sr = er
        er = temporary
        temporary = sc
        sc = ec
        ec = temporary
    }
    if row < sr || row > er { return 0 }
    if row == sr && col < sc { return 0 }
    if row == er && col >= ec { return 0 }
    return 1
}

TerminalPaneSelectionCollectText :: (
selection: const TerminalPaneSelection*,
line_text: TerminalPaneSelectionLineFn,
line_wrapped: TerminalPaneSelectionWrappedFn,
userdata: *void, buffer: *char, buffer_size: i32) -> i32 #export {
    if buffer == nil || buffer_size <= 0 { return 0 }
    buffer[0] = '\0'
    if selection == nil || !selection->active || line_text == nil {
        return 0
    }
    sr: i32 = selection->start_row
    er: i32 = selection->end_row
    sc: i32 = selection->start_col
    ec: i32 = selection->end_col
    if sr > er || (sr == er && sc > ec) {
        temporary: i32 = sr
        sr = er
        er = temporary
        temporary = sc
        sc = ec
        ec = temporary
    }
    used: i32 = 0
    row: i32 = sr
    while row <= er && used < buffer_size - 1 {
        line: [4096]char
        PaneSelectionLineText(line_text, userdata, row, line, 4096)
        length: i32 = (int)strlen(line)
        start: i32 = row == sr ? sc : 0
        end: i32 = row == er ? ec : length
        start = PaneClampInt(start, 0, length)
        end = PaneClampInt(end, start, length)
        index: i32 = start
        while index < end && used < buffer_size - 1 {
            buffer[used] = line[index]
            used += 1
            index += 1
        }
        if row != er && used < buffer_size - 1 &&
        (line_wrapped == nil || !line_wrapped(userdata, row)) {
            buffer[used] = '\n'
            used += 1
        }
        row += 1
    }
    buffer[used] = '\0'
    return used > 0
}

TerminalPaneSelectionUpdatePrimary :: (
selection: const TerminalPaneSelection*,
line_text: TerminalPaneSelectionLineFn,
line_wrapped: TerminalPaneSelectionWrappedFn,
userdata: *void) -> i32 #export {
    if TerminalPaneSelectionCollectText(selection, line_text,
    line_wrapped, userdata, primary_selection_copy_buffer,
    262144) {
        return SetPrimarySelectionFromText(primary_selection_copy_buffer)
    }
    return SetPrimarySelectionFromText("")
}

TerminalPaneSelectionCopyToClipboard :: (
selection: const TerminalPaneSelection*,
line_text: TerminalPaneSelectionLineFn,
line_wrapped: TerminalPaneSelectionWrappedFn,
userdata: *void, clipboard: *ClipboardBuffer) -> i32 #export {
    if !TerminalPaneSelectionCollectText(selection, line_text,
    line_wrapped, userdata, clipboard_selection_copy_buffer,
    262144) {
        return 0
    }
    return CopySelectionTextToClipboard(clipboard,
    clipboard_selection_copy_buffer)
}

TerminalPaneSelectionEdgeScrollDelta :: (mouse_y: float,
viewport_y: float, viewport_height: float,
edge_size: float) -> i32 #export {
    if viewport_height <= 0.0 { return 0 }
    if edge_size < 0.0 { edge_size = 0.0 }
    if edge_size > viewport_height / 2.0 {
        edge_size = viewport_height / 2.0
    }
    if mouse_y < viewport_y + edge_size { return 1 }
    if mouse_y > viewport_y + viewport_height - edge_size {
        return -1
    }
    return 0
}

TerminalPaneSelectionFirstVisibleRow :: (total_rows: i32,
visible_rows: i32, scroll_offset: i32) -> i32 #export {
    if total_rows <= 0 || visible_rows <= 0 { return 0 }
    if scroll_offset < 0 { scroll_offset = 0 }
    first: i32 = total_rows - visible_rows - scroll_offset
    return first > 0 ? first : 0
}

TerminalPaneSelectionEdgeScrollRow :: (first_visible_row: i32,
visible_rows: i32, scroll_delta: i32) -> i32 #export {
    if visible_rows <= 0 || scroll_delta == 0 { return -1 }
    if scroll_delta > 0 { return first_visible_row }
    return first_visible_row + visible_rows - 1
}

PaneSearchCaseSensitive :: (needle: const char*) -> i32 {
    if needle == nil { return 0 }
    cursor: const unsigned char* =
    (const unsigned char*)needle
    while *cursor != '\0' {
        if isupper(*cursor) { return 1 }
        cursor += 1
    }
    return 0
}

PaneSearchCharsEqual :: (a: u8, b: u8,
case_sensitive: i32) -> i32 {
    if case_sensitive { return a == b }
    return tolower(a) == tolower(b)
}

PaneSearchFindFrom :: (line: const char*,
needle: const char*, case_sensitive: i32) -> const char* {
    if line == nil || needle == nil { return nil }
    needle_length: i32 = (int)strlen(needle)
    if needle_length <= 0 { return nil }
    cursor: const char* = line
    while *cursor != '\0' {
        index: i32 = 0
        while index < needle_length {
            if cursor[index] == '\0' ||
            !PaneSearchCharsEqual((unsigned char)cursor[index],
            (unsigned char)needle[index], case_sensitive) {
                break
            }
            index += 1
        }
        if index == needle_length { return cursor }
        cursor += 1
    }
    return nil
}

PaneSearchLastBefore :: (line: const char*,
needle: const char*, limit: i32,
case_sensitive: i32) -> const char* {
    if line == nil || needle == nil { return nil }
    needle_length: i32 = (int)strlen(needle)
    if needle_length <= 0 { return nil }
    cursor: const char* = line
    last: const char* = nil
    while true {
        cursor = PaneSearchFindFrom(cursor, needle, case_sensitive)
        if cursor == nil { break }
        if (int)(cursor - line) + needle_length > limit { break }
        last = cursor
        cursor += 1
    }
    return last
}

TerminalPaneSearchLines :: (line_text: TerminalPaneSelectionLineFn,
userdata: *void, total_rows: i32, needle: const char*,
start_row: i32, start_col: i32, direction: i32, wrap: i32,
out: *TerminalPaneSearchMatch) -> i32 #export {
    if out != nil {
        out->row = -1
        out->col = -1
        out->length = 0
    }
    if line_text == nil || total_rows <= 0 || needle == nil ||
    needle[0] == '\0' {
        return 0
    }
    needle_length: i32 = (int)strlen(needle)
    case_sensitive: i32 = PaneSearchCaseSensitive(needle)
    direction = direction >= 0 ? 1 : -1
    if start_row < 0 || start_row >= total_rows {
        start_row = direction > 0 ? 0 : total_rows - 1
    }
    pass: i32 = 0
    while pass < (wrap ? 2 : 1) {
        end_row: i32 = direction > 0 ? total_rows : -1
        row: i32 = start_row
        while row != end_row {
            line: [4096]char
            PaneSelectionLineText(line_text, userdata, row, line, 4096)
            line_length: i32 = (int)strlen(line)
            col_limit: i32 = 0
            match: const char* = nil
            if direction > 0 {
                col_limit = row == start_row ? start_col : 0
                col_limit = PaneClampInt(col_limit, 0, line_length)
                match = PaneSearchFindFrom(line + col_limit,
                needle, case_sensitive)
            } else {
                col_limit = row == start_row ? start_col : line_length
                col_limit = PaneClampInt(col_limit, 0, line_length)
                match = PaneSearchLastBefore(line, needle,
                col_limit, case_sensitive)
            }
            if match != nil {
                if out != nil {
                    out->row = row
                    out->col = (int)(match - line)
                    out->length = needle_length
                }
                return 1
            }
            row += direction
        }
        start_row = direction > 0 ? 0 : total_rows - 1
        start_col = direction > 0 ? 0 : 4096
        pass += 1
    }
    return 0
}

TerminalPaneSearchStartForDirection :: (
selection: const TerminalPaneSelection*, total_rows: i32,
first_visible_row: i32, direction: i32) -> TerminalPaneSearchStart #export {
    start: TerminalPaneSearchStart = (TerminalPaneSearchStart){0}
    if total_rows <= 0 {
        start.row = -1
        start.col = -1
        return start
    }
    direction = direction >= 0 ? 1 : -1
    if selection != nil && selection->active {
        if direction > 0 {
            start.row = selection->end_row
            start.col = selection->end_col
        } else {
            start.row = selection->start_row
            start.col = selection->start_col - 1
        }
    } else if direction > 0 {
        start.row = first_visible_row
        start.col = 0
    } else {
        start.row = total_rows - 1
        start.col = 4096
    }
    start.row = PaneClampInt(start.row, 0, total_rows - 1)
    return start
}

TerminalPaneSearchMatchScrollOffset :: (total_rows: i32,
visible_rows: i32, match_row: i32) -> i32 #export {
    if total_rows <= 0 || visible_rows <= 0 { return 0 }
    max_scroll: i32 = PaneMaxInt(0, total_rows - visible_rows)
    match_row = PaneClampInt(match_row, 0, total_rows - 1)
    return PaneClampInt(total_rows - visible_rows - match_row,
    0, max_scroll)
}

MakeTerminalPaneSearchController :: (
line_text: TerminalPaneSelectionLineFn,
userdata: *void, selection: *TerminalPaneSelection,
total_rows: i32, visible_rows: i32,
first_visible_row: i32, scroll_offset: *i32) -> TerminalPaneSearchController #export {
    controller: TerminalPaneSearchController =
    (TerminalPaneSearchController){0}
    controller.line_text = line_text
    controller.userdata = userdata
    controller.selection = selection
    controller.total_rows = total_rows
    controller.visible_rows = visible_rows
    controller.first_visible_row = first_visible_row
    controller.scroll_offset = scroll_offset
    return controller
}

TerminalPaneSearchSelectMatch :: (
controller: TerminalPaneSearchController,
match: TerminalPaneSearchMatch) -> i32 #export {
    if match.row < 0 || match.col < 0 || match.length <= 0 {
        return 0
    }
    if controller.scroll_offset != nil {
        *controller.scroll_offset = TerminalPaneSearchMatchScrollOffset(
        controller.total_rows, controller.visible_rows, match.row)
    }
    if controller.selection != nil {
        TerminalPaneSelectionSetRange(controller.selection,
        TERMINAL_PANE_SELECTION_CHAR, 0, match.row,
        match.col, match.row, match.col + match.length)
    }
    return 1
}

TerminalPaneSearchFindFrom :: (
controller: TerminalPaneSearchController,
needle: const char*, start_row: i32, start_col: i32,
direction: i32, wrap: i32,
out: *TerminalPaneSearchMatch) -> i32 #export {
    local_match: TerminalPaneSearchMatch
    if out == nil { out = &local_match }
    if !TerminalPaneSearchLines(controller.line_text,
    controller.userdata, controller.total_rows, needle,
    start_row, start_col, direction, wrap, out) {
        return 0
    }
    return TerminalPaneSearchSelectMatch(controller, *out)
}

TerminalPaneSearchFindNext :: (
controller: TerminalPaneSearchController,
needle: const char*, direction: i32,
out: *TerminalPaneSearchMatch) -> i32 #export {
    direction = direction >= 0 ? 1 : -1
    start: TerminalPaneSearchStart =
    TerminalPaneSearchStartForDirection(
    controller.selection, controller.total_rows,
    controller.first_visible_row, direction)
    return TerminalPaneSearchFindFrom(controller,
    needle, start.row, start.col, direction, 1, out)
}

TerminalPaneSearchFindInitial :: (
controller: TerminalPaneSearchController,
needle: const char*,
out: *TerminalPaneSearchMatch) -> i32 #export {
    return TerminalPaneSearchFindFrom(controller, needle,
    controller.total_rows - 1, 4096, -1, 0, out)
}
