#module "terminal_pane_text_host"
#import "terminal_pane.h"

AppendTerminalPaneUTF8Codepoint :: (out: *char, out_size: i32,
used: *i32, codepoint: u32) -> i32 #export {
    if out == nil || used == nil || out_size <= 0 ||
    *used < 0 || *used >= out_size {
        return 0
    }
    out[*used] = '\0'
    if codepoint == 0 || codepoint > 0x10ffff { return 0 }

    width: i32 = 1
    if codepoint >= 0x10000 {
        width = 4
    } else if codepoint >= 0x800 {
        width = 3
    } else if codepoint >= 0x80 {
        width = 2
    }
    if *used + width >= out_size { return 0 }

    if width == 1 {
        out[*used] = (char)codepoint
    } else if width == 2 {
        out[*used] = (char)(0xc0 | (codepoint >> 6))
        out[*used + 1] = (char)(0x80 | (codepoint & 0x3f))
    } else if width == 3 {
        out[*used] = (char)(0xe0 | (codepoint >> 12))
        out[*used + 1] = (char)(0x80 | ((codepoint >> 6) & 0x3f))
        out[*used + 2] = (char)(0x80 | (codepoint & 0x3f))
    } else {
        out[*used] = (char)(0xf0 | (codepoint >> 18))
        out[*used + 1] = (char)(0x80 | ((codepoint >> 12) & 0x3f))
        out[*used + 2] = (char)(0x80 | ((codepoint >> 6) & 0x3f))
        out[*used + 3] = (char)(0x80 | (codepoint & 0x3f))
    }
    *used += width
    out[*used] = '\0'
    return 1
}
