#module "terminal_pane_sixel_host"
#inspect off
#import "terminal_pane.h"
#import "stdlib.h"
#import "string.h"

TERMINAL_PANE_SIXEL_MAX_DIMENSION :: 4096
TERMINAL_PANE_SIXEL_MAX_PIXELS :: 4194304

TerminalPaneSixelBuilder :: struct {
    pixels: *i32
    width: i32
    height: i32
    max_x: i32
    max_y: i32
    raster_width: i32
    raster_height: i32
    pixel_aspect_num: i32
    pixel_aspect_den: i32
    x: i32
    y: i32
    color_index: i32
    palette: [256]i32
    background: i32
    transparent: i32
    failed: i32
}

clamp_sixel_int :: (value: i32, low: i32, high: i32) -> i32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

init_sixel_builder :: (builder: *TerminalPaneSixelBuilder,
transparent: i32, background: i32,
palette: TerminalPaneSixelPaletteFn,
userdata: *void) {
    i: i32

    memset(builder, 0, sizeof(TerminalPaneSixelBuilder))
    builder->max_x = -1
    builder->max_y = -1
    builder->color_index = 0
    builder->pixel_aspect_num = 1
    builder->pixel_aspect_den = 1
    builder->background = transparent != 0
    ? TERMINAL_PANE_COLOR_DEFAULT : background
    builder->transparent = transparent != 0 ? 1 : 0
    i = 0
    while i < 256 {
        builder->palette[i] = palette != nil
        ? palette(userdata, i)
        : TerminalPaneDefaultPaletteColor(i)
        i += 1
    }
}

ensure_sixel_canvas :: (builder: *TerminalPaneSixelBuilder,
width: i32, height: i32) -> i32 {
    if builder == nil || width <= 0 || height <= 0 ||
    builder->failed != 0 { return 0 }
    if width > TERMINAL_PANE_SIXEL_MAX_DIMENSION ||
    height > TERMINAL_PANE_SIXEL_MAX_DIMENSION ||
    (size_t)width * (size_t)height >
    (size_t)TERMINAL_PANE_SIXEL_MAX_PIXELS {
        builder->failed = 1
        return 0
    }
    if width <= builder->width && height <= builder->height {
        return 1
    }
    new_width: i32 = builder->width > 0 ? builder->width : 1
    new_height: i32 = builder->height > 0 ? builder->height : 1
    while new_width < width { new_width *= 2 }
    while new_height < height { new_height *= 2 }
    if new_width > TERMINAL_PANE_SIXEL_MAX_DIMENSION {
        new_width = width
    }
    if new_height > TERMINAL_PANE_SIXEL_MAX_DIMENSION {
        new_height = height
    }
    if (size_t)new_width * (size_t)new_height >
    (size_t)TERMINAL_PANE_SIXEL_MAX_PIXELS {
        new_width = width
        new_height = height
    }
    if (size_t)new_width * (size_t)new_height >
    (size_t)TERMINAL_PANE_SIXEL_MAX_PIXELS {
        builder->failed = 1
        return 0
    }
    pixels: *i32 = (int *)malloc((size_t)new_width *
    (size_t)new_height * sizeof(int))
    if pixels == nil {
        builder->failed = 1
        return 0
    }
    row: i32 = 0
    while row < new_height {
        col: i32 = 0
        while col < new_width {
            pixels[row * new_width + col] = builder->background
            col += 1
        }
        row += 1
    }
    row = 0
    while row < builder->height {
        memcpy(pixels + row * new_width,
        builder->pixels + row * builder->width,
        (size_t)builder->width * sizeof(int))
        row += 1
    }
    free(builder->pixels)
    builder->pixels = pixels
    builder->width = new_width
    builder->height = new_height
    return 1
}

read_sixel_number :: (cursor: **const char) -> i32 {
    value: i32 = 0
    seen: i32 = 0

    if cursor == nil || *cursor == nil { return -1 }
    while **cursor >= '0' && **cursor <= '9' {
        value = value * 10 + (**cursor - '0')
        *cursor += 1
        seen = 1
    }
    return seen != 0 ? value : -1
}

read_sixel_param :: (cursor: **const char, fallback: i32) -> i32 {
    value: i32 = read_sixel_number(cursor)

    if **cursor == ';' { *cursor += 1 }
    return value >= 0 ? value : fallback
}

percent_to_byte :: (value: i32) -> i32 {
    value = clamp_sixel_int(value, 0, 100)
    return value * 255 / 100
}

hls_to_rgb :: (hue: i32, lightness: i32, saturation: i32) -> i32 {
    c: i32
    x: i32
    m: i32
    segment: i32
    remainder: i32
    r: i32 = 0
    g: i32 = 0
    b: i32 = 0

    hue = hue % 360
    if hue < 0 { hue += 360 }
    lightness = clamp_sixel_int(lightness, 0, 100)
    saturation = clamp_sixel_int(saturation, 0, 100)
    c = (100 - abs(2 * lightness - 100)) * saturation / 100
    segment = hue / 60
    remainder = hue % 120
    x = c * (60 - abs(remainder - 60)) / 60
    m = lightness - c / 2
    if segment == 0 {
        r = c
        g = x
    } else if segment == 1 {
        r = x
        g = c
    } else if segment == 2 {
        g = c
        b = x
    } else if segment == 3 {
        g = x
        b = c
    } else if segment == 4 {
        r = x
        b = c
    } else {
        r = c
        b = x
    }
    r = percent_to_byte(r + m)
    g = percent_to_byte(g + m)
    b = percent_to_byte(b + m)
    return TERMINAL_PANE_COLOR_TRUE_RGB | (r << 16) | (g << 8) | b
}

put_sixel_column :: (builder: *TerminalPaneSixelBuilder, bits: i32) {
    if builder == nil || builder->failed != 0 { return }
    if ensure_sixel_canvas(builder, builder->x + 1,
    builder->y + 6) == 0 { return }
    bit: i32 = 0
    while bit < 6 {
        if (bits & (1 << bit)) != 0 {
            y: i32 = builder->y + bit

            builder->pixels[y * builder->width + builder->x] =
            builder->palette[builder->color_index]
            if builder->x > builder->max_x {
                builder->max_x = builder->x
            }
            if y > builder->max_y { builder->max_y = y }
        }
        bit += 1
    }
    if builder->x > builder->max_x { builder->max_x = builder->x }
    if builder->y + 5 > builder->max_y {
        builder->max_y = builder->y + 5
    }
    builder->x += 1
}

copy_sixel_result :: (out: *TerminalPaneSixelImage,
builder: *TerminalPaneSixelBuilder, width: i32,
height: i32) -> i32 {
    if out == nil || builder == nil || builder->pixels == nil ||
    width <= 0 || height <= 0 || builder->width < width ||
    builder->height < height { return 0 }
    pixels: *i32 = (int *)malloc((size_t)width *
    (size_t)height * sizeof(int))
    if pixels == nil { return 0 }
    row: i32 = 0
    while row < height {
        memcpy(pixels + row * width,
        builder->pixels + row * builder->width,
        (size_t)width * sizeof(int))
        row += 1
    }
    out->pixels = pixels
    out->width = width
    out->height = height
    out->pixel_aspect_num = builder->pixel_aspect_num > 0
    ? builder->pixel_aspect_num : 1
    out->pixel_aspect_den = builder->pixel_aspect_den > 0
    ? builder->pixel_aspect_den : 1
    return 1
}

DecodeTerminalPaneSixel :: (out: *TerminalPaneSixelImage,
payload: const char*, background: i32,
palette: TerminalPaneSixelPaletteFn,
userdata: *void) -> i32 #export {
    builder: TerminalPaneSixelBuilder
    cursor: const char*
    data: const char*
    transparent: i32 = 1
    width: i32
    height: i32
    rows_used: i32 = 0

    if out == nil { return 0 }
    memset(out, 0, sizeof(TerminalPaneSixelImage))
    if payload == nil { return 0 }
    data = strchr(payload, 'q')
    if data == nil { return 0 }
    cursor = payload
    if cursor < data {
        param_index: i32 = 0

        while cursor < data {
            value: i32 = read_sixel_number(&cursor)

            if param_index == 1 && value == 2 { transparent = 0 }
            if *cursor == ';' {
                cursor += 1
                param_index += 1
            } else if cursor < data {
                cursor += 1
            }
        }
    }
    init_sixel_builder(&builder, transparent, background, palette,
    userdata)
    cursor = data + 1
    while *cursor != '\0' && builder.failed == 0 {
        ch: i32 = (unsigned char)*cursor
        cursor += 1

        if ch >= '?' && ch <= '~' {
            put_sixel_column(&builder, ch - '?')
        } else if ch == '!' {
            repeat: i32 = read_sixel_number(&cursor)
            repeated: i32

            if repeat <= 0 { repeat = 1 }
            if *cursor == '\0' { break }
            repeated = (unsigned char)*cursor
            cursor += 1
            if repeated >= '?' && repeated <= '~' {
                i: i32

                repeat = clamp_sixel_int(repeat, 1,
                TERMINAL_PANE_SIXEL_MAX_DIMENSION)
                i = 0
                while i < repeat && builder.failed == 0 {
                    put_sixel_column(&builder, repeated - '?')
                    i += 1
                }
            }
        } else if ch == '$' {
            builder.x = 0
        } else if ch == '-' {
            builder.x = 0
            builder.y += 6
            if builder.y > TERMINAL_PANE_SIXEL_MAX_DIMENSION {
                builder.failed = 1
            }
        } else if ch == '#' {
            index: i32 = read_sixel_number(&cursor)

            if index >= 0 && index < 256 {
                builder.color_index = index
                if *cursor == ';' {
                    mode: i32
                    a: i32
                    b: i32
                    c: i32

                    cursor += 1
                    mode = read_sixel_param(&cursor, 0)
                    a = read_sixel_param(&cursor, 0)
                    b = read_sixel_param(&cursor, 0)
                    c = read_sixel_param(&cursor, 0)
                    if mode == 2 {
                        builder.palette[index] =
                        TERMINAL_PANE_COLOR_TRUE_RGB |
                        (percent_to_byte(a) << 16) |
                        (percent_to_byte(b) << 8) |
                        percent_to_byte(c)
                    } else if mode == 1 {
                        builder.palette[index] = hls_to_rgb(a, b, c)
                    }
                }
            }
        } else if ch == '"' {
            pan: i32 = read_sixel_param(&cursor, 0)
            pad: i32 = read_sixel_param(&cursor, 0)
            raster_width: i32 = read_sixel_param(&cursor, 0)
            raster_height: i32 = read_sixel_param(&cursor, 0)

            if pan > 0 && pad > 0 {
                builder.pixel_aspect_num = pan
                builder.pixel_aspect_den = pad
            }
            if raster_width > 0 && raster_height > 0 {
                builder.raster_width = raster_width
                builder.raster_height = raster_height
                ensure_sixel_canvas(&builder, raster_width,
                raster_height)
            }
        }
    }
    width = builder.max_x + 1
    height = builder.max_y + 1
    if builder.raster_width > width { width = builder.raster_width }
    if builder.raster_height > height {
        height = builder.raster_height
    }
    if builder.failed == 0 && width > 0 && height > 0 &&
    copy_sixel_result(out, &builder, width, height) != 0 {
        rows_used = (height + 5) / 6
        if rows_used < 1 { rows_used = 1 }
    }
    free(builder.pixels)
    if rows_used == 0 { FreeTerminalPaneSixelImage(out) }
    return rows_used
}

FreeTerminalPaneSixelImage :: (image: *TerminalPaneSixelImage) #export {
    if image == nil { return }
    free(image->pixels)
    memset(image, 0, sizeof(TerminalPaneSixelImage))
}
