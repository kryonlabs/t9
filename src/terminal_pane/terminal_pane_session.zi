TerminalPaneSessionRecord :: struct {
    cwd: [1024]u8
    shell: [512]u8
    command: [1024]u8
    title: [128]u8
    title_override: s32
    scroll_offset: s32
}

#scope_file
AppendByte :: (output: *u8, output_size: s32, used: *s32, value: u8) -> bool {
    if output == null || used == null || used.* < 0 ||
       used.* + 1 >= output_size { return false }
    output[used.*] = value
    used.* += 1
    output[used.*] = 0
    return true
}

AppendText :: (output: *u8, output_size: s32, used: *s32,
    value: string) -> bool {
    index: s32 = 0
    while index < cast(s32)value.count {
        if !AppendByte(output, output_size, used, value[index]) {
            return false
        }
        index += 1
    }
    return true
}

AppendRaw :: (output: *u8, output_size: s32, used: *s32,
    value: *u8) -> bool {
    if value == null { return true }
    index: s32 = 0
    while value[index] != 0 {
        if !AppendByte(output, output_size, used, value[index]) {
            return false
        }
        index += 1
    }
    return true
}

AppendNumber :: (output: *u8, output_size: s32, used: *s32,
    value: s32) -> bool {
    digits: [16]u8
    next: s32 = 15
    remaining: u32
    digits[next] = 0
    next -= 1
    if value < 0 {
        if !AppendByte(output, output_size, used, 45) { return false }
        remaining = cast(u32)(0 - value)
    } else {
        remaining = cast(u32)value
    }
    while true {
        digits[next] = cast(u8)(48 + remaining % 10)
        remaining /= 10
        if remaining == 0 { break }
        next -= 1
    }
    while next < 15 {
        if !AppendByte(output, output_size, used, digits[next]) {
            return false
        }
        next += 1
    }
    return true
}

TextLength :: (value: *u8) -> s32 {
    length: s32 = 0
    if value == null { return 0 }
    while value[length] != 0 { length += 1 }
    return length
}

CopyRaw :: (output: *u8, output_size: s32, value: *u8) -> s32 {
    used: s32 = 0
    if output == null || output_size <= 0 { return 0 }
    output[0] = 0
    if value != null {
        while value[used] != 0 && used < output_size - 1 {
            output[used] = value[used]
            used += 1
        }
    }
    output[used] = 0
    return used
}

EscapeText :: (output: *u8, output_size: s32, text: *u8) -> s32 {
    used: s32 = 0
    index: s32 = 0
    if output == null || output_size <= 0 { return 0 }
    output[0] = 0
    if text == null { return 0 }
    while text[index] != 0 && used < output_size - 1 {
        if text[index] == 92 {
            if used + 2 >= output_size { break }
            output[used] = 92
            output[used + 1] = 92
            used += 2
        } else if text[index] == 9 {
            if used + 2 >= output_size { break }
            output[used] = 92
            output[used + 1] = 116
            used += 2
        } else if text[index] == 10 {
            if used + 2 >= output_size { break }
            output[used] = 92
            output[used + 1] = 110
            used += 2
        } else if text[index] == 13 {
            if used + 2 >= output_size { break }
            output[used] = 92
            output[used + 1] = 114
            used += 2
        } else {
            output[used] = text[index]
            used += 1
        }
        index += 1
    }
    output[used] = 0
    return used
}

UnescapeText :: (output: *u8, output_size: s32, text: *u8) -> s32 {
    used: s32 = 0
    index: s32 = 0
    if output == null || output_size <= 0 { return 0 }
    output[0] = 0
    if text == null { return 0 }
    while text[index] != 0 && used < output_size - 1 {
        if text[index] == 92 && text[index + 1] != 0 {
            index += 1
            if text[index] == 116 {
                output[used] = 9
            } else if text[index] == 110 {
                output[used] = 10
            } else if text[index] == 114 {
                output[used] = 13
            } else {
                output[used] = text[index]
            }
        } else {
            output[used] = text[index]
        }
        used += 1
        index += 1
    }
    output[used] = 0
    return used
}

ParseNumberAt :: (value: *u8, start: s32) -> s32 {
    index: s32 = start
    sign: s32 = 1
    result: s32 = 0
    if value == null { return 0 }
    if value[0] == 45 {
        sign = -1
        index = 1
    } else if value[0] == 43 {
        index = 1
    }
    while value[index] >= 48 && value[index] <= 57 {
        result = result * 10 + cast(s32)(value[index] - 48)
        index += 1
    }
    return sign * result
}

PathTitleStart :: (value: *u8) -> s32 {
    length: s32 = TextLength(value)
    index: s32 = 0
    last_colon: s32 = -1
    if value == null { return 0 }
    while index < length {
        if value[index] == 58 && index + 1 < length &&
           (value[index + 1] == 47 || value[index + 1] == 126) {
            last_colon = index + 1
        }
        index += 1
    }
    if last_colon >= 0 { return last_colon }
    return 0
}

TitleStart :: (value: *u8, start: s32) -> s32 {
    length: s32 = TextLength(value)
    end: s32 = length
    slash: s32
    if value == null || start >= length { return 0 }
    while end > start && value[end - 1] == 47 { end -= 1 }
    slash = end
    while slash > start && value[slash - 1] != 47 { slash -= 1 }
    return slash
}

CopyTitleFallback :: (output: *u8, output_size: s32,
    fallback: *u8) -> s32 {
    if fallback != null && fallback[0] != 0 {
        return CopyRaw(output, output_size, fallback)
    }
    if output == null || output_size <= 0 { return 0 }
    output[0] = 116
    if output_size > 1 {
        output[1] = 101
        if output_size > 2 {
            output[2] = 114
            if output_size > 3 {
                output[3] = 109
                if output_size > 4 { output[4] = 105 }
                if output_size > 5 {
                    output[5] = 110
                    if output_size > 6 {
                        output[6] = 97
                        if output_size > 7 { output[7] = 108 }
                        if output_size > 8 { output[8] = 0 }
                    }
                }
            }
        }
    }
    return 8
}
#scope_export

#program_export
FormatTerminalPaneSessionTitle :: (output: *u8, output_size: s32,
    value: *u8, fallback: *u8) -> s32 {
    start: s32
    title_start: s32
    length: s32
    index: s32 = 0
    if output == null || output_size <= 0 { return 0 }
    output[0] = 0
    start = PathTitleStart(value)
    title_start = TitleStart(value, start)
    if title_start < 0 {
        return CopyTitleFallback(output, output_size, fallback)
    }
    length = TextLength(value) - title_start
    while length > 1 && value[title_start + length - 1] == 47 {
        length -= 1
    }
    if length <= 0 {
        return CopyTitleFallback(output, output_size, fallback)
    }
    if length >= output_size { length = output_size - 1 }
    while index < length {
        output[index] = value[title_start + index]
        index += 1
    }
    output[length] = 0
    return length
}

#program_export
FormatTerminalPaneSessionRecord :: (output: *u8, output_size: s32,
    record: TerminalPaneSessionRecord) -> s32 {
    cwd: [4096]u8
    shell: [2048]u8
    title: [1024]u8
    command: [4096]u8
    used: s32 = 0
    if output == null || output_size <= 0 { return 0 }
    output[0] = 0
    EscapeText(*cwd[0], 4096, *record.cwd[0])
    EscapeText(*shell[0], 2048, *record.shell[0])
    EscapeText(*title[0], 1024, *record.title[0])
    EscapeText(*command[0], 4096, *record.command[0])
    if !AppendText(output, output_size, *used, "tab") ||
       !AppendByte(output, output_size, *used, 9) ||
       !AppendRaw(output, output_size, *used, *cwd[0]) ||
       !AppendByte(output, output_size, *used, 9) ||
       !AppendRaw(output, output_size, *used, *shell[0]) ||
       !AppendByte(output, output_size, *used, 9) ||
       !AppendRaw(output, output_size, *used, *title[0]) ||
       !AppendByte(output, output_size, *used, 9) ||
       !AppendNumber(output, output_size, *used,
           ifx record.title_override != 0 then 1 else 0) ||
       !AppendByte(output, output_size, *used, 9) ||
       !AppendRaw(output, output_size, *used, *command[0]) ||
       !AppendByte(output, output_size, *used, 9) ||
       !AppendNumber(output, output_size, *used, record.scroll_offset) {
        output[0] = 0
        return 0
    }
    return used
}

#program_export
ParseTerminalPaneSessionActive :: (line: *u8, active: *s32) -> s32 {
    prefix: string = "active="
    index: s32 = 0
    if line == null { return 0 }
    while index < cast(s32)prefix.count {
        if line[index] != prefix[index] { return 0 }
        index += 1
    }
    if active != null { active.* = ParseNumberAt(line, index) }
    return 1
}

#program_export
ParseTerminalPaneSessionRecord :: (line: *u8,
    output: *TerminalPaneSessionRecord) -> s32 {
    scratch: [8192]u8
    fields: [6]s32
    prefix: string = "tab\t"
    length: s32
    cursor: s32
    count: s32 = 0
    index: s32 = 0
    if line == null || output == null { return 0 }
    while index < cast(s32)prefix.count {
        if line[index] != prefix[index] { return 0 }
        index += 1
    }
    length = TextLength(line)
    if length + 1 >= 8192 { return 0 }
    while index < length {
        scratch[index] = line[index]
        index += 1
    }
    scratch[length] = 0
    while length > 0 && (scratch[length - 1] == 10 ||
           scratch[length - 1] == 13) {
        length -= 1
        scratch[length] = 0
    }
    cursor = 4
    while count < 6 {
        fields[count] = cursor
        count += 1
        while scratch[cursor] != 0 && scratch[cursor] != 9 { cursor += 1 }
        if scratch[cursor] == 0 { break }
        scratch[cursor] = 0
        cursor += 1
    }
    if count < 3 { return 0 }
    index = 0
    while index < 1024 {
        output.cwd[index] = 0
        output.command[index] = 0
        index += 1
    }
    index = 0
    while index < 512 {
        output.shell[index] = 0
        index += 1
    }
    index = 0
    while index < 128 {
        output.title[index] = 0
        index += 1
    }
    output.title_override = 0
    output.scroll_offset = 0
    UnescapeText(*output.cwd[0], 1024, *scratch[fields[0]])
    UnescapeText(*output.shell[0], 512, *scratch[fields[1]])
    UnescapeText(*output.title[0], 128, *scratch[fields[2]])
    if count >= 4 {
        output.title_override = cast(s32)(ParseNumberAt(*scratch[fields[3]], 0) != 0)
    }
    if count >= 5 {
        UnescapeText(*output.command[0], 1024, *scratch[fields[4]])
    }
    if count >= 6 {
        output.scroll_offset = ParseNumberAt(*scratch[fields[5]], 0)
    }
    return 1
}
